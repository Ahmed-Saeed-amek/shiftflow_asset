@model List<Area>
@{ ViewData["Title"] = Loc.T("Area"); }
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Area"),Subtitle=Loc.T("Governorate")})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Governorate")</th><th>@Loc.T("Name")</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="small text-muted">@(a.Governorate is { } gov ? Loc.LocalizedName(gov.Name, gov.NameAr) : null)</td>
                        <td>@Loc.LocalizedName(a.Name, a.NameAr)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
