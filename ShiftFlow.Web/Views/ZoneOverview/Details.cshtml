@model Zone
@{
    var localizedName = Loc.LocalizedName(Model.Name, Model.NameAr);
    ViewData["Title"] = localizedName;
    var categoryLocalized = Model.LocationCategory is { } cat ? Loc.LocalizedName(cat.Name, cat.NameAr) : null;
    var problemAssets = (List<Asset>)ViewBag.ProblemAssets;
    var dispatchedOrders = (List<WorkOrder>)ViewBag.DispatchedOrders;
}
<partial name="_PageHeader" model='new PageHeaderModel {
    Title = localizedName,
    Subtitle = categoryLocalized,
    Breadcrumbs = new List<(string Label, string? Url)> { (Loc.T("Zone Overview"), Url.Action("Index")), (localizedName, null) } }' />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold border-0"><i class="bi bi-truck me-2"></i>@Loc.T("Dispatched Orders")</div>
    @if (dispatchedOrders.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
            @Loc.T("No work orders dispatched to this zone yet.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-card-stack">
                <thead class="table-light">
                    <tr><th>@Loc.T("Work Order Number")</th><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Stage")</th></tr>
                </thead>
                <tbody>
                    @foreach (var w in dispatchedOrders)
                    {
                        <tr class="row-link" data-href="@Url.Action("Details", "WorkOrders", new { id = w.Id })">
                            <td data-label="@Loc.T("Work Order Number")" class="small fw-semibold">@w.WorkOrderNumber</td>
                            <td data-label="@Loc.T("Asset Tag")" class="small">@w.Asset?.AssetTag</td>
                            <td data-label="@Loc.T("Stage")"><partial name="_StatusBadge" model="@w.Stage" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold border-0"><i class="bi bi-box me-2"></i>@Loc.T("Assets")</div>
    @if (problemAssets.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-check2-circle fs-1 d-block mb-2 opacity-25"></i>
            @Loc.T("No defective or under-maintenance assets in this zone.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-card-stack">
                <thead class="table-light">
                    <tr><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Name")</th><th>@Loc.T("Category")</th><th>@Loc.T("Status")</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in problemAssets)
                    {
                        <tr class="row-link" data-href="@Url.Action("Details", "Assets", new { id = a.Id })">
                            <td data-label="@Loc.T("Asset Tag")" class="small fw-semibold">@a.AssetTag</td>
                            <td data-label="@Loc.T("Name")">@a.Name</td>
                            <td data-label="@Loc.T("Category")" data-hide-mobile class="small">@(a.Category is { } aCat ? Loc.LocalizedName(aCat.Name, aCat.NameAr) : null)</td>
                            <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@a.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
