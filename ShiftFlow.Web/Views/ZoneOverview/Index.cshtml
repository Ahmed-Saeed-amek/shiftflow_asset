@model List<Zone>
@{
    ViewData["Title"] = Loc.T("Zone Overview");
    var zoneStatus = (Dictionary<int, (bool HasDefective, bool HasMaintenance)>)ViewBag.ZoneStatus;
    var dispatchedByZone = (Dictionary<int, int>)ViewBag.DispatchedByZone;
    var lastVisitedByZone = (Dictionary<int, DateTime>)ViewBag.LastVisitedByZone;
    var categories = Model.Where(z => z.LocationCategory != null).Select(z => z.LocationCategory!)
        .GroupBy(c => c.Id).Select(g => g.First()).OrderBy(c => c.Id).ToList();

    string RowStatus(int zoneId) => zoneStatus.TryGetValue(zoneId, out var s)
        ? (s.HasDefective ? "Defective" : s.HasMaintenance ? "Maintenance" : "OK")
        : "OK";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H" crossorigin="anonymous" />

<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Zone Overview"),Subtitle=Loc.T("Latest orders by zone")})" />

@* Filtering here is client-side (it also drives the map), so the bar never submits — but it uses
   the same .filter-bar shell as every server-filtered list so the two read identically. Two
   selects replace the previous two wrapping button groups, which needed their own horizontal
   scrollers once a site had more than a handful of zone categories. *@
<form class="filter-bar" id="zoneOverviewFilters" onsubmit="return false;">
    <select class="form-select form-select-sm" id="filterCategory" aria-label="@Loc.T("Zone Category")">
        <option value="">@Loc.T("Zone Category")</option>
        @foreach (var c in categories)
        {
            <option value="@c.Name">@Loc.LocalizedName(c.Name, c.NameAr)</option>
        }
    </select>
    <select class="form-select form-select-sm" id="filterStatus" aria-label="@Loc.T("Status")">
        <option value="">@Loc.T("Status")</option>
        <option value="Defective">@Loc.T("Defective")</option>
        <option value="Maintenance">@Loc.T("Maintenance")</option>
        <option value="OK">@Loc.T("OK")</option>
    </select>
    <a href="#" id="filterClear" class="btn btn-link btn-sm d-none">@Loc.T("Clear")</a>
    <span class="filter-bar__count text-muted small" id="zoneCount">@Model.Count @Loc.T("records")</span>
</form>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="table-responsive" style="max-height:600px;overflow-y:auto">
                <table class="table table-hover align-middle mb-0 table-card-stack">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc.T("Zone")</th>
                            <th>@Loc.T("Zone Category")</th>
                            <th>@Loc.T("Dispatched Orders")</th>
                            <th>@Loc.T("Last Visited")</th>
                        </tr>
                    </thead>
                    <tbody id="zoneTableBody">
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                        }
                        @foreach (var z in Model)
                        {
                            var rowStatus = RowStatus(z.Id);
                            var rowClass = rowStatus == "Defective" ? "table-danger" : rowStatus == "Maintenance" ? "table-warning" : "";
                            <tr class="row-link @rowClass" data-zone-row data-category="@z.LocationCategory?.Name" data-status="@rowStatus"
                                data-href="@Url.Action("Details", new { id = z.Id })">
                                <td data-label="@Loc.T("Zone")"><a asp-action="Details" asp-route-id="@z.Id" class="fw-semibold text-decoration-none">@Loc.LocalizedName(z.Name, z.NameAr)</a></td>
                                <td data-label="@Loc.T("Zone Category")" class="small text-muted">@(z.LocationCategory is { } cat ? Loc.LocalizedName(cat.Name, cat.NameAr) : null)</td>
                                <td data-label="@Loc.T("Dispatched Orders")">@dispatchedByZone.GetValueOrDefault(z.Id, 0)</td>
                                <td data-label="@Loc.T("Last Visited")" class="small text-muted">@(lastVisitedByZone.TryGetValue(z.Id, out var lastVisited) ? Loc.TDate(lastVisited.ToString("dd/MM/yyyy")) : "—")</td>
                            </tr>
                        }
                        <tr id="zoneNoMatchRow" class="d-none"><td colspan="4" class="text-center text-muted py-4">@Loc.T("No zones match these filters.")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span class="fw-semibold"><i class="bi bi-map me-2 text-primary"></i>@Loc.T("Asset Map")</span>
                <div class="d-flex align-items-center gap-3 small text-muted">
                    <span><span class="d-inline-block rounded-circle me-1 legend-dot" data-token="--destructive"></span>@Loc.T("Defective")</span>
                    <span><span class="d-inline-block rounded-circle me-1 legend-dot" data-token="--warning"></span>@Loc.T("Maintenance")</span>
                    <span><span class="d-inline-block rounded-circle me-1 legend-dot" data-token="--success"></span>@Loc.T("Working")</span>
                </div>
            </div>
            <div id="assetOverviewMap" style="height:600px;border-radius:2px"></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" integrity="sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH" crossorigin="anonymous"></script>
<script src="~/js/zone-map.js" asp-append-version="true"></script>
<script src="~/js/theme-colors.js" asp-append-version="true"></script>
<style>.legend-dot{width:10px;height:10px}</style>
<script>
    // Legend swatches take their colour from the site.css theme tokens, not hard-coded Bootstrap hex.
    document.querySelectorAll('.legend-dot').forEach(el => { el.style.background = themeColor(el.dataset.token); });
(function () {
    let mapHandle = null;

    const categorySel = document.getElementById('filterCategory');
    const statusSel = document.getElementById('filterStatus');
    const clearLink = document.getElementById('filterClear');
    const countEl = document.getElementById('zoneCount');
    const countSuffix = countEl.textContent.replace(/^\s*\d+\s*/, '');
    const rows = () => document.querySelectorAll('[data-zone-row]');
    const noMatchRow = document.getElementById('zoneNoMatchRow');

    function applyFilters() {
        const activeCategory = categorySel.value;
        const activeStatus = statusSel.value;
        let visibleCount = 0;
        rows().forEach(r => {
            const matches = (!activeCategory || r.dataset.category === activeCategory)
                && (!activeStatus || r.dataset.status === activeStatus);
            r.classList.toggle('d-none', !matches);
            if (matches) visibleCount++;
        });
        noMatchRow.classList.toggle('d-none', visibleCount > 0);
        countEl.textContent = visibleCount + ' ' + countSuffix;
        clearLink.classList.toggle('d-none', !activeCategory && !activeStatus);

        if (mapHandle) {
            mapHandle.setFilter({
                category: activeCategory || null,
                status: activeStatus === 'OK' ? 'Working' : (activeStatus || null),
            });
        }
    }

    categorySel.addEventListener('change', applyFilters);
    statusSel.addEventListener('change', applyFilters);
    clearLink.addEventListener('click', e => {
        e.preventDefault();
        categorySel.value = ''; statusSel.value = '';
        applyFilters();
    });

    initZoneOverviewAssetMap('assetOverviewMap', '@Url.Action("AssetMap")', '@Url.Action("Details", "Assets", new { id = "__ID__" })')
        .then(handle => { mapHandle = handle; });
})();
</script>
}
