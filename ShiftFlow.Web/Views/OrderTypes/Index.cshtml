@model List<OrderType>
@{
    ViewData["Title"] = Loc.T("Order Types");
    string actionsHtml = "<button type='button' class='btn btn-primary btn-sm' data-bs-toggle='modal' data-bs-target='#orderTypeModal' data-modal-create='orderTypeModal'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Order Type") + "</button>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Order Types"),Subtitle=Loc.T("Shared by Inspection Orders and Maintenance Orders."),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-card-stack">
            <thead><tr><th></th><th>@Loc.T("Name")</th><th>@Loc.T("Prefix")</th><th>@Loc.T("Direct Fix")</th><th>@Loc.T("Assets")</th><th>@Loc.T("Assign To")</th><th>@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td data-label="@Loc.T("Colour")"><span class="d-inline-block rounded-circle" style="width:14px;height:14px;background-color:@t.Color" title="@t.Color"></span></td>
                        <td data-label="@Loc.T("Name")" class="fw-semibold">@Loc.LocalizedName(t.Name, t.NameAr)</td>
                        <td data-label="@Loc.T("Prefix")" class="small fw-semibold">@t.Prefix</td>
                        @* "Yes / No" and "Single / Multiple" said nothing on their own — spell out what
                           the flag actually means, in the same words the edit modal uses. *@
                        <td data-label="@Loc.T("Direct Fix")" class="small">@(t.IsDirectFix ? Loc.T("Direct fix") : Loc.T("Survey"))</td>
                        <td data-label="@Loc.T("Assets")" class="small">@(t.AllowsMultipleAssets ? Loc.T("Multiple assets") : Loc.T("Single asset"))</td>
                        <td data-label="@Loc.T("Assign To")" data-hide-mobile class="small">@Loc.T(t.AssignmentMode)</td>
                        <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@(t.IsActive ? "Active" : "Inactive")" /></td>
                        <td class="text-end">
                            <div class="dropdown row-actions">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Loc.T("Actions")"><i class="bi bi-three-dots"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#orderTypeModal"
                                                data-modal-edit="orderTypeModal"
                                                data-id="@t.Id" data-name="@t.Name" data-name-ar="@t.NameAr" data-prefix="@t.Prefix"
                                                data-sort-order="@t.SortOrder" data-tracks-defect-outcome="@(t.TracksDefectOutcome ? "true" : "false")"
                                                data-requires-vendor="@(t.RequiresVendor ? "true" : "false")" data-is-active="@(t.IsActive ? "true" : "false")"
                                                data-is-direct-fix="@(t.IsDirectFix ? "true" : "false")" data-allows-multiple-assets="@(t.AllowsMultipleAssets ? "true" : "false")"
                                                data-assignment-mode="@t.AssignmentMode" data-requires-approval="@(t.RequiresApproval ? "true" : "false")">
                                            <i class="bi bi-pencil me-2"></i>@Loc.T("Edit")
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-action="Delete" asp-route-id="@t.Id" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger" data-confirm="@Loc.T("Delete this order type? Only allowed if no orders or schedules use it.")"><i class="bi bi-trash me-2"></i>@Loc.T("Delete")</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="orderTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="orderTypeForm" asp-action="Create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="otId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="orderTypeModalTitle">@Loc.T("New Order Type")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="orderTypeModalError" class="alert alert-danger small" role="alert" hidden></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label required" for="otName">@Loc.T("Name")</label>
                            <input name="Name" id="otName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="otNameAr">@Loc.T("Name (Arabic)")</label>
                            <input name="NameAr" id="otNameAr" class="form-control" dir="rtl" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required" for="otPrefix">@Loc.T("Order Number Prefix")</label>
                            <input name="Prefix" id="otPrefix" class="form-control" placeholder="INS" required maxlength="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="otSortOrder">@Loc.T("Sort Order")</label>
                            <input name="SortOrder" id="otSortOrder" type="number" class="form-control" value="0" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="TracksDefectOutcome" id="otTracksDefect" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otTracksDefect">@Loc.T("Tracks defect outcome (Action Type + Cause required on Defective)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="RequiresVendor" id="otRequiresVendor" class="form-check-input" value="true" onchange="applyVendorGate()" />
                                <label class="form-check-label small" for="otRequiresVendor">@Loc.T("Requires vendor (routes through the Work Order vendor pipeline)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="IsDirectFix" id="otIsDirectFix" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otIsDirectFix">@Loc.T("Direct fix (single-asset fix report, no survey — like today's Maintenance Orders)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="AllowsMultipleAssets" id="otAllowsMultiple" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otAllowsMultiple">@Loc.T("Allows multiple assets per order (independent of Direct Fix — a direct-fix type creates one order per selected asset)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="RequiresApproval" id="otRequiresApproval" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otRequiresApproval">@Loc.T("Requires manager approval before closing")</label>
                                <div class="help-text" id="otRequiresApprovalHint" style="display:none">@Loc.T("Redundant here — a vendor-routed order already needs a manager's Confirm step before it closes.")</div>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="IsActive" id="otIsActive" class="form-check-input" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small" for="otIsActive">@Loc.T("Active")</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="otAssignmentMode">@Loc.T("Assign To")</label>
                            <select name="AssignmentMode" id="otAssignmentMode" class="form-select">
                                <option value="Either">@Loc.T("Either (Employee or Group)")</option>
                                <option value="EmployeeOnly">@Loc.T("Employee only")</option>
                                <option value="GroupOnly">@Loc.T("Group only")</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/modal-editor.js" asp-append-version="true"></script>
<script>
    function applyVendorGate() {
        const requiresVendor = document.getElementById('otRequiresVendor').checked;
        const approvalCb = document.getElementById('otRequiresApproval');
        approvalCb.disabled = requiresVendor;
        if (requiresVendor) approvalCb.checked = false;
        document.getElementById('otRequiresApprovalHint').style.display = requiresVendor ? '' : 'none';

        // A vendor-required type creates a WorkOrder, which has no group-assignment concept —
        // force Employee-only so a group pick at Orders/Create time is never silently discarded.
        // (Left enabled, not disabled — a disabled <select> doesn't post its value at all.)
        const assignmentSel = document.getElementById('otAssignmentMode');
        assignmentSel.classList.toggle('bg-light', requiresVendor);
        if (requiresVendor) assignmentSel.value = 'EmployeeOnly';
        [...assignmentSel.options].forEach(o => { if (o.value !== 'EmployeeOnly') o.disabled = requiresVendor; });
    }

    initModalEditor({
        modalId: 'orderTypeModal',
        formId: 'orderTypeForm',
        titleId: 'orderTypeModalTitle',
        errorId: 'orderTypeModalError',
        titles: { create: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("New Order Type"))), edit: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Edit Order Type"))) },
        urls: { create: '@Url.Action("Create")', edit: '@Url.Action("Edit")' },
        fieldMap: {
            id: 'otId', name: 'otName', nameAr: 'otNameAr', prefix: 'otPrefix', sortOrder: 'otSortOrder',
            tracksDefectOutcome: 'otTracksDefect', requiresVendor: 'otRequiresVendor', isActive: 'otIsActive',
            isDirectFix: 'otIsDirectFix', allowsMultipleAssets: 'otAllowsMultiple',
            assignmentMode: 'otAssignmentMode', requiresApproval: 'otRequiresApproval'
        },
        defaults: {
            id: 0, name: '', nameAr: '', prefix: '', sortOrder: 0, tracksDefectOutcome: false,
            requiresVendor: false, isActive: true, isDirectFix: false, allowsMultipleAssets: false,
            assignmentMode: 'Either', requiresApproval: false
        },
        onApply: applyVendorGate,
        reopen: @Html.Raw(ShiftFlow.Web.Services.ModalRedisplay.ReopenScript(TempData))
    });
</script>
}
