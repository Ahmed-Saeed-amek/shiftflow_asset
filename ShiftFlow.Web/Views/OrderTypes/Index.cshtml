@model List<OrderType>
@{
    ViewData["Title"] = Loc.T("Order Types");
    string actionsHtml = "<button type='button' class='btn btn-primary btn-sm' data-bs-toggle='modal' data-bs-target='#orderTypeModal' onclick='openCreate()'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Order Type") + "</button>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Order Types"),Subtitle=Loc.T("Shared by Inspection Orders and Maintenance Orders"),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th></th><th>@Loc.T("Name")</th><th class="d-none d-lg-table-cell">@Loc.T("Prefix")</th><th class="d-none d-xl-table-cell">@Loc.T("Direct Fix")</th><th class="d-none d-xl-table-cell">@Loc.T("Assets")</th><th class="d-none d-xl-table-cell">@Loc.T("Assign To")</th><th class="d-none d-sm-table-cell">@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td><span class="d-inline-block rounded-circle" style="width:14px;height:14px;background-color:@t.Color" title="@t.Color"></span></td>
                        <td>@Loc.LocalizedName(t.Name, t.NameAr)</td>
                        <td class="small font-monospace d-none d-lg-table-cell">@t.Prefix</td>
                        <td class="d-none d-xl-table-cell">@(t.IsDirectFix ? Loc.T("Yes") : Loc.T("No"))</td>
                        <td class="small d-none d-xl-table-cell">@(t.AllowsMultipleAssets ? Loc.T("Multiple") : Loc.T("Single"))</td>
                        <td class="small d-none d-xl-table-cell">@Loc.T(t.AssignmentMode)</td>
                        <td class="d-none d-sm-table-cell"><partial name="_StatusBadge" model="@(t.IsActive ? "Active" : "Inactive")" /></td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#orderTypeModal"
                                    onclick='openEdit(@t.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(t.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(t.NameAr)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(t.Prefix)), @t.SortOrder, @(t.TracksDefectOutcome ? "true" : "false"), @(t.RequiresVendor ? "true" : "false"), @(t.IsActive ? "true" : "false"), @(t.IsDirectFix ? "true" : "false"), @(t.AllowsMultipleAssets ? "true" : "false"), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(t.AssignmentMode)), @(t.RequiresApproval ? "true" : "false"))'>
                                @Loc.T("Edit")
                            </button>
                            <form method="post" asp-action="Delete" asp-route-id="@t.Id" class="d-inline"
                                  onsubmit="return confirm('@Loc.T("Delete this order type? Only allowed if no orders or schedules use it.")')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="orderTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="orderTypeForm" asp-action="Create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="otId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="orderTypeModalTitle">@Loc.T("New Order Type")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small">@Loc.T("Name")</label>
                            <input name="Name" id="otName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@Loc.T("Name (Arabic)")</label>
                            <input name="NameAr" id="otNameAr" class="form-control" dir="rtl" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@Loc.T("Order Number Prefix")</label>
                            <input name="Prefix" id="otPrefix" class="form-control" placeholder="INS" required maxlength="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@Loc.T("Sort Order")</label>
                            <input name="SortOrder" id="otSortOrder" type="number" class="form-control" value="0" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="TracksDefectOutcome" id="otTracksDefect" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otTracksDefect">@Loc.T("Tracks defect outcome (Action Type + Cause required on Defective)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="RequiresVendor" id="otRequiresVendor" class="form-check-input" value="true" onchange="applyVendorGate()" />
                                <label class="form-check-label small" for="otRequiresVendor">@Loc.T("Requires vendor (routes through the Work Order vendor pipeline)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="IsDirectFix" id="otIsDirectFix" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otIsDirectFix">@Loc.T("Direct fix (single-asset fix report, no survey — like today's Maintenance Orders)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="AllowsMultipleAssets" id="otAllowsMultiple" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otAllowsMultiple">@Loc.T("Allows multiple assets per order (independent of Direct Fix — a direct-fix type creates one order per selected asset)")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="RequiresApproval" id="otRequiresApproval" class="form-check-input" value="true" />
                                <label class="form-check-label small" for="otRequiresApproval">@Loc.T("Requires manager approval before closing")</label>
                                <div class="form-text" id="otRequiresApprovalHint" style="display:none">@Loc.T("Redundant here — a vendor-routed order already needs a manager's Confirm step before it closes.")</div>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="IsActive" id="otIsActive" class="form-check-input" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small" for="otIsActive">@Loc.T("Active")</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">@Loc.T("Assign To")</label>
                            <select name="AssignmentMode" id="otAssignmentMode" class="form-select">
                                <option value="Either">@Loc.T("Either (Employee or Team)")</option>
                                <option value="EmployeeOnly">@Loc.T("Employee only")</option>
                                <option value="TeamOnly">@Loc.T("Team only")</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const jsNewOrderType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("New Order Type")));
    const jsEditOrderType = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Edit Order Type")));

    function applyVendorGate() {
        const requiresVendor = document.getElementById('otRequiresVendor').checked;
        const approvalCb = document.getElementById('otRequiresApproval');
        approvalCb.disabled = requiresVendor;
        if (requiresVendor) approvalCb.checked = false;
        document.getElementById('otRequiresApprovalHint').style.display = requiresVendor ? '' : 'none';

        // A vendor-required type creates a WorkOrder, which has no team-assignment concept —
        // force Employee-only so a team pick at Orders/Create time is never silently discarded.
        // (Left enabled, not disabled — a disabled <select> doesn't post its value at all, which
        // would submit no AssignmentMode and fall back to the "Either" model default instead.)
        const assignmentSel = document.getElementById('otAssignmentMode');
        assignmentSel.classList.toggle('bg-light', requiresVendor);
        if (requiresVendor) assignmentSel.value = 'EmployeeOnly';
        [...assignmentSel.options].forEach(o => { if (o.value !== 'EmployeeOnly') o.disabled = requiresVendor; });
    }

    function openCreate() {
        document.getElementById('orderTypeModalTitle').textContent = jsNewOrderType;
        document.getElementById('orderTypeForm').setAttribute('action', '@Url.Action("Create")');
        document.getElementById('otId').value = 0;
        document.getElementById('otName').value = '';
        document.getElementById('otNameAr').value = '';
        document.getElementById('otPrefix').value = '';
        document.getElementById('otSortOrder').value = 0;
        document.getElementById('otTracksDefect').checked = false;
        document.getElementById('otRequiresVendor').checked = false;
        document.getElementById('otIsDirectFix').checked = false;
        document.getElementById('otAllowsMultiple').checked = false;
        document.getElementById('otAssignmentMode').value = 'Either';
        document.getElementById('otRequiresApproval').checked = false;
        document.getElementById('otIsActive').checked = true;
        applyVendorGate();
    }

    function openEdit(id, name, nameAr, prefix, sortOrder, tracksDefect, requiresVendor, isActive, isDirectFix, allowsMultiple, assignmentMode, requiresApproval) {
        document.getElementById('orderTypeModalTitle').textContent = jsEditOrderType;
        document.getElementById('orderTypeForm').setAttribute('action', '@Url.Action("Edit")');
        document.getElementById('otId').value = id;
        document.getElementById('otName').value = name || '';
        document.getElementById('otNameAr').value = nameAr || '';
        document.getElementById('otPrefix').value = prefix || '';
        document.getElementById('otSortOrder').value = sortOrder;
        document.getElementById('otTracksDefect').checked = tracksDefect;
        document.getElementById('otRequiresVendor').checked = requiresVendor;
        document.getElementById('otIsActive').checked = isActive;
        document.getElementById('otIsDirectFix').checked = isDirectFix;
        document.getElementById('otAllowsMultiple').checked = allowsMultiple;
        document.getElementById('otAssignmentMode').value = assignmentMode || 'Either';
        document.getElementById('otRequiresApproval').checked = requiresApproval;
        applyVendorGate();
    }
</script>
}
