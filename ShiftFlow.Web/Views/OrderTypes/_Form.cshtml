@model OrderTypeViewModel
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Name")</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Name (Arabic)")</label>
                    <input asp-for="NameAr" class="form-control" dir="rtl" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Order Number Prefix")</label>
                    <input asp-for="Prefix" class="form-control" placeholder="INS" />
                    <span asp-validation-for="Prefix" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Sort Order")</label>
                    <input asp-for="SortOrder" type="number" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="TracksDefectOutcome" class="form-check-input" />
                        <label class="form-check-label small" asp-for="TracksDefectOutcome">@Loc.T("Tracks defect outcome (Action Type + Cause required on Defective)")</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="RequiresVendor" class="form-check-input" />
                        <label class="form-check-label small" asp-for="RequiresVendor">@Loc.T("Requires vendor (routes through the Work Order vendor pipeline)")</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label small" asp-for="IsActive">@Loc.T("Active")</label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>
