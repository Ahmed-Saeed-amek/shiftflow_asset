@using Microsoft.AspNetCore.Authorization
@model List<Location>
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Locations");
    var canManageLocations = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.LocationManage)).Succeeded;
    string actionsHtml = canManageLocations
        ? "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Location") + "</a>"
        : "";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Locations"),Subtitle=Loc.T("Work sites and stations"),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Code")</th><th>@Loc.T("Name")</th><th>@Loc.T("City")</th><th>@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="small text-muted">@l.Code</td>
                        <td>@l.Name</td>
                        <td>@l.City</td>
                        <td><partial name="_StatusBadge" model="@l.Status" /></td>
                        <td>
                            @if (canManageLocations)
                            {
                                <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-outline-primary">@Loc.T("Edit")</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
