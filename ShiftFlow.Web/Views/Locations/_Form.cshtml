@model LocationViewModel
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small">@Loc.T("Name")</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("Code")</label>
                    <input asp-for="Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Name (Arabic)")</label>
                    <input asp-for="NameAr" class="form-control" dir="rtl" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("City")</label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label small">@Loc.T("Address")</label>
                    <input asp-for="Address" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">@Loc.T("Latitude")</label>
                    <input asp-for="Latitude" type="number" step="any" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">@Loc.T("Longitude")</label>
                    <input asp-for="Longitude" type="number" step="any" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Status")</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Active">@Loc.T("Active")</option>
                        <option value="Inactive">@Loc.T("Inactive")</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small">@Loc.T("Notes")</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>
