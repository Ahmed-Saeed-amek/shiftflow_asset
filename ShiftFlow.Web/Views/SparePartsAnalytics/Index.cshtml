@{
    ViewData["Title"] = Loc.T("Spare Parts Analytics");
    var mostUsed = (List<SparePartUsageSummary>)ViewBag.MostUsed;
    var byAsset = (List<AssetUsageSummary>)ViewBag.ByAsset;
    var byCategory = (List<CategoryUsageSummary>)ViewBag.ByCategory;
    var costByMonth = (List<MonthlyCostRow>)ViewBag.CostByMonth;
    var totalCost = (decimal)ViewBag.TotalCost;
    var hasUncostedRows = (bool)ViewBag.HasUncostedRows;
    var categories = (List<AssetCategory>)ViewBag.Categories;
    var from = (DateTime?)ViewBag.From;
    var to = (DateTime?)ViewBag.To;
    var categoryId = (int?)ViewBag.CategoryId;
    var hasFilter = from != null || to != null || categoryId != null;
    var noUsageTitle = Loc.T("No usage recorded yet");
    var noUsageText = Loc.T("Parts consumed on work orders appear here once they are recorded.");
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Spare Parts Analytics"),Subtitle=Loc.T("Where spare parts are going, and what they cost.")})" />

@* Same .filter-bar shell as the list pages; the two date fields keep visible inline labels
   because "From"/"To" cannot be carried by a date input's placeholder. *@
<form method="get" class="filter-bar">
    <label class="d-inline-flex align-items-center gap-1 small text-muted mb-0">
        @Loc.T("From")
        <input type="date" name="from" value="@(from?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
    </label>
    <label class="d-inline-flex align-items-center gap-1 small text-muted mb-0">
        @Loc.T("To")
        <input type="date" name="to" value="@(to?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
    </label>
    <select name="categoryId" class="form-select form-select-sm" aria-label="@Loc.T("Category")">
        <option value="">@Loc.T("All Categories")</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id" selected="@(categoryId == c.Id)">@Loc.LocalizedName(c.Name, c.NameAr)</option>
        }
    </select>
    <button type="submit" class="btn btn-outline-secondary btn-sm">@Loc.T("Filter")</button>
    @if (hasFilter)
    {
        <a href="@Url.Action("Index")" class="btn btn-link btn-sm">@Loc.T("Clear")</a>
    }
</form>

@if (hasUncostedRows)
{
    <div class="alert alert-light border small mb-3">
        <i class="bi bi-info-circle me-1"></i>@Loc.T("Cost totals only include parts with a recorded unit cost. Usage recorded before the spare parts catalog existed isn't reflected here.")
    </div>
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#mostUsedTab" type="button">@Loc.T("Most Used")</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#byAssetTab" type="button">@Loc.T("By Asset")</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#byCategoryTab" type="button">@Loc.T("By Category")</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#costTab" type="button">@Loc.T("Cost")</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="mostUsedTab">
        @if (mostUsed.Count == 0)
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-box-seam", Title = noUsageTitle, Text = noUsageText }' />
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-card-stack">
                        <thead><tr><th>@Loc.T("Spare Part")</th><th>@Loc.T("Total Quantity")</th><th>@Loc.T("Times Used")</th><th>@Loc.T("Total Cost")</th></tr></thead>
                        <tbody>
                            @foreach (var m in mostUsed)
                            {
                                <tr class="row-link" data-href="@Url.Action("Details", "SpareParts", new { id = m.SparePartId })">
                                    <td data-label="@Loc.T("Spare Part")" class="fw-semibold">@m.Name</td>
                                    <td data-label="@Loc.T("Total Quantity")" class="small">@m.TotalQuantity</td>
                                    <td data-label="@Loc.T("Times Used")" class="small">@m.UsageCount</td>
                                    <td data-label="@Loc.T("Total Cost")" class="small">@m.TotalCost.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="tab-pane fade" id="byAssetTab">
        @if (byAsset.Count == 0)
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-box-seam", Title = noUsageTitle, Text = noUsageText }' />
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-card-stack">
                        <thead><tr><th>@Loc.T("Asset")</th><th>@Loc.T("Total Quantity")</th><th>@Loc.T("Distinct Parts")</th><th>@Loc.T("Total Cost")</th></tr></thead>
                        <tbody>
                            @foreach (var a in byAsset)
                            {
                                <tr class="row-link" data-href="@Url.Action("Details", "Assets", new { id = a.AssetId })">
                                    <td data-label="@Loc.T("Asset")" class="fw-semibold">@a.AssetLabel</td>
                                    <td data-label="@Loc.T("Total Quantity")" class="small">@a.TotalQuantity</td>
                                    <td data-label="@Loc.T("Distinct Parts")" class="small">@a.DistinctParts</td>
                                    <td data-label="@Loc.T("Total Cost")" class="small">@a.TotalCost.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="tab-pane fade" id="byCategoryTab">
        @if (byCategory.Count == 0)
        {
            <partial name="_EmptyState" model='new EmptyStateModel { Icon = "bi-box-seam", Title = noUsageTitle, Text = noUsageText }' />
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-card-stack">
                        <thead><tr><th>@Loc.T("Category")</th><th>@Loc.T("Total Quantity")</th><th>@Loc.T("Total Cost")</th></tr></thead>
                        <tbody>
                            @foreach (var c in byCategory)
                            {
                                <tr>
                                    <td data-label="@Loc.T("Category")" class="fw-semibold">@c.CategoryLabel</td>
                                    <td data-label="@Loc.T("Total Quantity")" class="small">@c.TotalQuantity</td>
                                    <td data-label="@Loc.T("Total Cost")" class="small">@c.TotalCost.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="tab-pane fade" id="costTab">
        <div class="row g-3">
            <div class="col-md-4">
                <partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("Total Parts Cost"),Value=totalCost.ToString("0.00"),Icon="bi-cash-stack",Color="amber"})" />
            </div>
            <div class="col-md-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold border-0"><i class="bi bi-graph-up me-2"></i>@Loc.T("Monthly Cost Trend")</div>
                    <div class="card-body"><div class="chart-wrap"><canvas id="costTrendChart" aria-label="@Loc.T("Monthly Cost Trend")" role="img"></canvas></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/theme-colors.js" asp-append-version="true"></script>
    <script>
        const costMonths = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(costByMonth.Select(m => $"{m.Year}-{m.Month:D2}")));
        const costValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(costByMonth.Select(m => m.Cost)));
        new Chart(document.getElementById('costTrendChart'), {
            type: 'line',
            data: {
                labels: costMonths,
                datasets: [{ data: costValues, borderColor: themeColor('--chart-2'), backgroundColor: themeColor('--chart-2').replace('hsl(', 'hsla(').replace(')', ', .15)'), fill: true, tension: 0.3 }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
