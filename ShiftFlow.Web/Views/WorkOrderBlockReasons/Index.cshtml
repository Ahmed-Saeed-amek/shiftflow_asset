@model List<WorkOrderBlockReason>
@{
    ViewData["Title"] = Loc.T("Block Reasons");
    string actionsHtml = "<button type='button' class='btn btn-primary btn-sm' data-bs-toggle='modal' data-bs-target='#reasonModal' onclick='openCreate()'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Reason") + "</button>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Block Reasons"),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Name")</th><th>@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td><partial name="_StatusBadge" model="@(r.IsActive ? "Active" : "Inactive")" /></td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reasonModal"
                                    onclick='openEdit(@r.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(r.NameAr)), @(r.IsActive ? "true" : "false"))'>
                                @Loc.T("Edit")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="reasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="reasonForm" asp-action="Create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="reasonId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="reasonModalTitle">@Loc.T("New Reason")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">@Loc.T("Name")</label>
                            <input name="Name" id="reasonName" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">@Loc.T("Name (Arabic)")</label>
                            <input name="NameAr" id="reasonNameAr" class="form-control" dir="rtl" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="IsActive" id="reasonIsActive" class="form-check-input" value="true" checked />
                                <label class="form-check-label small" for="reasonIsActive">@Loc.T("Active")</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const jsNewReason = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("New Reason")));
    const jsEditReason = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Edit Reason")));

    function openCreate() {
        document.getElementById('reasonModalTitle').textContent = jsNewReason;
        document.getElementById('reasonForm').setAttribute('action', '@Url.Action("Create")');
        document.getElementById('reasonId').value = 0;
        document.getElementById('reasonName').value = '';
        document.getElementById('reasonNameAr').value = '';
        document.getElementById('reasonIsActive').checked = true;
    }

    function openEdit(id, name, nameAr, isActive) {
        document.getElementById('reasonModalTitle').textContent = jsEditReason;
        document.getElementById('reasonForm').setAttribute('action', '@Url.Action("Edit")');
        document.getElementById('reasonId').value = id;
        document.getElementById('reasonName').value = name || '';
        document.getElementById('reasonNameAr').value = nameAr || '';
        document.getElementById('reasonIsActive').checked = isActive;
    }
</script>
}
