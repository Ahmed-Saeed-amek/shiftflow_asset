@model List<WorkOrderBlockReason>
@{
    ViewData["Title"] = Loc.T("Block Reasons");
    string actionsHtml = "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Reason") + "</a>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Block Reasons"),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Name")</th><th>@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td><partial name="_StatusBadge" model="@(r.IsActive ? "Active" : "Inactive")" /></td>
                        <td><a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">@Loc.T("Edit")</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
