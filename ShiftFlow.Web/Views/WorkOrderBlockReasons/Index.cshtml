@model List<WorkOrderBlockReason>
@{
    ViewData["Title"] = Loc.T("Block Reasons");
    string actionsHtml = "<button type='button' class='btn btn-primary btn-sm' data-bs-toggle='modal' data-bs-target='#reasonModal' data-modal-create='reasonModal'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Reason") + "</button>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Block Reasons"),Subtitle=Loc.T("Why a work order can be put on hold."),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-card-stack">
            <thead><tr><th>@Loc.T("Name")</th><th>@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td data-label="@Loc.T("Name")" class="fw-semibold">@r.Name</td>
                        <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@(r.IsActive ? "Active" : "Inactive")" /></td>
                        <td class="text-end">
                            <div class="dropdown row-actions">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Loc.T("Actions")"><i class="bi bi-three-dots"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#reasonModal"
                                                data-modal-edit="reasonModal"
                                                data-id="@r.Id" data-name="@r.Name" data-name-ar="@r.NameAr" data-is-active="@(r.IsActive ? "true" : "false")">
                                            <i class="bi bi-pencil me-2"></i>@Loc.T("Edit")
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="reasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="reasonForm" asp-action="Create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="reasonId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="reasonModalTitle">@Loc.T("New Reason")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="reasonModalError" class="alert alert-danger small" role="alert" hidden></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label required" for="reasonName">@Loc.T("Name")</label>
                            <input name="Name" id="reasonName" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="reasonNameAr">@Loc.T("Name (Arabic)")</label>
                            <input name="NameAr" id="reasonNameAr" class="form-control" dir="rtl" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="IsActive" id="reasonIsActive" class="form-check-input" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small" for="reasonIsActive">@Loc.T("Active")</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/modal-editor.js" asp-append-version="true"></script>
<script>
    initModalEditor({
        modalId: 'reasonModal',
        formId: 'reasonForm',
        titleId: 'reasonModalTitle',
        errorId: 'reasonModalError',
        titles: { create: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("New Reason"))), edit: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Edit Reason"))) },
        urls: { create: '@Url.Action("Create")', edit: '@Url.Action("Edit")' },
        fieldMap: { id: 'reasonId', name: 'reasonName', nameAr: 'reasonNameAr', isActive: 'reasonIsActive' },
        defaults: { id: 0, name: '', nameAr: '', isActive: true },
        reopen: @Html.Raw(ShiftFlow.Web.Services.ModalRedisplay.ReopenScript(TempData))
    });
</script>
}
