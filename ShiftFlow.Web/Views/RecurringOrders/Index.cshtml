@model List<RecurringOrder>
@using ShiftFlow.Domain.Entities
@{
    ViewData["Title"] = Loc.T("Recurring Orders");
    string actionsHtml = "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Schedule") + "</a>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Recurring Orders"),Subtitle=Loc.T("Auto-generates one order per linked asset on a repeating cadence — any active order type, including vendor-routed ones."),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Order Type")</th><th>@Loc.T("Assets")</th><th class="d-none d-md-table-cell">@Loc.T("Assign To")</th><th class="d-none d-lg-table-cell">@Loc.T("Cadence")</th><th class="d-none d-lg-table-cell">@Loc.T("Start Date")</th><th class="d-none d-sm-table-cell">@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr class="cursor-pointer" onclick="location.href='@Url.Action("Edit", new { id = r.Id })'">
                        <td>@(r.OrderType != null ? Loc.LocalizedName(r.OrderType.Name, r.OrderType.NameAr) : "—")</td>
                        <td class="small">@r.AssetLinks.Count</td>
                        <td class="small d-none d-md-table-cell">
                            @(r.AssignedToUser?.FullName ?? (r.AssignedToTeam != null ? Loc.T("Team") + ": " + r.AssignedToTeam.Name : "—"))
                            @if (r.Vendor != null)
                            {
                                <span class="text-muted"> · @r.Vendor.Name</span>
                            }
                        </td>
                        <td class="small d-none d-lg-table-cell">@Loc.T(r.Cadence)</td>
                        <td class="small d-none d-lg-table-cell">@r.StartDate.ToString("yyyy-MM-dd")@(r.EndDate.HasValue ? " – " + r.EndDate.Value.ToString("yyyy-MM-dd") : "")</td>
                        <td class="d-none d-sm-table-cell"><partial name="_StatusBadge" model="@(r.IsActive ? "Active" : "Inactive")" /></td>
                        <td class="text-end"><i class="bi bi-chevron-right text-muted small"></i></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
