@model UserAssetScopeViewModel
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("User")</label>
                    <partial name="_EmployeePicker" model='new EmployeePickerModel {
                        Name = "UserId", SelectedId = Model.UserId, SelectedLabel = ViewBag.SelectedUserName as string,
                        Placeholder = Loc.T("Search by name or email…") }' />
                    <span asp-validation-for="UserId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-text mb-1">@Loc.T("Pick any combination — whichever are set narrow the visible assets together.")</div>
                    <span asp-validation-for="ZoneId" class="text-danger small d-block mb-2"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("Zone")</label>
                    <select asp-for="ZoneId" class="form-select">
                        <option value="">@Loc.T("(Any)")</option>
                        @foreach (var z in (List<Zone>)ViewBag.Zones)
                        {
                            <option value="@z.Id">@Loc.LocalizedName(z.Name, z.NameAr)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("Location Type")</label>
                    <select asp-for="LocationCategoryId" class="form-select">
                        <option value="">@Loc.T("(Any)")</option>
                        @foreach (var c in (List<LocationCategory>)ViewBag.LocationCategories)
                        {
                            <option value="@c.Id">@Loc.LocalizedName(c.Name, c.NameAr)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("Category")</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">@Loc.T("(Any)")</option>
                        @foreach (var c in (List<AssetCategory>)ViewBag.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>
