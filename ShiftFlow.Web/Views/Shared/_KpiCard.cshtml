@model ShiftFlow.Web.ViewModels.KpiCardModel
@{
    var colorMap = new Dictionary<string, (string bg, string fg)>
    {
        ["primary"] = ("bg-primary", "text-primary"),
        ["emerald"] = ("bg-success", "text-success"),
        ["amber"] = ("bg-warning", "text-warning"),
        ["violet"] = ("bg-info", "text-info"),
        ["red"] = ("bg-danger", "text-danger"),
        ["blue"] = ("bg-primary", "text-primary"),
        ["indigo"] = ("bg-primary", "text-primary"),
        ["orange"] = ("bg-warning", "text-warning"),
    };
    var (bg, fg) = colorMap.TryGetValue(Model.Color, out var c) ? c : colorMap["primary"];
}
<div class="card card-hover border-0 shadow-sm h-100">
    <div class="card-body d-flex justify-content-between align-items-start py-2 px-3">
        <div>
            <div class="text-muted small text-uppercase fw-semibold" style="font-size:.68rem">@Loc.T(Model.Title)</div>
            <div class="fs-4 fw-bold font-heading @fg" style="line-height:1.2">@Model.Value</div>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <div class="small text-muted" style="font-size:.72rem">@Loc.T(Model.Subtitle)</div>
            }
        </div>
        <div class="kpi-icon-chip @bg bg-opacity-10">
            <i class="bi @Model.Icon @fg"></i>
        </div>
    </div>
</div>
