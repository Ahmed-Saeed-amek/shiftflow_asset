@*
    Reusable searchable employee picker (typeahead by name / email / employee #).
    Usage:
      <partial name="_EmployeePicker" model='new EmployeePickerModel {
          Name = "AssignedEngineerId", Role = "Engineer",
          SelectedId = Model.AssignedEngineerId, SelectedLabel = engineerName }' />
    The hidden input carries the selected user id under the given Name, so existing
    form-post contracts (asp-for / name) are unchanged.
*@
@model ShiftFlow.Web.ViewModels.EmployeePickerModel
<div class="employee-picker position-relative" data-employee-picker data-role="@Model.Role">
    <input type="hidden" name="@Model.Name" value="@Model.SelectedId" data-ep-value />
    <input type="text" class="form-control @Model.CssClass" autocomplete="off"
           placeholder="@(Model.Placeholder ?? Loc.T("Search by name or email…"))"
           value="@Model.SelectedLabel" data-ep-search />
    <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index:1055;max-height:260px;overflow:auto" data-ep-results></div>
</div>
