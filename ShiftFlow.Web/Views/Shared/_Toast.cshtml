@* Single place TempData feedback is rendered. Replaces the static navbar badge that couldn't be
   dismissed and was announced by nothing: success auto-hides after 5s (role=status), errors stay
   until dismissed (role=alert). The container is always emitted so window.showToast() has
   somewhere to append to. *@
@{
    var successMessage = TempData["Success"]?.ToString();
    var errorMessage = TempData["Error"]?.ToString();
}
<div id="toastStack" class="toast-container position-fixed top-0 end-0 p-3">
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="toast app-toast app-toast-success border-0 shadow" role="status" aria-live="polite" aria-atomic="true" data-delay="5000">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    <span>@Loc.T(successMessage)</span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="@Loc.T("Close")"></button>
            </div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        @* Errors never auto-hide — the old badge vanished on the next navigation whether or not
           it had been read, and an error is the one message worth keeping on screen. *@
        <div class="toast app-toast app-toast-error border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true" data-autohide="false">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                    <span>@Loc.T(errorMessage)</span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="@Loc.T("Close")"></button>
            </div>
        </div>
    }
</div>
