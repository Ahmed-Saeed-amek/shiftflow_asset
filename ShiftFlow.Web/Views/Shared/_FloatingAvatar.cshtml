<div id="floatingAvatar">
    <div class="avatar-card">
        <div class="small fw-semibold text-primary mb-1">@Loc.T("AI Assistant")</div>
        <div class="small text-muted mb-2">@Loc.T("Ask me anything about the system!")</div>
        <a asp-controller="AiAssistant" asp-action="Index" class="small fw-semibold text-decoration-none">
            <i class="bi bi-chat-dots me-1"></i>@Loc.T("Open Chat")
        </a>
    </div>
    <div class="avatar-bubble" onclick="document.getElementById('floatingAvatar').classList.toggle('open')">
        <i class="bi bi-robot fs-4"></i>
    </div>
</div>
<script>
(function () {
    // Narrow viewports only — on desktop the bubble sits in empty page margin, never over a
    // table's action column, so there's nothing for scroll-hiding to fix there.
    if (!window.matchMedia('(max-width: 575.98px)').matches) return;
    var el = document.getElementById('floatingAvatar');
    var hideTimer;
    function hideThenSettle(delayMs) {
        el.classList.add('scroll-hide');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () { el.classList.remove('scroll-hide'); }, delayMs);
    }
    window.addEventListener('scroll', function () { hideThenSettle(500); }, { passive: true });
    // Whatever row/button happens to land under the bubble's fixed corner on a freshly loaded
    // page (no scroll needed to reproduce it — e.g. a short list on /Rbac or /Users) is just as
    // covered as it would be mid-scroll. Give the page a beat to be seen and tapped before the
    // bubble fades in.
    hideThenSettle(1200);
})();
</script>
