@model AssetMultiPickerModel
@{
    var containerId = $"picker-{Model.Name}";
}
<div id="@containerId" class="position-relative">
    @if (Model.Categories != null && Model.LocationCategories != null)
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="small text-muted">@Loc.T("Combine filters")</span>
            <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="@(containerId)-filterMode" id="@(containerId)-modeUnion" value="union" checked>
                <label class="btn btn-outline-secondary btn-sm" for="@(containerId)-modeUnion">@Loc.T("Any")</label>
                <input type="radio" class="btn-check" name="@(containerId)-filterMode" id="@(containerId)-modeIntersection" value="intersection">
                <label class="btn btn-outline-secondary btn-sm" for="@(containerId)-modeIntersection">@Loc.T("Both")</label>
            </div>
        </div>
    }
    @if (Model.LocationCategories != null)
    {
        <div class="d-flex flex-wrap gap-2 align-items-end mb-2 p-2 bg-light rounded">
            <div>
                <label class="form-label small mb-1">@Loc.T("Location Category")</label>
                <select class="form-select form-select-sm" data-location-category-select style="min-width:160px">
                    <option value="">@Loc.T("Location Category")</option>
                    @foreach (var c in Model.LocationCategories)
                    {
                        <option value="@c.Id">@Loc.LocalizedName(c.Name, c.NameAr)</option>
                    }
                </select>
            </div>
            <div data-zone-wrap class="d-none">
                <label class="form-label small mb-1">@Loc.T("Zone")</label>
                <div class="position-relative">
                    <input type="text" class="form-control form-control-sm" autocomplete="off" placeholder="@Loc.T("Search zones…")" data-zone-search style="min-width:180px">
                    <input type="hidden" data-zone-select>
                    <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index:1056;max-height:220px;overflow:auto" data-zone-results></div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" data-add-by-location disabled>@Loc.T("Add All")</button>
        </div>
    }
    @if (Model.Categories != null)
    {
        <div class="d-flex flex-wrap gap-2 align-items-end mb-2 p-2 bg-light rounded">
            <div>
                <label class="form-label small mb-1">@Loc.T("Category")</label>
                <select class="form-select form-select-sm" data-category-select style="min-width:160px">
                    <option value="">@Loc.T("Category")</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@Loc.LocalizedName(c.Name, c.NameAr)</option>
                    }
                </select>
            </div>
            <div data-subcategory-wrap class="d-none">
                <label class="form-label small mb-1">@Loc.T("Subcategory")</label>
                <select class="form-select form-select-sm" data-subcategory-select style="min-width:160px">
                    <option value="">@Loc.T("All")</option>
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" data-add-by-category disabled>@Loc.T("Add All")</button>
        </div>
    }
    <div class="d-flex flex-wrap gap-1 mb-2" data-chips>
        @foreach (var chip in Model.Selected)
        {
            <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle d-inline-flex align-items-center gap-1 py-2" data-chip data-id="@chip.Id">
                @chip.Label
                <input type="hidden" name="@Model.Name" value="@chip.Id" />
                <button type="button" class="btn-close btn-close-sm" style="font-size:.6rem" data-remove aria-label="Remove"></button>
            </span>
        }
    </div>
    <input type="text" class="form-control" autocomplete="off" placeholder="@(Model.Placeholder ?? Loc.T("Search"))" data-search />
    <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index:1055;max-height:260px;overflow:auto" data-results></div>
</div>

<script>
(function () {
    const root = document.getElementById('@containerId');
    const chipsEl = root.querySelector('[data-chips]');
    const searchEl = root.querySelector('[data-search]');
    const resultsEl = root.querySelector('[data-results]');
    const inputName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name));
    const isRTL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.IsRTL));
    const localName = i => (isRTL && i.nameAr) ? i.nameAr : i.name;
    let debounceTimer = null;

    function selectedIds() {
        return Array.from(chipsEl.querySelectorAll('[data-chip]')).map(c => Number(c.dataset.id));
    }

    function addChip(id, label) {
        if (selectedIds().includes(id)) return;
        const chip = document.createElement('span');
        chip.className = 'badge bg-primary-subtle text-primary-emphasis border border-primary-subtle d-inline-flex align-items-center gap-1 py-2';
        chip.setAttribute('data-chip', ''); chip.dataset.id = id;
        chip.innerHTML = `${label}<input type="hidden" name="${inputName}" value="${id}"><button type="button" class="btn-close btn-close-sm" style="font-size:.6rem" data-remove aria-label="Remove"></button>`;
        chip.querySelector('[data-remove]').addEventListener('click', () => chip.remove());
        chipsEl.appendChild(chip);
    }

    chipsEl.querySelectorAll('[data-remove]').forEach(btn => btn.addEventListener('click', () => btn.closest('[data-chip]').remove()));

    const jsNoMatches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("No matching assets")));

    async function search(term) {
        const res = await fetch(`/Assets/Search?q=${encodeURIComponent(term)}`);
        const items = await res.json();
        resultsEl.innerHTML = '';
        const available = items.filter(i => !selectedIds().includes(i.id));
        if (available.length === 0) {
            if (term) {
                const empty = document.createElement('div');
                empty.className = 'list-group-item small text-muted';
                empty.textContent = jsNoMatches;
                resultsEl.appendChild(empty);
                resultsEl.classList.remove('d-none');
            } else {
                resultsEl.classList.add('d-none');
            }
            return;
        }
        available.forEach(i => {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action small';
            item.textContent = `${i.assetTag} — ${i.name}`;
            item.addEventListener('click', () => {
                addChip(i.id, `${i.assetTag} — ${i.name}`);
                searchEl.value = '';
                resultsEl.classList.add('d-none');
                searchEl.focus();
            });
            resultsEl.appendChild(item);
        });
        resultsEl.classList.remove('d-none');
    }

    searchEl.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => search(searchEl.value.trim()), 220);
    });
    searchEl.addEventListener('focus', () => search(searchEl.value.trim()));
    document.addEventListener('click', e => { if (!root.contains(e.target)) resultsEl.classList.add('d-none'); });

    // "Combine filters" toggle — 'union' (default): Category/Location "Add All" each bulk-add
    // independently, as before. 'intersection': whichever button is clicked, the current selections
    // of BOTH filter blocks are ANDed together via /Assets/ByLocation's optional categoryId param.
    let filterMode = 'union';
    root.querySelectorAll('input[name="@containerId-filterMode"]').forEach(r => {
        r.addEventListener('change', () => { if (r.checked) filterMode = r.value; });
    });

    // "Add all assets in category" — bulk-adds the current snapshot of a category's (or
    // subcategory's) assets as normal removable chips; addChip's dedup skips ones already added.
    const catSel = root.querySelector('[data-category-select]');
    const subSel = root.querySelector('[data-subcategory-select]');
    const subWrap = root.querySelector('[data-subcategory-wrap]');
    const addByCategoryBtn = root.querySelector('[data-add-by-category]');
    if (catSel) {
        catSel.addEventListener('change', async () => {
            subSel.innerHTML = `<option value="">${@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("All")))}</option>`;
            if (!catSel.value) { subWrap.classList.add('d-none'); addByCategoryBtn.disabled = true; return; }
            const subs = await (await fetch(`/AssetCategories/ByParent?parentId=${catSel.value}`)).json();
            subs.forEach(s => { const opt = document.createElement('option'); opt.value = s.id; opt.textContent = localName(s); subSel.appendChild(opt); });
            subWrap.classList.toggle('d-none', subs.length === 0);
            addByCategoryBtn.disabled = false;
        });
        addByCategoryBtn.addEventListener('click', async () => {
            const categoryId = (subSel.value) ? subSel.value : catSel.value;
            if (!categoryId) return;
            const params = new URLSearchParams({ categoryId });
            let url = `/Assets/ByCategory?${params}`;
            if (filterMode === 'intersection') {
                const zoneVal = root.querySelector('[data-zone-select]')?.value;
                const locCatVal = root.querySelector('[data-location-category-select]')?.value;
                const locationSel = zoneVal ? { zoneId: zoneVal } : locCatVal ? { locationCategoryId: locCatVal } : null;
                if (locationSel) {
                    const p = new URLSearchParams({ categoryId, ...locationSel });
                    url = `/Assets/ByLocation?${p}`;
                }
            }
            const items = await (await fetch(url)).json();
            items.forEach(i => addChip(i.id, `${i.assetTag} — ${i.name}`));
        });
    }

    // "Add all assets at a location scope" — pick a Location Category, then immediately search/scroll
    // a flat list of its zones (no further cascading levels); addByLocationBtn uses whichever is most
    // specific (Zone > Category). addChip's dedup skips ones already added by other pickers.
    const locCatSel = root.querySelector('[data-location-category-select]');
    const zoneSearchEl = root.querySelector('[data-zone-search]');
    const zoneSelectHidden = root.querySelector('[data-zone-select]');
    const zoneResultsEl = root.querySelector('[data-zone-results]');
    const zoneWrap = root.querySelector('[data-zone-wrap]');
    const addByLocationBtn = root.querySelector('[data-add-by-location]');
    let zonesInCategory = [];

    function renderZoneResults(term) {
        const filtered = zonesInCategory.filter(z => localName(z).toLowerCase().includes(term.toLowerCase()));
        zoneResultsEl.innerHTML = '';
        filtered.forEach(z => {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action small';
            item.textContent = localName(z);
            item.addEventListener('click', () => {
                zoneSelectHidden.value = z.id;
                zoneSearchEl.value = localName(z);
                zoneResultsEl.classList.add('d-none');
                addByLocationBtn.disabled = false;
            });
            zoneResultsEl.appendChild(item);
        });
        zoneResultsEl.classList.toggle('d-none', filtered.length === 0);
    }

    if (locCatSel) {
        locCatSel.addEventListener('change', async () => {
            zoneSelectHidden.value = ''; zoneSearchEl.value = ''; zonesInCategory = [];
            zoneWrap.classList.add('d-none'); addByLocationBtn.disabled = true;
            if (!locCatSel.value) return;
            zonesInCategory = await (await fetch(`/Zones/ByCategory?locationCategoryId=${locCatSel.value}`)).json();
            zoneWrap.classList.remove('d-none');
            addByLocationBtn.disabled = false;
        });
        zoneSearchEl.addEventListener('input', () => {
            zoneSelectHidden.value = '';
            renderZoneResults(zoneSearchEl.value.trim());
        });
        zoneSearchEl.addEventListener('focus', () => renderZoneResults(zoneSearchEl.value.trim()));
        document.addEventListener('click', e => { if (!zoneWrap.contains(e.target)) zoneResultsEl.classList.add('d-none'); });

        addByLocationBtn.addEventListener('click', async () => {
            const params = new URLSearchParams();
            if (zoneSelectHidden.value) params.set('zoneId', zoneSelectHidden.value);
            else if (locCatSel.value) params.set('locationCategoryId', locCatSel.value);
            else return;
            if (filterMode === 'intersection') {
                const categoryId = subSel && subSel.value ? subSel.value : (catSel && catSel.value ? catSel.value : null);
                if (categoryId) params.set('categoryId', categoryId);
            }
            const items = await (await fetch(`/Assets/ByLocation?${params}`)).json();
            items.forEach(i => addChip(i.id, `${i.assetTag} — ${i.name}`));
        });
    }
})();
</script>
