@using System.Text.Json
@using ShiftFlow.Web.Services
@{
    var isRTL = Loc.IsRTL;
    var currentPath = Context.Request.Path + Context.Request.QueryString;

    // One IPermissionService lookup (memory-cached per user) instead of the ~21 separate
    // AuthorizeAsync calls this block used to make — each of which opened its own DI scope —
    // plus the UserManager.GetUserAsync for the display name. Feature views can reuse the same
    // cached result: @@{ var perms = await Context.GetNavPermissionsAsync(); }
    var perms = await Context.GetNavPermissionsAsync();
    var displayName = perms.DisplayName;

    var currentController = ViewContext.RouteData.Values["controller"] as string ?? "";
    var currentAction = ViewContext.RouteData.Values["action"] as string ?? "";
    // Active state is decided here, from the route, rather than by comparing the full href
    // (query string included) to window.location.href in JS — which matched only the bare
    // index URL and left every filtered/paged list with no sidebar highlight at all.
    // Pass an action only where one controller owns more than one sidebar item.
    string NavCls(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "nav-link active" : "nav-link";

    // Strings site.js / zone-map.js need. Serialized here so nothing client-side has to carry
    // hard-coded English that an Arabic user would still be shown (see window.t in site.js).
    var i18n = new Dictionary<string, object>
    {
        ["confirm"] = Loc.T("Are you sure?"),
        ["close"] = Loc.T("Close"),
        ["remove"] = Loc.T("Remove"),
        ["noMatches"] = Loc.T("No matches"),
        ["loadFailed"] = Loc.T("Couldn't load — please try again."),
        ["viewLink"] = Loc.T("View") + " →",
        ["assetsCount"] = Loc.T("asset(s)"),
        ["qrPoint"] = Loc.T("Point the camera at an asset's QR label…"),
        ["qrResolving"] = Loc.T("Looking up asset…"),
        ["qrNotAnAsset"] = Loc.T("That QR code isn't an asset label — keep scanning…"),
        ["qrInsecureContext"] = Loc.T("Camera access needs a secure connection (HTTPS), or http://localhost on this same computer — scanning over a plain http:// LAN address like this one is blocked by the browser."),
        ["qrNoSupport"] = Loc.T("This browser can't access the camera."),
        ["qrDenied"] = Loc.T("Camera access was denied — allow camera access for this site in your browser settings and try again."),
        ["qrNoCamera"] = Loc.T("No camera was found on this device."),
        ["qrInUse"] = Loc.T("The camera is already in use by another app or browser tab."),
        ["qrOtherError"] = Loc.T("Camera access is unavailable — check your browser/device permissions."),
        ["qrScannerUnavailable"] = Loc.T("The QR scanner couldn't be loaded — check your connection and try again."),
        ["qrLookupFailed"] = Loc.T("Couldn't look that asset up — please try again."),
        ["status"] = StatusStyle.JsLabelNames.ToDictionary(n => n, n => Loc.T(n)),
    };

    // ---------------------------------------------------------------------------------
    // AI assistant (drawer + full page). Everything the client script needs is emitted
    // here so ai-assistant.js stays Razor-free and can live on every page, not just the
    // AI Assistant view.
    // ---------------------------------------------------------------------------------
    // Redundant on the AI Assistant page itself — you're already looking at the chat there,
    // and _AiChat's element ids must stay unique per page.
    var onAiAssistantPage = string.Equals(currentController, "AiAssistant", StringComparison.OrdinalIgnoreCase);

    // Page context sent with every assistant query. A detail view opts in precisely with
    //     ViewData["AiContext"] = new { entityType = "WorkOrder", entityId = Model.Id, title = Model.WorkOrderNumber };
    // (see NOTES-ai-frontend.md); everything else falls back to a best-effort guess from the
    // route + page title, which is enough for "what am I looking at" style questions.
    object? aiContext;
    if (ViewData["AiContext"] is { } explicitAiContext)
    {
        aiContext = explicitAiContext;
    }
    else if (onAiAssistantPage)
    {
        // "Viewing AI Assistant" is a meaningless self-reference — the assistant page is not a
        // record you can ask about, so it contributes no context at all.
        aiContext = null;
    }
    else
    {
        var controllerEntityTypes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["WorkOrders"] = "WorkOrder",
            ["InspectionOrders"] = "InspectionOrder",
            ["Orders"] = "InspectionOrder",
            ["MaintenanceOrders"] = "MaintenanceOrder",
            ["Assets"] = "Asset",
            ["Zones"] = "Zone",
            ["ZoneOverview"] = "Zone",
            ["SpareParts"] = "SparePart",
            ["Contracts"] = "Contract",
            ["Vendors"] = "Vendor",
            ["Users"] = "User",
            ["Groups"] = "Group",
        };
        var routeId = ViewContext.RouteData.Values["id"]?.ToString();
        // entityType only means something alongside an id — on a list page it would claim the
        // user is looking at one record when they're looking at all of them.
        var entityType = !string.IsNullOrEmpty(routeId)
            && controllerEntityTypes.TryGetValue(currentController, out var mappedEntityType) ? mappedEntityType : null;
        aiContext = new
        {
            page = $"{currentController}/{currentAction}",
            title = ViewData["Title"] as string,
            entityType,
            entityId = string.IsNullOrEmpty(routeId) ? null : routeId,
        };
    }

    var aiConfig = new
    {
        urls = new
        {
            query = Url.Action("Query", "AiAssistant"),
            confirm = Url.Action("Confirm", "AiAssistant"),
            dismiss = Url.Action("Dismiss", "AiAssistant"),
            speechToken = Url.Action("SpeechToken", "AiAssistant"),
            avatarIceToken = Url.Action("AvatarIceToken", "AiAssistant"),
            login = Url.Action("Login", "Account"),
            fullPage = Url.Action("Index", "AiAssistant"),
            // Order/asset codes inside a reply are auto-linked to these search pages, since the
            // reply text carries a human-readable code, not a database id.
            searchWorkOrders = Url.Action("Index", "WorkOrders"),
            searchOrders = Url.Action("Index", "Orders"),
            searchAssets = Url.Action("Index", "Assets"),
            // Loaded on demand the first time voice is used, so the ~1MB SDK isn't pulled onto
            // every page of the app just because the drawer exists there.
            speechSdk = "https://cdn.jsdelivr.net/npm/microsoft-cognitiveservices-speech-sdk@1.38.0/distrib/browser/microsoft.cognitiveservices.speech.sdk.bundle-min.js",
        },
        speech = new
        {
            locale = Loc.Lang == "ar" ? "ar-SA" : "en-US",
            voice = Loc.Lang == "ar" ? "ar-SA-ZariyahNeural" : "en-US-JennyNeural",
            // Real-time Avatar uses its own character/style/voice config, independent of the
            // plain-audio fallback voice above.
            avatarVoice = Loc.Lang == "ar" ? "ar-KW-FahedNeural" : "en-US-GuyNeural",
            avatarCharacter = "harry",
            avatarStyle = "business",
            avatarBackground = "#F3F4F6FF",
        },
        strings = new
        {
            greeting = Loc.T("Hi! I'm your STEP AI assistant. I can help you check inspection orders, manage groups, report on assets, and more. What can I do for you today?"),
            noResponse = Loc.T("No response received."),
            genericError = Loc.T("An error occurred. Please try again."),
            networkError = Loc.T("Network error. Please check your connection and try again."),
            chatCleared = Loc.T("Chat cleared. How can I help you?"),
            avatarUnavailable = Loc.T("Avatar unavailable — voice replies still work."),
            voiceUnavailable = Loc.T("Voice is unavailable right now."),
            voiceOff = Loc.T("Voice and avatar are off."),
            connectingAvatar = Loc.T("Connecting avatar…"),
            sessionExpired = Loc.T("Your session expired. Please sign in again."),
            rateLimited = Loc.T("Too many requests. Please wait a moment and try again."),
            signIn = Loc.T("Sign in"),
            retry = Loc.T("Retry"),
            copy = Loc.T("Copy reply"),
            copied = Loc.T("Copied"),
            confirmAction = Loc.T("Confirm"),
            cancel = Loc.T("Cancel"),
            cancelled = Loc.T("Cancelled"),
            confirmed = Loc.T("Done"),
            download = Loc.T("Download"),
            andMore = Loc.T("…and more"),
            viewing = Loc.T("Viewing"),
            chips = new
            {
                workOrder = new[]
                {
                    new { label = Loc.T("Summarize"), prompt = Loc.T("Summarize this order") },
                    new { label = Loc.T("Asset history"), prompt = Loc.T("What's the asset's history?") },
                    new { label = Loc.T("Send to vendor"), prompt = Loc.T("Send to vendor…") },
                },
                asset = new[]
                {
                    new { label = Loc.T("Health summary"), prompt = Loc.T("Health summary") },
                    new { label = Loc.T("Open work orders"), prompt = Loc.T("Open work orders") },
                    new { label = Loc.T("Report a defect"), prompt = Loc.T("Report a defect") },
                },
                fallback = new[]
                {
                    new { label = Loc.T("My attention"), prompt = Loc.T("What needs my attention today?") },
                    new { label = Loc.T("My open orders"), prompt = Loc.T("My open orders") },
                    new { label = Loc.T("Low stock parts"), prompt = Loc.T("Low stock parts") },
                    new { label = Loc.T("Expiring contracts"), prompt = Loc.T("Contracts expiring soon") },
                    new { label = Loc.T("Export to Excel"), prompt = Loc.T("Export work orders to Excel") },
                },
            },
        },
    };
}
<!DOCTYPE html>
<html lang="@Loc.Lang" dir="@(isRTL ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - STEP</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true" />
    <partial name="_HeadLinks" />
    <script>
        // Applied before the sidebar renders so the desktop collapsed
        // preference (persisted in localStorage, see site.js) takes effect
        // on the very first paint instead of flashing expanded-then-collapsed.
        if (localStorage.getItem('sidebarCollapsed') === '1') {
            document.documentElement.classList.add('sidebar-collapsed-pref');
        }
    </script>
    <script>window.i18n = @Html.Raw(JsonSerializer.Serialize(i18n));</script>
    @if (perms.CanUseAi)
    {
        @* What the user is looking at right now, read by ai-assistant.js and sent as `context`
           with every query. Razor HTML-encodes the JSON into the attribute; the browser decodes
           it back before JSON.parse sees it. *@
        @if (aiContext is not null)
        {
            <meta name="ai-context" content="@JsonSerializer.Serialize(aiContext)" />
        }
        <link rel="stylesheet" href="~/css/ai-assistant.css" asp-append-version="true" />
    }
</head>
<body>
<a href="#mainContent" class="skip-link">@Loc.T("Skip to main content")</a>
<div class="d-flex" id="wrapper">
    <nav id="sidebar" class="p-3 d-flex flex-column">
        <div class="d-flex align-items-center justify-content-center mb-1 pb-1 border-bottom border-secondary">
            <img src="~/images/logo.png" asp-append-version="true" class="sidebar-logo" alt="Ministry of Electricity, Water and Renewable Energy" />
        </div>

        <ul class="nav flex-column gap-1 flex-grow-1 sidebar-nav-scroll">

        @if (User.IsInRole("Vendor"))
        {
            <li class="nav-section-label">@Loc.T("Vendor Portal")</li>
            <li><a class="@NavCls("VendorPortal")" asp-controller="VendorPortal" asp-action="Index"><i class="bi bi-tools me-2"></i>@Loc.T("My Work Orders")</a></li>
        }
        else
        {
            @if (perms.CanViewMyWork)
            {
                <li class="nav-section-label">@Loc.T("My Work")</li>
                <li><a class="@NavCls("MyHome")" asp-controller="MyHome" asp-action="Index"><i class="bi bi-house-door me-2"></i>@Loc.T("My Home")</a></li>
                <li><a class="@NavCls("Users", "MyOrders")" asp-controller="Users" asp-action="MyOrders"><i class="bi bi-list-check me-2"></i>@Loc.T("My Orders")</a></li>
            }

            @if (perms.CanManageInspectionOrders || perms.CanViewSpareParts)
            {
                <li class="nav-section-label mt-3">@Loc.T("Overview")</li>
                @if (perms.CanManageInspectionOrders)
                {
                    <li><a class="@NavCls("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>@Loc.T("Executive Dashboard")</a></li>
                    <li><a class="@NavCls("ZoneOverview")" asp-controller="ZoneOverview" asp-action="Index"><i class="bi bi-geo me-2"></i>@Loc.T("Zone Overview")</a></li>
                }
                @if (perms.CanViewSpareParts)
                {
                    <li><a class="@NavCls("SparePartsAnalytics")" asp-controller="SparePartsAnalytics" asp-action="Index"><i class="bi bi-graph-up me-2"></i>@Loc.T("Spare Parts Analytics")</a></li>
                }
            }

            @if (perms.CanViewInspectionOrders || perms.CanViewMaintenanceOrders)
            {
                <li class="nav-section-label mt-3">@Loc.T("Inspection & Maintenance")</li>
                <li><a class="@NavCls("Orders", "Index")" asp-controller="Orders" asp-action="Index"><i class="bi bi-list-check me-2"></i>@Loc.T("All Orders")</a></li>
                @if (perms.CanManageInspectionOrders || perms.CanManageMaintenanceOrders)
                {
                    <li><a class="@NavCls("Orders", "Create")" asp-controller="Orders" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>@Loc.T("New Order")</a></li>
                }
            }

            @if (perms.CanViewAssets || perms.CanViewWorkOrders || perms.CanViewVendors || perms.CanViewContracts || perms.CanViewSpareParts)
            {
                <li class="nav-section-label mt-3">@Loc.T("Asset Management")</li>
                if (perms.CanViewAssets)
                {
                    <li><a class="@NavCls("Assets")" asp-controller="Assets" asp-action="Index"><i class="bi bi-box-seam me-2"></i>@Loc.T("Assets")</a></li>
                }
                if (perms.CanViewWorkOrders)
                {
                    <li><a class="@NavCls("WorkOrders")" asp-controller="WorkOrders" asp-action="Index"><i class="bi bi-tools me-2"></i>@Loc.T("Work Orders")</a></li>
                }
                if (perms.CanViewVendors)
                {
                    <li><a class="@NavCls("Vendors")" asp-controller="Vendors" asp-action="Index"><i class="bi bi-building-gear me-2"></i>@Loc.T("Vendors")</a></li>
                }
                if (perms.CanViewContracts)
                {
                    <li><a class="@NavCls("Contracts")" asp-controller="Contracts" asp-action="Index"><i class="bi bi-file-earmark-text me-2"></i>@Loc.T("Contracts")</a></li>
                }
                if (perms.CanViewSpareParts)
                {
                    <li><a class="@NavCls("SpareParts")" asp-controller="SpareParts" asp-action="Index"><i class="bi bi-boxes me-2"></i>@Loc.T("Spare Parts")</a></li>
                }
            }

            // Low-traffic admin lookup lists (rarely touched day-to-day) collapsed into one
            // Settings item instead of each being its own flat sidebar item — folded into
            // Administration (no separate "Settings" section header) per feedback. Auto-expanded
            // when the user is actually on one of these pages.
            var hasAssetSettingsLinks = perms.CanViewAssets || perms.CanManageAssetCategories || perms.CanManageOrderTypes;
            var hasSettingsItem = hasAssetSettingsLinks || perms.CanViewGroups;
            // For an Engineer this group holds nothing but lookup tables (Asset Categories,
            // Zones) — calling that "Administration" implies powers they don't have and makes
            // the section look like somewhere they shouldn't be. The heading only says
            // "Administration" when the user actually holds one of the administrative
            // permissions; otherwise it's "Reference Data".
            var hasAdminLinks = perms.CanViewUsers || perms.CanManageRbac || perms.CanViewAuditLogs || perms.CanManageAssetScope;
            @if (hasAdminLinks || hasSettingsItem)
            {
                <li class="nav-section-label mt-3">@Loc.T(hasAdminLinks ? "Administration" : "Reference Data")</li>
                @if (perms.CanViewUsers)
                {
                    <li><a class="@NavCls("Users", "Index")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge me-2"></i>@Loc.T("Users")</a></li>
                }
                @if (perms.CanManageRbac)
                {
                    <li><a class="@NavCls("Rbac")" asp-controller="Rbac" asp-action="Index"><i class="bi bi-shield-lock me-2"></i>@Loc.T("Permissions")</a></li>
                }
                @if (perms.CanManageAssetScope)
                {
                    <li><a class="@NavCls("UserAssetScopes")" asp-controller="UserAssetScopes" asp-action="Index"><i class="bi bi-person-lock me-2"></i>@Loc.T("Asset Visibility")</a></li>
                }
                @if (perms.CanViewAuditLogs)
                {
                    <li><a class="@NavCls("AuditLogs")" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text me-2"></i>@Loc.T("Audit Logs")</a></li>
                }
                @if (hasSettingsItem)
                {
                    var settingsControllers = new[] { "AssetCategories", "Zones", "WorkOrderBlockReasons", "MaintenanceActionTypes", "OrderTypes", "RecurringOrders", "Groups" };
                    var isOnSettingsPage = settingsControllers.Contains(currentController, StringComparer.OrdinalIgnoreCase);
                    <li>
                        <a class="nav-link" href="#assetSettingsGroup" data-bs-toggle="collapse" role="button"
                           aria-expanded="@(isOnSettingsPage ? "true" : "false")" aria-controls="assetSettingsGroup">
                            <i class="bi bi-sliders me-2"></i>@Loc.T("Settings")
                            <i class="bi bi-chevron-down ms-auto small nav-group-chevron"></i>
                        </a>
                        <div class="collapse @(isOnSettingsPage ? "show" : "")" id="assetSettingsGroup">
                            <ul class="nav flex-column gap-1 ps-3">
                                @if (perms.CanViewAssets)
                                {
                                    <li><a class="@NavCls("AssetCategories")" asp-controller="AssetCategories" asp-action="Index"><i class="bi bi-diagram-2 me-2"></i>@Loc.T("Asset Categories")</a></li>
                                    <li><a class="@NavCls("Zones")" asp-controller="Zones" asp-action="Index"><i class="bi bi-map me-2"></i>@Loc.T("Zones")</a></li>
                                }
                                @if (perms.CanManageAssetCategories)
                                {
                                    <li><a class="@NavCls("WorkOrderBlockReasons")" asp-controller="WorkOrderBlockReasons" asp-action="Index"><i class="bi bi-slash-circle me-2"></i>@Loc.T("Block Reasons")</a></li>
                                    <li><a class="@NavCls("MaintenanceActionTypes")" asp-controller="MaintenanceActionTypes" asp-action="Index"><i class="bi bi-wrench me-2"></i>@Loc.T("Maintenance Action Types")</a></li>
                                }
                                @if (perms.CanManageOrderTypes)
                                {
                                    <li><a class="@NavCls("OrderTypes")" asp-controller="OrderTypes" asp-action="Index"><i class="bi bi-tags me-2"></i>@Loc.T("Order Types")</a></li>
                                    <li><a class="@NavCls("RecurringOrders")" asp-controller="RecurringOrders" asp-action="Index"><i class="bi bi-arrow-repeat me-2"></i>@Loc.T("Recurring Orders")</a></li>
                                }
                                @if (perms.CanViewGroups)
                                {
                                    <li><a class="@NavCls("Groups")" asp-controller="Groups" asp-action="Index"><i class="bi bi-people me-2"></i>@Loc.T("Groups")</a></li>
                                }
                            </ul>
                        </div>
                    </li>
                }
            }

            @if (perms.CanUseAi)
            {
                <li class="nav-section-label mt-3">@Loc.T("AI Assistant")</li>
                <li><a class="@NavCls("AiAssistant")" asp-controller="AiAssistant" asp-action="Index"><i class="bi bi-robot me-2"></i>@Loc.T("AI Assistant")</a></li>
            }
        }
        </ul>

        <div class="border-top border-secondary pt-2 mt-2">
            <div class="small mb-1 text-truncate">
                @if (!User.IsInRole("Vendor"))
                {
                    <a asp-controller="Users" asp-action="Profile" asp-route-id="@perms.UserId" class="text-white-50 text-decoration-none">
                        <i class="bi bi-person-circle me-1"></i>@displayName
                    </a>
                }
                else
                {
                    <span class="text-white-50"><i class="bi bi-person-circle me-1"></i>@displayName</span>
                }
            </div>
            <a asp-controller="Account" asp-action="ChangePassword" class="d-block small text-white-50 text-decoration-none mb-1">
                <i class="bi bi-key me-1"></i>@Loc.T("Change Password")
            </a>
            <div class="d-flex gap-1">
                <form asp-controller="Language" asp-action="SetLanguage" method="post" class="flex-fill">
                    <input type="hidden" name="returnUrl" value="@currentPath" />
                    <input type="hidden" name="lang" value="@(isRTL ? "en" : "ar")" />
                    <button type="submit" class="btn btn-sm btn-outline-light w-100">
                        <i class="bi bi-translate me-1"></i>@(isRTL ? "English" : "عربي")
                    </button>
                </form>
                <form asp-controller="Account" asp-action="Logout" method="post" class="flex-fill">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-box-arrow-right me-1"></i>@Loc.T("Logout")
                    </button>
                </form>
            </div>
        </div>
    </nav>
    <div id="sidebarBackdrop"></div>

    <div class="flex-grow-1 d-flex flex-column">
        <nav class="navbar bg-white border-bottom px-3 px-md-4 py-2 shadow-sm flex-wrap">
            @* Kept at every width: below 992px it opens the sidebar drawer, at 992px+ it collapses the
           always-visible sidebar to free content width (a real preference, persisted — see
           initSidebar in site.js), so it is not hidden on desktop. *@
        <button class="btn btn-sm btn-outline-secondary me-3" id="sidebarToggle" type="button"
                aria-label="@Loc.T("Toggle menu")" title="@Loc.T("Toggle menu")"><i class="bi bi-list fs-5" aria-hidden="true"></i></button>
            <span class="fw-semibold text-primary">@ViewData["Title"]</span>
            <div class="ms-auto d-flex align-items-center gap-2 gap-md-3">
                @* Server value is UTC; site.js re-renders it in the viewer's own timezone/locale. *@
                <span class="text-muted small d-none d-sm-inline" data-local-date="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ")">@Loc.TDate(DateTime.UtcNow.ToString("dd/MM/yyyy"))</span>
            </div>
        </nav>
        <main id="mainContent" tabindex="-1" class="flex-grow-1 p-3 p-md-4" style="background:hsl(var(--background))">
            @RenderBody()
        </main>
        <footer class="bg-white border-top text-center text-muted small py-2">STEP &copy; @DateTime.UtcNow.Year</footer>
    </div>
</div>

@* Every TempData Success/Error message in the app surfaces here, once. *@
<partial name="_Toast" />

@* The floating button opens the slide-over drawer (_AiDrawer); both are skipped on the AI
   Assistant page itself, where the full-page chat already owns those element ids. *@
@if (perms.CanUseAi && !onAiAssistantPage)
{
    <partial name="_FloatingAvatar" />
    <partial name="_AiDrawer" />
}

@* Shared across every asset picker's "Scan QR" button (see _AssetSinglePicker/_AssetMultiPicker) —
   one modal + camera stream reused instead of each picker instance carrying its own. *@
<div class="modal fade" id="assetQrScanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">@Loc.T("Scan Asset QR Code")</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Loc.T("Close")"></button>
            </div>
            <div class="modal-body text-center">
                <video id="assetQrScanVideo" class="w-100 rounded bg-dark" playsinline muted style="max-height:60vh"></video>
                <div id="assetQrScanStatus" class="small text-muted mt-2" role="status" aria-live="polite">@Loc.T("Point the camera at an asset's QR label…")</div>
            </div>
        </div>
    </div>
</div>

@* Chart.js used to load on every page for the two views that actually draw charts, and jsQR for
   the asset-picker scan button — both are now pulled in only where/when they're needed
   (Dashboard and SparePartsAnalytics include Chart.js in their own @@section Scripts; site.js
   injects jsQR on the first scanAssetQr call). *@
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (perms.CanUseAi)
{
    @* Loaded on every page now, not just Views/AiAssistant — the drawer is everywhere.
