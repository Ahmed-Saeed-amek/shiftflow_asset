@model ShiftFlow.Web.ViewModels.PageHeaderModel
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-2">
    <div>
        <h1 class="fs-3 fw-bold font-heading mb-0">@Loc.T(Model.Title)</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="text-muted small mt-1 mb-0">@Loc.T(Model.Subtitle)</p>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ActionsHtml))
    {
        <div class="d-flex gap-2">@Html.Raw(Model.ActionsHtml)</div>
    }
</div>
