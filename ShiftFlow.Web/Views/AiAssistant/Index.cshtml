@using ShiftFlow.Web.ViewModels
@{
    ViewData["Title"] = Loc.T("AI Assistant");
    // window.aiAssistantConfig, ai-assistant.css and ai-assistant.js are emitted globally by
    // _Layout (the drawer needs them on every page), so this view carries no config of its own.
}

<partial name="_PageHeader" model="@(new PageHeaderModel {
    Title = Loc.T("AI Assistant"),
    Subtitle = Loc.T("Ask STEP about inspection orders, groups, and more — by voice or text.") })" />

<div class="ai-layout">
    <div class="ai-side">
        <div class="ai-side-card">
            <div class="ai-side-card-header">
                <h6>@Loc.T("Assistant")</h6>
            </div>

            <div class="ai-side-card-body">
                @* The video avatar is full-page only — the drawer keeps voice but no avatar. *@
                <div class="ai-avatar-scene" id="avatarScene">
                    <video id="avatarVideo" autoplay playsinline muted></video>
                    <audio id="avatarAudio" autoplay></audio>
                    <div class="ai-avatar-overlay" id="avatarOverlay">
                        <div class="ai-avatar-spinner d-none" id="avatarOverlaySpinner"></div>
                        <span id="avatarOverlayText"></span>
                        <button type="button" class="btn btn-sm btn-primary d-none" id="btnEnableVoice">
                            @Loc.T("Enable voice")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="ai-chat-wrap">
        <div class="ai-header">
            <h6 id="aiConversationLabel">@Loc.T("Conversation")</h6>
            <button type="button" class="btn-clear" id="btnClear" aria-label="@Loc.T("Clear conversation")">@Loc.T("Clear")</button>
        </div>

        <partial name="_AiChat" />
    </div>
</div>
