@using Microsoft.AspNetCore.Authorization
@model SparePart
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Model.Name;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.SparePartManage)).Succeeded;
    var isLow = Model.ReorderThreshold != null && Model.StockQuantity <= Model.ReorderThreshold;
    var recentUsage = (List<SparePartUsageRow>)ViewBag.RecentUsage;
    string actionsHtml = canManage
        ? "<a href='" + Url.Action("Edit", new { id = Model.Id }) + "' class='btn btn-outline-secondary btn-sm'><i class=\"bi bi-pencil me-1\"></i>" + Loc.T("Edit") + "</a>"
        : "";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.LocalizedName(Model.Name, Model.NameAr),ActionsHtml=actionsHtml})" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger small">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success small">@TempData["Success"]</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-box-seam text-primary"></i>@Loc.T("Overview")
            </div>
            <div class="card-body">
                <dl class="row small mb-0 gy-2">
                    <dt class="col-5 text-muted fw-normal">@Loc.T("SKU")</dt>
                    <dd class="col-7 text-end mb-0 font-monospace">@(Model.Sku ?? "—")</dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Unit Cost")</dt>
                    <dd class="col-7 text-end mb-0">@(Model.UnitCost?.ToString("0.00") ?? "—")</dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Stock")</dt>
                    <dd class="col-7 text-end mb-0">
                        <span class="@(isLow ? "text-danger fw-semibold" : "")">@Model.StockQuantity</span>
                        @if (isLow)
                        {
                            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="@Loc.T("At or below reorder threshold")"></i>
                        }
                    </dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Reorder Threshold")</dt>
                    <dd class="col-7 text-end mb-0">@(Model.ReorderThreshold?.ToString() ?? "—")</dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Status")</dt>
                    <dd class="col-7 text-end mb-0"><partial name="_StatusBadge" model="@(Model.IsActive ? "Active" : "Inactive")" /></dd>
                </dl>

                @if (canManage)
                {
                    <form method="post" asp-action="AdjustStock" asp-route-id="@Model.Id" class="mt-3 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        <label class="form-label small text-muted mb-1">@Loc.T("Adjust Stock")</label>
                        <div class="d-flex gap-2">
                            <input type="number" name="newQuantity" min="0" value="@Model.StockQuantity" class="form-control form-control-sm" required />
                            <button type="submit" class="btn btn-sm btn-outline-secondary flex-shrink-0">@Loc.T("Update")</button>
                        </div>
                        <input type="text" name="reason" class="form-control form-control-sm mt-2" placeholder="@Loc.T("Reason (optional)")" />
                        <div class="form-text mt-1">@Loc.T("For corrections and deliveries — doesn't count as usage in Recent Usage or Analytics.")</div>
                    </form>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-hdd-stack text-primary"></i>@Loc.T("Compatible Assets")
            </div>
            <div class="card-body">
                @if (Model.AssetLinks.Count == 0)
                {
                    <div class="small text-muted">@Loc.T("No assets linked yet.")</div>
                }
                else
                {
                    @foreach (var link in Model.AssetLinks)
                    {
                        <a asp-controller="Assets" asp-action="Details" asp-route-id="@link.AssetId" class="d-block small text-decoration-none py-1">
                            <i class="bi bi-hdd-stack me-1"></i>@link.Asset?.AssetTag — @link.Asset?.Name
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i>@Loc.T("Recent Usage")
            </div>
            <div class="card-body">
                @if (recentUsage.Count == 0)
                {
                    <div class="small text-muted">@Loc.T("No usage recorded yet.")</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>@Loc.T("Order")</th><th>@Loc.T("Quantity")</th><th>@Loc.T("Date")</th></tr></thead>
                            <tbody>
                                @foreach (var u in recentUsage)
                                {
                                    <tr>
                                        <td class="small font-monospace">@u.WorkOrderNumber</td>
                                        <td class="small">@u.Quantity</td>
                                        <td class="small">@Loc.TDate(u.UsedDate.ToString("dd/MM/yyyy"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Loc.T("Back")</a>
    </div>
</div>
