@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@model SparePartDetailsViewModel
@inject IAuthorizationService AuthZ
@{
    var part = Model.Part;
    var partName = Loc.LocalizedName(part.Name, part.NameAr);
    ViewData["Title"] = partName;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.SparePartManage)).Succeeded;
    var isLow = Model.IsLowStock;
    var linkedAssets = Model.LinkedAssets;
    var recentUsage = Model.RecentUsage;

    // This controller has no Delete action, so there is nothing left for a "More" menu to hold:
    // one primary (Edit) and one outline secondary (jump to the Adjust Stock form) is the header.
    Func<object?, IHtmlContent> adjustBtn = @<a href="#adjustStock" class="btn btn-outline-secondary btn-sm"><i class="bi bi-sliders me-1"></i>@Loc.T("Adjust Stock")</a>;
    Func<object?, IHtmlContent> editBtn = @<a href="@Url.Action("Edit", new { id = part.Id })" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>@Loc.T("Edit")</a>;
    var actions = new HtmlContentBuilder();
    if (canManage)
    {
        actions.AppendHtml(adjustBtn(null));
        actions.AppendHtml(editBtn(null));
    }
}
<partial name="_PageHeader" model='new PageHeaderWithActions {
    Title = partName,
    Subtitle = part.Sku,
    Breadcrumbs = new List<(string Label, string? Url)> { (Loc.T("Spare Parts"), Url.Action("Index")), (partName, null) },
    Actions = actions }' />

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-box-seam text-primary"></i>@Loc.T("Overview")
            </div>
            <div class="card-body">
                <dl class="row small mb-0 gy-2">
                    <dt class="col-5 text-muted fw-normal">@Loc.T("SKU")</dt>
                    <dd class="col-7 text-end mb-0 fw-semibold">@(part.Sku ?? "—")</dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Unit Cost")</dt>
                    <dd class="col-7 text-end mb-0">@(part.UnitCost?.ToString("0.00") ?? "—")</dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Stock")</dt>
                    <dd class="col-7 text-end mb-0">
                        <span class="@(isLow ? "text-danger fw-semibold" : "")">@part.StockQuantity</span>
                        @if (isLow)
                        {
                            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="@Loc.T("At or below reorder threshold")"></i>
                        }
                    </dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Reorder Threshold")</dt>
                    <dd class="col-7 text-end mb-0">@(part.ReorderThreshold?.ToString() ?? "—")</dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Status")</dt>
                    <dd class="col-7 text-end mb-0"><partial name="_StatusBadge" model="@(part.IsActive ? "Active" : "Inactive")" /></dd>
                </dl>

                @if (canManage)
                {
                    <form method="post" asp-action="AdjustStock" asp-route-id="@part.Id" class="mt-3 pt-2 border-top" id="adjustStock">
                        @Html.AntiForgeryToken()
                        <label for="newQuantity" class="form-label">@Loc.T("Adjust Stock")</label>
                        <div class="d-flex gap-2">
                            <input type="number" id="newQuantity" name="newQuantity" min="0" value="@part.StockQuantity" class="form-control form-control-sm" required />
                            <button type="submit" class="btn btn-sm btn-outline-secondary flex-shrink-0">@Loc.T("Update")</button>
                        </div>
                        <input type="text" name="reason" class="form-control form-control-sm mt-2" placeholder="@Loc.T("Reason (optional)")" />
                        <div class="help-text">@Loc.T("For corrections and deliveries — this does not count as usage in Recent Usage or Analytics.")</div>
                    </form>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-hdd-stack text-primary"></i>@Loc.T("Compatible Assets")
            </div>
            <div class="card-body">
                @if (linkedAssets.Count == 0)
                {
                    <div class="small text-muted">@Loc.T("No assets linked yet.")</div>
                }
                else
                {
                    @foreach (var link in linkedAssets)
                    {
                        <a asp-controller="Assets" asp-action="Details" asp-route-id="@link.Id" class="d-block small text-decoration-none py-1">
                            <i class="bi bi-hdd-stack me-1"></i>@link.Label
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i>@Loc.T("Recent Usage")
            </div>
            @if (recentUsage.Count == 0)
            {
                <div class="card-body"><div class="small text-muted">@Loc.T("No usage recorded yet.")</div></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-card-stack">
                        <thead><tr><th>@Loc.T("Order")</th><th>@Loc.T("Quantity")</th><th>@Loc.T("Date")</th></tr></thead>
                        <tbody>
                            @foreach (var u in recentUsage)
                            {
                                <tr>
                                    <td data-label="@Loc.T("Order")" class="small fw-semibold">@u.WorkOrderNumber</td>
                                    <td data-label="@Loc.T("Quantity")" class="small">@u.Quantity</td>
                                    <td data-label="@Loc.T("Date")" class="small">@Loc.TDate(u.UsedDate.ToString("dd/MM/yyyy"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
