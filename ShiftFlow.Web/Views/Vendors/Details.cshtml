@using Microsoft.AspNetCore.Authorization
@model Vendor
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Model.Name;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.VendorManage)).Succeeded;
    string actionsHtml = canManage ? "<a href='" + Url.Action("Index") + "' class='btn btn-primary btn-sm'>" + Loc.T("Edit") + "</a>" : "";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Model.Name,Subtitle=Model.Specialization,ActionsHtml=actionsHtml})" />

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Status")</span><partial name="_StatusBadge" model="@Model.Status" /></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Contact Name")</span><span class="small">@Model.ContactName</span></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Phone")</span><span class="small">@Model.Phone</span></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Email")</span><span class="small">@Model.Email</span></div>
            </div>
        </div>

        @if (canManage)
        {
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-white fw-semibold border-0">@Loc.T("Portal Login")</div>
                <div class="card-body">
                    @if (TempData["TempPassword"] != null)
                    {
                        <div class="alert alert-success small">
                            @Loc.T("Temporary password"): <code>@TempData["TempPassword"]</code>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger small">@TempData["Error"]</div>
                    }
                    @if (Model.UserId == null)
                    {
                        <form method="post" asp-action="CreateLogin">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="vendorId" value="@Model.Id" />
                            <label class="form-label small">@Loc.T("Email")</label>
                            <input type="email" name="email" class="form-control form-control-sm mb-2" value="@Model.Email" required />
                            <button type="submit" class="btn btn-sm btn-primary w-100">@Loc.T("Create Login")</button>
                        </form>
                    }
                    else
                    {
                        <div class="small text-success mb-2"><i class="bi bi-check-circle me-1"></i>@Loc.T("Login active") — @Model.User?.Email</div>
                        <form method="post" asp-action="ResetPassword">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="vendorId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">@Loc.T("Reset Password")</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0">@Loc.T("Work Orders")</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>@Loc.T("Work Order Number")</th><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Stage")</th></tr></thead>
                    <tbody>
                        @if (Model.WorkOrders.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                        }
                        @foreach (var w in Model.WorkOrders.OrderByDescending(w => w.CreatedDate))
                        {
                            <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", "WorkOrders", new { id = w.Id })'">
                                <td class="small font-monospace">@w.WorkOrderNumber</td>
                                <td class="small">@w.Asset?.AssetTag</td>
                                <td><partial name="_StatusBadge" model="@w.Stage" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
