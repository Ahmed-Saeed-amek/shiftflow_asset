@model ShiftFlow.Web.ViewModels.EmployeeProfileViewModel
@using Microsoft.AspNetCore.Authorization
@using ShiftFlow.Web.Authorization
@using ShiftFlow.Web.Services
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Model.FullName + " — " + Loc.T("Profile");
    var roleNameArByName = ViewBag.RoleNameArByName as Dictionary<string, string?> ?? new Dictionary<string, string?>();
    var roleLabel = string.Join(", ", Model.Roles.Select(r => RoleDisplay.Name(r, roleNameArByName.GetValueOrDefault(r), Loc.Lang)));
    var canManagePermissions = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.RbacManage)).Succeeded;
    var canManageUsers = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.UserManage)).Succeeded;
    // Profile itself is reachable by anyone viewing their own page (a self-view exception on an
    // otherwise User.View-gated action), so the "Users" breadcrumb link only appears when the
    // directory is actually reachable — for a role without User.View it would dead-end on
    // Access Denied.
    var canViewUsersList = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.UserView)).Succeeded;
    var canViewOrderDetails = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.InspectionOrderView)).Succeeded
        || (await AuthZ.AuthorizeAsync(User, PermissionCatalog.InspectionOrderManage)).Succeeded;
    // Inspection-order stats/tab and the audit log are field-operations data — a role that can
    // only view the employee directory (e.g. HR) shouldn't see them on another user's profile.
    var canViewOrders = canViewOrderDetails;
    var canViewAudit = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.AuditLogView)).Succeeded;
    // Vendor accounts are companies, not employees — Group membership (like Employee #/
    // Department/Specialization) is a person-only concept, so skip it for them rather than
    // add yet another blank "—" row to an already sparse company profile.
    var isVendor = Model.Roles.Contains("Vendor");
    var isSelf = Model.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var breadcrumbs = new List<(string Label, string? Url)>
    {
        (Loc.T("Users"), canViewUsersList ? Url.Action("Index") : null),
        (Model.FullName, null),
    };
}

<partial name="_PageHeader" model="@(new PageHeaderModel{
    Title = Model.FullName,
    Subtitle = roleLabel,
    Breadcrumbs = breadcrumbs })" />

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <partial name="_StatusBadge" model="@(Model.IsActive ? "Active" : "Inactive")" />
    <div class="d-flex flex-wrap gap-2">
        @if (canManageUsers && !isVendor)
        {
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i>@Loc.T("Edit")
            </a>
        }
        @if (canManagePermissions)
        {
            <a href="@Url.Action("UserPermissions", "Rbac", new { userId = Model.Id })" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-shield-lock me-1"></i>@Loc.T("Permissions")
            </a>
        }
        @if (canManageUsers && !isVendor)
        {
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown" aria-expanded="false">
                    @Loc.T("More")<i class="bi bi-chevron-down ms-1"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <form method="post" asp-action="ResetPassword" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item"
                                    data-confirm="@Loc.T("Reset this user's password? They'll need the new temporary password to log in.")">
                                <i class="bi bi-key me-2"></i>@Loc.T("Reset Password")
                            </button>
                        </form>
                    </li>
                    @if (!isSelf)
                    {
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" asp-action="ToggleActive" asp-route-id="@Model.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item @(Model.IsActive ? "text-danger" : null)"
                                        data-confirm="@(Model.IsActive ? Loc.T("Deactivate {0}?", Model.FullName) : Loc.T("Activate {0}?", Model.FullName))">
                                    <i class="bi @(Model.IsActive ? "bi-person-dash" : "bi-person-check") me-2"></i>@(Model.IsActive ? Loc.T("Deactivate") : Loc.T("Activate"))
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@if (TempData["TempPassword"] != null)
{
    <div class="alert alert-success small">@Loc.T("Temporary password"): <code>@TempData["TempPassword"]</code></div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Employee #")</div>
                <div class="fw-semibold">@Model.EmployeeNumber</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Email")</div>
                <div class="fw-semibold text-break">@Model.Email</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Phone")</div>
                <div class="fw-semibold">@Model.Phone</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Role")</div>
                <div class="fw-semibold">@roleLabel</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Department")</div>
                <div class="fw-semibold">@Model.Department</div>
            </div>
            @if (!isVendor)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="text-muted small mb-1">@Loc.T("Groups")</div>
                    <div class="fw-semibold">@(Model.Groups.Count > 0 ? string.Join(", ", Model.Groups.Select(t => Loc.LocalizedName(t.Name, t.NameAr))) : "—")</div>
                </div>
            }
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Specialization")</div>
                <div class="fw-semibold">@Model.Specialization</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Created")</div>
                <div class="fw-semibold">@Loc.TDate(Model.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy"))</div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="text-muted small mb-1">@Loc.T("Last Login")</div>
                <div class="fw-semibold">@(Model.LastLogin.HasValue ? Loc.TDate(Model.LastLogin.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")) : "—")</div>
            </div>
        </div>
    </div>
</div>

@if (canViewOrders)
{
    <h6 class="fw-semibold text-muted text-uppercase mb-2" style="font-size:.7rem;letter-spacing:.08em">@Loc.T("Inspection Orders")</h6>
    @* Same _KpiCard tiles the Dashboard and MyHome use, so the numbers read identically everywhere. *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2"><partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("Assigned"),Value=Model.OrdersAssigned.ToString(),Icon="bi-clipboard-check",Color="primary"})" /></div>
        <div class="col-6 col-md-4 col-xl-2"><partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("Done"),Value=Model.OrdersDone.ToString(),Icon="bi-check2-circle",Color="emerald"})" /></div>
        <div class="col-6 col-md-4 col-xl-2"><partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("Open"),Value=Model.OrdersOpen.ToString(),Icon="bi-folder2-open",Color="amber"})" /></div>
        <div class="col-6 col-md-4 col-xl-2"><partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("In Progress"),Value=Model.OrdersInProgress.ToString(),Icon="bi-hourglass-split",Color="violet"})" /></div>
        <div class="col-6 col-md-4 col-xl-2"><partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("Defective"),Value=Model.DefectsFound.ToString(),Icon="bi-exclamation-triangle",Color="red"})" /></div>
    </div>
}

@if (canViewOrders || canViewAudit)
{
<ul class="nav nav-tabs mb-0 flex-nowrap overflow-x-auto" id="profileTabs" style="-webkit-overflow-scrolling:touch">
    @if (canViewOrders)
    {
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabOrders">
        <i class="bi bi-clipboard-check me-1"></i>@Loc.T("Inspection Orders") <span class="badge bg-light text-dark ms-1">@Model.Orders.Count</span>
    </button></li>
    }
    @if (canViewAudit)
    {
    <li class="nav-item"><button class="nav-link @(!canViewOrders ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabAudit">
        <i class="bi bi-journal-text me-1"></i>@Loc.T("Audit Log") <span class="badge bg-light text-dark ms-1">@Model.AuditLog.Count</span>
    </button></li>
    }
</ul>

<div class="tab-content">

    @if (canViewOrders)
    {
    <div class="tab-pane fade show active" id="tabOrders">
        <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
            @if (!Model.Orders.Any())
            {
                <div class="card-body text-center text-muted py-5">@Loc.T("No inspection orders assigned yet.")</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-card-stack">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc.T("Order #")</th><th>@Loc.T("Status")</th>
                                <th>@Loc.T("Checked")</th><th>@Loc.T("Due Date")</th><th>@Loc.T("Assigned Via")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.Orders)
                            {
                                var orderUrl = canViewOrderDetails ? Url.Action("Details", "InspectionOrders", new { id = o.OrderId }) : null;
                                <tr class="@(orderUrl != null ? "row-link" : null)" data-href="@orderUrl">
                                    <td data-label="@Loc.T("Order #")">
                                        @if (orderUrl != null)
                                        {
                                            <a href="@orderUrl" class="fw-semibold">@o.OrderNumber</a>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">@o.OrderNumber</span>
                                        }
                                    </td>
                                    <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@o.Status" /></td>
                                    <td data-label="@Loc.T("Checked")">@o.CheckedAssets/@o.TotalAssets</td>
                                    <td data-label="@Loc.T("Due Date")" class="small text-nowrap">@(o.DueDate.HasValue ? Loc.TDate(o.DueDate.Value.ToString("dd/MM/yyyy")) : "—")</td>
                                    <td data-label="@Loc.T("Assigned Via")" class="small text-muted" data-hide-mobile>@Loc.T(o.AssignedContext)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    }

    @if (canViewAudit)
    {
    <div class="tab-pane fade @(!canViewOrders ? "show active" : "")" id="tabAudit">
        <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
            @if (!Model.AuditLog.Any())
            {
                <div class="card-body text-center text-muted py-5">@Loc.T("No audit entries.")</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-card-stack">
                        <thead class="table-light">
                            <tr><th>@Loc.T("When")</th><th>@Loc.T("Action")</th><th>@Loc.T("Entity")</th><th>@Loc.T("Details")</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.AuditLog)
                            {
                                <tr>
                                    <td data-label="@Loc.T("When")" class="small text-nowrap text-muted">@Loc.TDate(e.When.ToString("dd/MM/yyyy")) @e.When.ToString("HH:mm")</td>
                                    <td data-label="@Loc.T("Action")"><span class="badge bg-light text-dark border">@e.Action</span></td>
                                    <td data-label="@Loc.T("Entity")" class="small text-muted" data-hide-mobile>@e.EntityType</td>
                                    <td data-label="@Loc.T("Details")" class="small" style="max-width:400px;word-break:break-word">@e.Details</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    }

</div>
}
