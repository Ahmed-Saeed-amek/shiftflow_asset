@model List<ShiftFlow.Web.ViewModels.MyHistoryMonthRow>
@{
    ViewData["Title"] = Loc.T("History");
    var culture = new System.Globalization.CultureInfo(Loc.IsRTL ? "ar" : "en-US");
}

<div class="mb-3">
    <h4 class="mb-1 fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>@Loc.T("History")</h4>
    <div class="text-muted small">@Loc.T("Your past orders, grouped by month")</div>
</div>

<div class="card border-0 shadow-sm">
    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-clock-history fs-1 d-block mb-2 opacity-25"></i>
            @Loc.T("No records found")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc.T("Month")</th>
                        <th>@Loc.T("Inspection")</th>
                        <th>@Loc.T("Maintenance Order")</th>
                        <th>@Loc.T("Work Order")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        var monthDate = new DateTime(m.Year, m.Month, 1);
                        <tr>
                            <td class="fw-semibold">@monthDate.ToString("MMMM yyyy", culture)</td>
                            <td>@m.InspectionCount</td>
                            <td>@m.MaintenanceCount</td>
                            <td>@m.WorkOrderCount</td>
                            <td class="text-end">
                                <a asp-controller="Users" asp-action="MyOrders" asp-route-showAll="true"
                                   asp-route-fromDate="@monthDate.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@monthDate.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")"
                                   class="btn btn-sm btn-outline-primary">@Loc.T("View")</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
