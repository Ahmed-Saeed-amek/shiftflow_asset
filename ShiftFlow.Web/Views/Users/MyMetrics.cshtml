@model ShiftFlow.Web.ViewModels.EmployeeProfileViewModel
@{
    ViewData["Title"] = Loc.T("My Metrics");
    var roleNameArByName = ViewBag.RoleNameArByName as Dictionary<string, string?> ?? new Dictionary<string, string?>();
    var roleLabel = string.Join(", ", Model.Roles.Select(r => Loc.LocalizedName(r, roleNameArByName.GetValueOrDefault(r))));
    var range = (ViewBag.SelectedRange as string) ?? "all";
    var completionRate = Model.OrdersAssigned > 0 ? (int)Math.Round(Model.OrdersDone * 100.0 / Model.OrdersAssigned) : 0;

    string RangeBtn(string key) =>
        range == key ? "btn btn-primary" : "btn btn-outline-secondary";
    string RangeLabel(string key) => key switch
    {
        "month" => Loc.T("This month"),
        "30"    => Loc.T("Last 30 days"),
        "90"    => Loc.T("Last 90 days"),
        _       => Loc.T("All time"),
    };
}

<div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-1 fw-bold"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>@Loc.T("My Metrics")</h4>
        <div class="text-muted small">
            @Model.FullName
            &nbsp;·&nbsp; @roleLabel
        </div>
        <div class="text-muted small fst-italic mt-1">@Loc.T("Inspection order performance — Work Orders and Maintenance Orders aren't counted here")</div>
    </div>
    <div class="btn-group btn-group-sm" role="group" aria-label="Date range">
        @foreach (var key in new[] { "month", "30", "90", "all" })
        {
            <a class="@RangeBtn(key)" asp-action="MyMetrics" asp-route-range="@key">@RangeLabel(key)</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-2">@Model.OrdersAssigned</div>
            <div class="text-muted small">@Loc.T("Orders Assigned")</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-2 @(completionRate >= 90 ? "text-success" : completionRate >= 60 ? "text-warning" : "text-danger")">@completionRate%</div>
            <div class="text-muted small">@Loc.T("Completion Rate")</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-2 text-success">@Model.OrdersDone</div>
            <div class="text-muted small">@Loc.T("Done")</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-2 text-info">@Model.OrdersInProgress</div>
            <div class="text-muted small">@Loc.T("In Progress")</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-2 text-secondary">@Model.OrdersOpen</div>
            <div class="text-muted small">@Loc.T("Open")</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-2 text-danger">@Model.DefectsFound</div>
            <div class="text-muted small">@Loc.T("Defective")</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 fw-semibold">@Loc.T("Order breakdown")</div>
            @if (Model.OrdersDone + Model.OrdersInProgress + Model.OrdersOpen == 0)
            {
                <div class="card-body text-center text-muted py-5"><i class="bi bi-pie-chart fs-2 d-block mb-2"></i>@Loc.T("No orders in this period.")</div>
            }
            else
            {
                <div class="card-body"><div class="chart-wrap"><canvas id="orderChart"></canvas></div></div>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-0 fw-semibold"><i class="bi bi-list-task me-1"></i>@Loc.T("Inspection Orders") <span class="badge bg-light text-dark">@Model.Orders.Count</span></div>
    @if (Model.Orders.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc.T("Order #")</th><th>@Loc.T("Status")</th>
                        <th>@Loc.T("Checked")</th><th>@Loc.T("Due Date")</th><th>@Loc.T("Assigned Via")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="fw-semibold"><a asp-controller="InspectionOrders" asp-action="Details" asp-route-id="@o.OrderId">@o.OrderNumber</a></td>
                            <td><partial name="_StatusBadge" model="@o.Status" /></td>
                            <td>@o.CheckedAssets/@o.TotalAssets</td>
                            <td>@(o.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@Loc.T(o.AssignedContext)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-center text-muted py-5"><i class="bi bi-clipboard-x fs-2 d-block mb-2"></i>@Loc.T("No inspection orders in this period.")</div>
    }
</div>

@{
    var orderLabelsJson = System.Text.Json.JsonSerializer.Serialize(new[] {
        Loc.T("Done"), Loc.T("In Progress"), Loc.T("Open"),
    });
}
@section Scripts {
<script>
    const orderEl = document.getElementById('orderChart');
    if (orderEl) {
        new Chart(orderEl, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(orderLabelsJson),
                datasets: [{
                    data: [@Model.OrdersDone, @Model.OrdersInProgress, @Model.OrdersOpen],
                    backgroundColor: ['#34d399', '#38bdf8', '#fbbf24'],
                    borderWidth: 2
                }]
            },
            options: { maintainAspectRatio: false, plugins: { legend: { position: 'right' } }, cutout: '60%' }
        });
    }
</script>
}
