@model List<ApplicationUser>
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using ShiftFlow.Domain.Entities
@using ShiftFlow.Web.Authorization
@using ShiftFlow.Web.Services
@inject IAuthorizationService AuthZ
@using Microsoft.Extensions.Hosting
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = Loc.T("Users");
    var rolesByUser = (Dictionary<string, IList<string>>)ViewBag.RolesByUser;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var roleOptions = ViewBag.RoleOptions as List<string> ?? new List<string>();
    var roleNameArByName = ViewBag.RoleNameArByName as Dictionary<string, string?> ?? new Dictionary<string, string?>();
    string RoleLabel(string roleName) => RoleDisplay.Name(roleName, roleNameArByName.GetValueOrDefault(roleName), Loc.Lang);
    var canManageUsers = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.UserManage)).Succeeded;
    var canViewProfile = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.UserView)).Succeeded;
    // Re-running the seeder against a live production database is not a routine admin action:
    // keep the button to Development, where it is a convenience.
    var canSeedData = Env.IsDevelopment() && (await AuthZ.AuthorizeAsync(User, PermissionCatalog.IsAdmin)).Succeeded;
    var canManagePermissions = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.RbacManage)).Succeeded;
    // Asset-visibility scopes are edited under User.Manage, the same gate UserAssetScopesController uses.
    var canManageScopes = canManageUsers;

    var searchFilter = (string?)ViewBag.SearchFilter;
    var roleFilter = (string?)ViewBag.RoleFilter;
    var statusFilter = (string?)ViewBag.StatusFilter;
    var totalCount = (int)(ViewBag.TotalCount ?? Model.Count);
    var hasFilter = !string.IsNullOrWhiteSpace(searchFilter) || !string.IsNullOrWhiteSpace(roleFilter) || !string.IsNullOrWhiteSpace(statusFilter);
    var exportUrl = Url.Action("ExportExcel", new { role = roleFilter, search = searchFilter, status = statusFilter });
}
@{
    // Rendered as a Razor template (not ActionsHtml) so the "More" menu can carry the
    // anti-forgery token and the Development-only Seed Data form.
    Func<dynamic, Microsoft.AspNetCore.Html.IHtmlContent> headerActions = @<text>
        <a href="@exportUrl" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i>@Loc.T("Export Excel")
        </a>
        @if (canSeedData)
        {
            <div class="dropdown d-inline-block">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@Loc.T("More")</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <form method="post" asp-action="SeedData">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item"
                                    data-confirm="@Loc.T("This adds missing roles, permissions, and reference data. Safe to run again — nothing gets duplicated or overwritten. Continue?")">
                                <i class="bi bi-database-add me-2"></i>@Loc.T("Seed Data")
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        @if (canManageUsers)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>@Loc.T("New User")
            </a>
        }
    </text>;
}
<partial name="_PageHeader" model="@(new PageHeaderWithActions{ Title = Loc.T("Users"), Subtitle = Loc.T("All system accounts"), Actions = headerActions(null) })" />

<form method="get" class="filter-bar">
    <input type="search" name="search" value="@searchFilter" class="form-control form-control-sm"
           placeholder="@Loc.T("Search by name or email...")" style="max-width:240px" aria-label="@Loc.T("Search by name or email...")" />
    <select name="role" class="form-select form-select-sm" style="max-width:200px" aria-label="@Loc.T("Role")">
        <option value="">@Loc.T("All Roles")</option>
        @foreach (var r in roleOptions)
        {
            <option value="@r" selected="@(r == roleFilter)">@RoleLabel(r)</option>
        }
    </select>
    <select name="status" class="form-select form-select-sm" style="max-width:170px" aria-label="@Loc.T("Status")">
        <option value="">@Loc.T("All Statuses")</option>
        <option value="Active" selected="@(statusFilter == "Active")">@Loc.T("Active")</option>
        <option value="Inactive" selected="@(statusFilter == "Inactive")">@Loc.T("Inactive")</option>
    </select>
    <button type="submit" class="btn btn-outline-secondary btn-sm">@Loc.T("Filter")</button>
    @if (hasFilter)
    {
        <a href="@Url.Action("Index")" class="btn btn-link btn-sm">@Loc.T("Clear")</a>
    }
    <span class="filter-bar__count text-muted small">@totalCount @Loc.T("records")</span>
</form>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateModel{
        Icon = "bi-people",
        Title = hasFilter ? Loc.T("No users match these filters") : Loc.T("No users yet"),
        Text = hasFilter ? Loc.T("Try a different search term, role, or status.") : Loc.T("Add the first account to get started."),
        ActionUrl = hasFilter ? Url.Action("Index") : (canManageUsers ? Url.Action("Create") : null),
        ActionLabel = hasFilter ? Loc.T("Clear") : (canManageUsers ? Loc.T("New User") : null) })" />
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-card-stack">
                <thead>
                    <tr>
                        <th>@Loc.T("Name")</th>
                        <th>@Loc.T("Email")</th>
                        <th>@Loc.T("Role")</th>
                        <th>@Loc.T("Department")</th>
                        <th>@Loc.T("Status")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var isSelf = u.Id == currentUserId;
                        var isVendorAccount = rolesByUser[u.Id].Contains("Vendor");
                        var profileUrl = canViewProfile ? Url.Action("Profile", new { id = u.Id }) : null;
                        <tr class="@(profileUrl != null ? "row-link" : null)" data-href="@profileUrl">
                            <td data-label="@Loc.T("Name")">
                                @if (profileUrl != null)
                                {
                                    <a href="@profileUrl" class="fw-semibold">@u.FullName</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@u.FullName</span>
                                }
                            </td>
                            <td data-label="@Loc.T("Email")" class="small text-muted">@u.Email</td>
                            <td data-label="@Loc.T("Role")">
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var r in rolesByUser[u.Id])
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">@RoleLabel(r)</span>
                                    }
                                </div>
                            </td>
                            <td data-label="@Loc.T("Department")" data-hide-mobile>@u.Department</td>
                            <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@(u.IsActive ? "Active" : "Inactive")" /></td>
                            <td class="text-end pe-3">
                                <div class="dropdown row-actions">
                                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"
                                            aria-expanded="false" aria-label="@Loc.T("Actions")">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @if (canViewProfile)
                                        {
                                            <li><a class="dropdown-item" href="@Url.Action("Profile", new { id = u.Id })"><i class="bi bi-person-lines-fill me-2"></i>@Loc.T("Profile")</a></li>
                                        }
                                        @if (canManageUsers && !isVendorAccount)
                                        {
                                            <li><a class="dropdown-item" href="@Url.Action("Edit", new { id = u.Id })"><i class="bi bi-pencil me-2"></i>@Loc.T("Edit")</a></li>
                                        }
                                        @if (canManagePermissions)
                                        {
                                            <li><a class="dropdown-item" href="@Url.Action("UserPermissions", "Rbac", new { userId = u.Id })"><i class="bi bi-shield-lock me-2"></i>@Loc.T("Permissions")</a></li>
                                        }
                                        @if (canManageScopes)
                                        {
                                            <li><a class="dropdown-item" href="@Url.Action("Index", "UserAssetScopes")"><i class="bi bi-box-seam me-2"></i>@Loc.T("Asset scope")</a></li>
                                        }
                                        @if (canManageUsers && !isSelf)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form method="post" asp-action="ToggleActive" asp-route-id="@u.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item"
                                                            data-confirm="@(u.IsActive ? Loc.T("Deactivate {0}?", u.FullName) : Loc.T("Activate {0}?", u.FullName))">
                                                        <i class="bi @(u.IsActive ? "bi-person-dash" : "bi-person-check") me-2"></i>@(u.IsActive ? Loc.T("Deactivate") : Loc.T("Activate"))
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <form method="post" asp-action="Delete" asp-route-id="@u.Id">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger"
                                                            data-confirm="@Loc.T("Delete {0}? This cannot be undone.", u.FullName)">
                                                        <i class="bi bi-trash me-2"></i>@Loc.T("Delete")
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<partial name="_Pagination" model="@((PaginationModel)ViewBag.Pagination)" />
