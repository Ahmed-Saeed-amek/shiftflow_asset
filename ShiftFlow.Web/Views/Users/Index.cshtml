@model List<ApplicationUser>
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using ShiftFlow.Domain.Entities
@using ShiftFlow.Web.Authorization
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Users");
    var rolesByUser = (Dictionary<string, IList<string>>)ViewBag.RolesByUser;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var roleOptions = ViewBag.RoleOptions as List<string> ?? new List<string>();
    var roleNameArByName = ViewBag.RoleNameArByName as Dictionary<string, string?> ?? new Dictionary<string, string?>();
    string RoleLabel(string roleName) => Loc.LocalizedName(roleName, roleNameArByName.GetValueOrDefault(roleName));
    var canManageUsers = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.UserManage)).Succeeded;
    var canViewProfile = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.UserView)).Succeeded;
    var canSeedData = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.IsAdmin)).Succeeded;
    var canManagePermissions = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.RbacManage)).Succeeded;
    var exportUrl = Url.Action("ExportExcel", new { role = (string)ViewBag.RoleFilter, search = (string)ViewBag.SearchFilter });
    string actionsHtml = "<a href='" + exportUrl + "' class='btn btn-outline-success btn-sm me-2'><i class=\"bi bi-file-earmark-excel me-1\"></i>" + Loc.T("Excel") + "</a>"
        + (canManageUsers
            ? "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm me-2'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New User") + "</a>"
            : "");
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Users"),Subtitle=Loc.T("All system accounts"),ActionsHtml=actionsHtml})" />

@if (canSeedData)
{
    <div class="d-flex justify-content-end mb-3">
        <form method="post" asp-action="SeedData"
              onsubmit="return confirm('@Loc.T("This adds missing roles, permissions, and reference data. Safe to run again — nothing gets duplicated or overwritten. Continue?")')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-database-add me-1"></i>@Loc.T("Seed Data")
            </button>
        </form>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-sm-auto">
        <input type="text" name="search" value="@ViewBag.SearchFilter" class="form-control form-control-sm w-100"
               placeholder="@Loc.T("Search by name or email...")" style="min-width:220px" />
    </div>
    <div class="col-auto">
        <select name="role" class="form-select form-select-sm">
            <option value="">@Loc.T("All Roles")</option>
            @foreach (var r in roleOptions)
            {
                <option value="@r" selected="@(r == (string)ViewBag.RoleFilter)">@RoleLabel(r)</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-secondary">@Loc.T("Filter")</button></div>
    @if (!string.IsNullOrWhiteSpace((string)ViewBag.SearchFilter) || !string.IsNullOrWhiteSpace((string)ViewBag.RoleFilter))
    {
        <div class="col-auto"><a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">@Loc.T("Clear")</a></div>
    }
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Name")</th><th class="d-none d-md-table-cell">@Loc.T("Email")</th><th>@Loc.T("Role")</th><th class="d-none d-lg-table-cell">@Loc.T("Department")</th><th class="d-none d-sm-table-cell">@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var u in Model)
                {
                    var isSelf = u.Id == currentUserId;
                    var profileUrl = canViewProfile ? Url.Action("Profile", new { id = u.Id }) : null;
                    <tr class="@(canViewProfile ? "cursor-pointer" : "")" onclick="@(profileUrl != null ? $"location.href='{profileUrl}'" : null)">
                        <td>@u.FullName</td>
                        <td class="small text-muted d-none d-md-table-cell">@u.Email</td>
                        <td>@string.Join(", ", rolesByUser[u.Id].Select(RoleLabel))</td>
                        <td class="d-none d-lg-table-cell">@u.Department</td>
                        <td class="d-none d-sm-table-cell"><partial name="_StatusBadge" model="@(u.IsActive ? "Active" : "Inactive")" /></td>
                        <td class="text-end pe-3" onclick="event.stopPropagation()">
                            <div class="d-flex justify-content-end gap-1">
                                @if (canViewProfile)
                                {
                                    <a href="@Url.Action("Profile", new { id = u.Id })"
                                       class="btn btn-sm btn-outline-secondary" title="@Loc.T("View profile")">
                                        <i class="bi bi-person-lines-fill"></i>
                                    </a>
                                }
                                @if (canManageUsers && !rolesByUser[u.Id].Contains("Vendor"))
                                {
                                    <a href="@Url.Action("Edit", new { id = u.Id })"
                                       class="btn btn-sm btn-outline-secondary" title="@Loc.T("Edit")">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                @if (canManagePermissions)
                                {
                                    <a href="@Url.Action("UserPermissions","Rbac", new { userId = u.Id })"
                                       class="btn btn-sm btn-outline-primary" title="@Loc.T("Manage permissions")">
                                        <i class="bi bi-shield-lock"></i>
                                    </a>
                                }
                                @if (canManageUsers)
                                {
                                    @if (isSelf)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" disabled title="@Loc.T("Cannot delete your own account")">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="ToggleActive" asp-route-id="@u.Id"
                                              onsubmit="return confirm('@(u.IsActive ? Loc.T("Deactivate") : Loc.T("Activate")) @u.FullName?')">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(u.IsActive ? Loc.T("Deactivate user") : Loc.T("Activate user"))">
                                                <i class="bi @(u.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@u.Id"
                                              onsubmit="return confirm('@Loc.T("Delete") @u.FullName? @Loc.T("This cannot be undone")')">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" title="@Loc.T("Delete user")">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

