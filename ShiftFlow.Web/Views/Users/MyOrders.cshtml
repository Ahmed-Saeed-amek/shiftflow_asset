@model List<ShiftFlow.Web.ViewModels.MyWorkOrderRow>
@using Microsoft.AspNetCore.Html
@using ShiftFlow.Web.ViewModels
@{
    ViewData["Title"] = Loc.T("My Orders");
    bool showAll = ViewBag.ShowAll is true;
    var range = (ViewBag.SelectedRange as string) ?? "month";
    var category = ViewBag.Category as string;
    // "range" only narrows the history view; the open-work view deliberately ignores it (see
    // UsersController.MyOrders), which is why it is not counted as an active filter here.
    var anyFilter = showAll || !string.IsNullOrEmpty(category);

    Func<object?, IHtmlContent> headerActions = @<text>
        <a class="btn btn-sm btn-outline-secondary" asp-action="MyHistory"><i class="bi bi-clock-history me-1"></i>@Loc.T("History")</a>
    </text>;

    // Category colours match the Dashboard badges so a category reads the same everywhere.
    string CategoryBadgeClass(string c) => c switch
    {
        "Inspection" => "bg-primary-subtle text-primary-emphasis border-primary-subtle",
        "Maintenance" => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
        _ => "bg-info-subtle text-info-emphasis border-info-subtle",
    };
}
<partial name="_PageHeader" model="@(new PageHeaderWithActions{
    Title = Loc.T("My Orders"),
    Subtitle = Loc.T("Every inspection, maintenance, and work order assigned to you or your groups, in one place"),
    Actions = headerActions(null) })" />

@* The three header toggles (period / open-or-all / category) were three separate link groups that
   each had to carry the other two-s state in every link. One GET form does the same job. *@
<form method="get" class="filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
    <label for="myOrdersStatus" class="visually-hidden">@Loc.T("Status")</label>
    <select id="myOrdersStatus" name="showAll" class="form-select form-select-sm w-auto">
        <option value="false" selected="@(!showAll)">@Loc.T("Open")</option>
        <option value="true" selected="@showAll">@Loc.T("All")</option>
    </select>

    <label for="myOrdersRange" class="visually-hidden">@Loc.T("Period")</label>
    <select id="myOrdersRange" name="range" class="form-select form-select-sm w-auto">
        <option value="month" selected="@(range == "month")">@Loc.T("This month")</option>
        <option value="30" selected="@(range == "30")">@Loc.T("Last 30 days")</option>
        <option value="90" selected="@(range == "90")">@Loc.T("Last 90 days")</option>
        <option value="all" selected="@(range == "all")">@Loc.T("All time")</option>
    </select>

    <label for="myOrdersCategory" class="visually-hidden">@Loc.T("Category")</label>
    <select id="myOrdersCategory" name="category" class="form-select form-select-sm w-auto">
        <option value="">@Loc.T("All Categories")</option>
        <option value="Inspection" selected="@(category == "Inspection")">@Loc.T("Inspection")</option>
        <option value="Maintenance" selected="@(category == "Maintenance")">@Loc.T("Maintenance")</option>
        <option value="WorkOrder" selected="@(category == "WorkOrder")">@Loc.T("Work Order")</option>
    </select>

    <button type="submit" class="btn btn-outline-secondary btn-sm">@Loc.T("Filter")</button>
    @if (anyFilter)
    {
        <a class="btn btn-link btn-sm" href="@Url.Action("MyOrders")">@Loc.T("Clear")</a>
    }
    <span class="filter-bar__count text-muted small ms-auto">@Model.Count @Loc.T("records")</span>
</form>

<div class="card border-0 shadow-sm">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel{
            Icon = "bi-check2-circle",
            Title = showAll ? Loc.T("No orders assigned to you.") : Loc.T("No open orders — you're all caught up."),
            Text = showAll ? Loc.T("Try a wider period or a different category.") : Loc.T("Anything assigned to you or your groups shows up here.") })" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-card-stack">
                <thead class="table-light">
                    <tr>
                        <th>@Loc.T("Category")</th><th>@Loc.T("Order #")</th><th>@Loc.T("Asset")</th>
                        <th>@Loc.T("Status")</th><th>@Loc.T("Due Date")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr class="row-link" data-href="@Url.Action("Details", o.DetailsController, new { id = o.Id })">
                            <td data-label="@Loc.T("Category")"><span class="badge border @CategoryBadgeClass(o.Category)">@Loc.T(o.CategoryLabel)</span></td>
                            @* A real anchor as well as the row click — keyboard and new-tab users need one. *@
                            <td data-label="@Loc.T("Order #")"><a asp-action="Details" asp-controller="@o.DetailsController" asp-route-id="@o.Id" class="fw-semibold text-decoration-none">@o.OrderNumber</a></td>
                            <td class="small" data-label="@Loc.T("Asset")">@(o.AssetLabel ?? "—")</td>
                            <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@StatusDisplay.Label(o.Status)" /></td>
                            <td data-label="@Loc.T("Due Date")">@(o.DueDate.HasValue ? Loc.TDate(o.DueDate.Value.ToString("dd/MM/yyyy")) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
