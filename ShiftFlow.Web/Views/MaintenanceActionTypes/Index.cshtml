@model List<MaintenanceActionType>
@{
    ViewData["Title"] = Loc.T("Maintenance Action Types");
    var categories = (List<AssetCategory>)ViewBag.Categories;
    string actionsHtml = "<button type='button' class='btn btn-primary btn-sm' data-bs-toggle='modal' data-bs-target='#actionTypeModal' data-modal-create='actionTypeModal'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Maintenance Action") + "</button>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Maintenance Action Types"),Subtitle=Loc.T("Optionally scope an action to a category or subcategory — unscoped actions apply everywhere."),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-card-stack">
            <thead><tr><th>@Loc.T("Name")</th><th>@Loc.T("Category")</th><th>@Loc.T("Status")</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var m in Model)
                {
                    <tr>
                        <td data-label="@Loc.T("Name")" class="fw-semibold">@Loc.LocalizedName(m.Name, m.NameAr)</td>
                        <td data-label="@Loc.T("Category")">
                            @if (m.Category != null)
                            {
                                <span class="small">@Loc.LocalizedName(m.Category.Name, m.Category.NameAr)</span>
                            }
                            else
                            {
                                <span class="small text-muted">@Loc.T("All Categories")</span>
                            }
                        </td>
                        <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@(m.IsActive ? "Active" : "Inactive")" /></td>
                        <td class="text-end">
                            <div class="dropdown row-actions">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Loc.T("Actions")"><i class="bi bi-three-dots"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#actionTypeModal"
                                                data-modal-edit="actionTypeModal"
                                                data-id="@m.Id" data-name="@m.Name" data-name-ar="@m.NameAr"
                                                data-is-active="@(m.IsActive ? "true" : "false")" data-category-id="@m.CategoryId">
                                            <i class="bi bi-pencil me-2"></i>@Loc.T("Edit")
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="actionTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="actionTypeForm" asp-action="Create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="actionTypeId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title" id="actionTypeModalTitle">@Loc.T("New Maintenance Action")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="actionTypeModalError" class="alert alert-danger small" role="alert" hidden></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">@Loc.T("Name")</label>
                            <input name="Name" id="actionTypeName" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">@Loc.T("Name (Arabic)")</label>
                            <input name="NameAr" id="actionTypeNameAr" class="form-control" dir="rtl" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small d-block">@Loc.T("Applies to")</label>
                            <div class="btn-group btn-group-sm mb-2" role="group">
                                <input type="radio" class="btn-check" name="scopeMode" id="scopeAll" value="all" checked />
                                <label class="btn btn-outline-secondary" for="scopeAll">@Loc.T("All Categories")</label>
                                <input type="radio" class="btn-check" name="scopeMode" id="scopeSpecific" value="specific" />
                                <label class="btn btn-outline-secondary" for="scopeSpecific">@Loc.T("Specific Category")</label>
                            </div>
                            <div class="form-text mb-2">@Loc.T("Unscoped actions apply everywhere; a specific category (or subcategory) limits this action to just that one.")</div>
                            <select name="CategoryId" id="actionTypeCategoryId" class="form-select d-none">
                                <option value="" disabled>@Loc.T("— Select a category —")</option>
                                <partial name="_CategoryOptions" model="@(new CategoryOptionsModel{Categories=categories})" />
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="IsActive" id="actionTypeIsActive" class="form-check-input" value="true" checked />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label small" for="actionTypeIsActive">@Loc.T("Active")</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                    <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/modal-editor.js" asp-append-version="true"></script>
<script>
    const scopeAll = document.getElementById('scopeAll');
    const scopeSpecific = document.getElementById('scopeSpecific');
    const categorySelect = document.getElementById('actionTypeCategoryId');

    document.querySelectorAll('input[name=scopeMode]').forEach(r => r.addEventListener('change', () => {
        categorySelect.classList.toggle('d-none', scopeAll.checked);
        if (scopeAll.checked) categorySelect.value = '';
    }));

    // "All Categories" clears CategoryId before submit, regardless of what the (now-hidden) select
    // still holds from an earlier toggle — the toggle is the source of truth.
    document.getElementById('actionTypeForm').addEventListener('submit', () => {
        if (scopeAll.checked) categorySelect.value = '';
    });

    initModalEditor({
        modalId: 'actionTypeModal',
        formId: 'actionTypeForm',
        titleId: 'actionTypeModalTitle',
        errorId: 'actionTypeModalError',
        titles: { create: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("New Maintenance Action"))), edit: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Edit Maintenance Action"))) },
        urls: { create: '@Url.Action("Create")', edit: '@Url.Action("Edit")' },
        fieldMap: { id: 'actionTypeId', name: 'actionTypeName', nameAr: 'actionTypeNameAr', isActive: 'actionTypeIsActive', categoryId: 'actionTypeCategoryId' },
        defaults: { id: 0, name: '', nameAr: '', isActive: true, categoryId: '' },
        onApply: function () {
            var hasCategory = !!categorySelect.value;
            scopeSpecific.checked = hasCategory;
            scopeAll.checked = !hasCategory;
            categorySelect.classList.toggle('d-none', !hasCategory);
        },
        reopen: @Html.Raw(ShiftFlow.Web.Services.ModalRedisplay.ReopenScript(TempData))
    });
</script>
}
