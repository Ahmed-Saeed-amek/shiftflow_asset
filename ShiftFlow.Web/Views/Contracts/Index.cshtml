@using Microsoft.AspNetCore.Authorization
@model List<Contract>
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Contracts");
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.ContractManage)).Succeeded;
    string actionsHtml = canManage
        ? "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Contract") + "</a>"
        : "";
    var today = DateTime.UtcNow.Date;
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Contracts"),ActionsHtml=actionsHtml})" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Contract Number")</th><th class="d-none d-sm-table-cell">@Loc.T("Vendor")</th><th class="d-none d-lg-table-cell">@Loc.T("Contract Type")</th><th class="d-none d-xl-table-cell">@Loc.T("Assets")</th><th>@Loc.T("Status")</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var c in Model)
                {
                    var isActive = c.EndDate == null || c.EndDate >= today;
                    <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", new { id = c.Id })'">
                        <td class="small font-monospace">@c.ContractNumber</td>
                        <td class="d-none d-sm-table-cell">@c.Vendor?.Name</td>
                        <td class="d-none d-lg-table-cell"><partial name="_StatusBadge" model="@c.ContractType" /></td>
                        <td class="d-none d-xl-table-cell">@c.AssetLinks.Count</td>
                        <td><partial name="_StatusBadge" model="@(isActive ? "Active" : "Expired")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
