@using Microsoft.AspNetCore.Authorization
@model ContractIndexViewModel
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Contracts");
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.ContractManage)).Succeeded;
    var canView = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.ContractView)).Succeeded;
    string actionsHtml = "";
    if (canView)
        actionsHtml += "<a href='" + Url.Action("ExportExcel") + "' class='btn btn-outline-success btn-sm'><i class=\"bi bi-file-earmark-excel me-1\"></i>" + Loc.T("Excel") + "</a> "
                     + "<a href='" + Url.Action("ExportPdf") + "' class='btn btn-outline-danger btn-sm'><i class=\"bi bi-file-earmark-pdf me-1\"></i>" + Loc.T("PDF") + "</a> ";
    if (canManage)
        actionsHtml += "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Contract") + "</a>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Contracts"),ActionsHtml=actionsHtml})" />

<div class="text-muted small mb-2">@Model.TotalCount @Loc.T("records")</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Contract Number")</th><th class="d-none d-sm-table-cell">@Loc.T("Vendor")</th><th class="d-none d-lg-table-cell">@Loc.T("Contract Type")</th><th class="d-none d-xl-table-cell">@Loc.T("Assets")</th><th>@Loc.T("Status")</th><th class="text-end"></th></tr></thead>
            <tbody>
                @if (Model.Contracts.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var c in Model.Contracts)
                {
                    <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", new { id = c.Id })'">
                        <td class="small font-monospace"><a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none" onclick="event.stopPropagation()">@c.ContractNumber</a></td>
                        <td class="d-none d-sm-table-cell">@c.VendorName</td>
                        <td class="d-none d-lg-table-cell"><partial name="_StatusBadge" model="@c.ContractType" /></td>
                        <td class="d-none d-xl-table-cell">@c.AssetCount</td>
                        <td><partial name="_StatusBadge" model="@c.StatusLabel" /></td>
                        <td class="text-end"><i class="bi bi-chevron-right text-muted small"></i></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="Model.Pagination" />
