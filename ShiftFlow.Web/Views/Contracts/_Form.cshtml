@model ContractViewModel
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            @* Snapshot of the linked assets this form was loaded with (Edit only) — lets
               ContractService.UpdateAsync detect a concurrent edit instead of silently discarding
               it. Empty/absent on Create, where there's nothing to compare against yet. *@
            @foreach (var originalAssetId in Model.OriginalAssetIds ?? new List<int>())
            {
                <input type="hidden" name="OriginalAssetIds" value="@originalAssetId" />
            }
            @* "All" (not "ModelOnly") so a field-scoped ModelState error still shows up here even
               without a dedicated asp-validation-for span nearby — the NewAssets inline rows are
               built entirely in JS with no such spans, so a field-level error there (e.g. an
               implicit-required failure on a nullable DTO property) would otherwise render nowhere
               at all: no summary text, no field span, just a silently-reset form (confirmed live). *@
            <div asp-validation-summary="All" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Vendor")</label>
                    <select asp-for="VendorId" class="form-select">
                        <option value="0">@Loc.T("Select vendor…")</option>
                        @foreach (var v in (List<Vendor>)ViewBag.Vendors)
                        {
                            <option value="@v.Id">@v.Name</option>
                        }
                    </select>
                    <span asp-validation-for="VendorId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Contract Type")</label>
                    <select asp-for="ContractType" class="form-select">
                        @foreach (var t in Contract.ContractTypes)
                        {
                            <option value="@t">@Loc.T(t)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("Contract Number")</label>
                    <input asp-for="ContractNumber" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("Start Date")</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("End Date")</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">@Loc.T("Cost")</label>
                    <input asp-for="Cost" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4" id="pmCadenceWrap" style="display:none">
                    <label class="form-label small">@Loc.T("Cadence")</label>
                    <select asp-for="PmCadence" class="form-select">
                        <option value="">@Loc.T("Select cadence…")</option>
                        @foreach (var c in Contract.PmCadences)
                        {
                            <option value="@c">@Loc.T(c)</option>
                        }
                    </select>
                    <span asp-validation-for="PmCadence" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label small">@Loc.T("Notes")</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label small">@Loc.T("Linked Assets")</label>
                    <partial name="_AssetMultiPicker" model="@(new AssetMultiPickerModel{Name="AssetIds",Selected=(List<AssetChip>)ViewBag.SelectedAssetChips,Placeholder=Loc.T("Search by asset tag or name…"),Categories=(List<AssetCategory>)ViewBag.Categories})" />
                </div>
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label small mb-0">@Loc.T("Create New Assets") <span id="newAssetCount" class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill ms-1" hidden>0</span></label>
                        <button type="button" id="addNewAssetBtn" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>@Loc.T("Add Asset")</button>
                    </div>
                    <div class="form-text mb-2"><i class="bi bi-info-circle me-1"></i>@Loc.T("New assets are only created if this contract is saved successfully.")</div>
                    <div id="newAssetRows"></div>
                    <template id="newAssetRowTemplate">
                        <div class="border rounded p-2 mb-2 new-asset-row position-relative">
                            <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-1" data-na-remove aria-label="@Loc.T("Remove")"><i class="bi bi-x-lg"></i></button>
                            <div class="row g-2">
                                <div class="col-md-3"><input type="text" class="form-control form-control-sm" placeholder="@Loc.T("Asset Tag")" data-name="AssetTag" /></div>
                                <div class="col-md-4"><input type="text" class="form-control form-control-sm" placeholder="@Loc.T("Name")" data-name="Name" /></div>
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm" data-name="Status">
                                        @foreach (var s in Asset.Statuses)
                                        {
                                            <option value="@s" selected="@(s == "Working")">@Loc.T(s)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-md-2">
                                    <select class="form-select form-select-sm" data-na-cat-parent>
                                        <option value="">@Loc.T("Category")…</option>
                                        @foreach (var c in (List<AssetCategory>)ViewBag.Categories)
                                        {
                                            <option value="@c.Id">@Loc.LocalizedName(c.Name, c.NameAr)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <select class="form-select form-select-sm" data-na-cat-sub disabled>
                                        <option value="">@Loc.T("None")</option>
                                    </select>
                                    <input type="hidden" data-name="CategoryId" />
                                </div>
                                <div class="col-md-3">
                                    <select class="form-select form-select-sm" data-name="ZoneId">
                                        <option value="">@Loc.T("Zone")…</option>
                                        @foreach (var z in (List<Zone>)ViewBag.NewAssetZoneOptions)
                                        {
                                            <option value="@z.Id">@z.Name (@z.LocationCategory?.Name)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2"><input type="text" class="form-control form-control-sm" placeholder="@Loc.T("Model")" data-name="Model" /></div>
                                <div class="col-md-3"><input type="text" class="form-control form-control-sm" placeholder="@Loc.T("Serial Number")" data-name="SerialNumber" /></div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>
<script>
    (function () {
        var typeSelect = document.getElementById('ContractType');
        var cadenceWrap = document.getElementById('pmCadenceWrap');
        var endDateInput = document.getElementById('EndDate');
        function togglePm() {
            var isPm = typeSelect.value === 'Preventive Maintenance';
            cadenceWrap.style.display = isPm ? '' : 'none';
            endDateInput.required = isPm;
        }
        typeSelect.addEventListener('change', togglePm);
        togglePm();
    })();

    // Inline "create new assets" row picker — rows are cloned from the <template> and their
    // inputs renamed to NewAssets[i].* on every add/remove so indices stay contiguous from 0
    // (ASP.NET Core's collection model binder stops at the first missing index, so a gap left
    // behind by removing a middle row would silently drop every row after it).
    (function () {
        var container = document.getElementById('newAssetRows');
        var template = document.getElementById('newAssetRowTemplate');
        var addBtn = document.getElementById('addNewAssetBtn');
        var countBadge = document.getElementById('newAssetCount');
        var noneLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("None")));
        var isRTL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.IsRTL));

        function renumber() {
            Array.prototype.forEach.call(container.children, function (row, i) {
                row.querySelectorAll('[data-name]').forEach(function (el) {
                    el.name = 'NewAssets[' + i + '].' + el.dataset.name;
                });
            });
            var count = container.children.length;
            countBadge.textContent = count;
            countBadge.hidden = count === 0;
        }
        function addRow() {
            var node = template.content.firstElementChild.cloneNode(true);
            node.querySelector('[data-na-remove]').addEventListener('click', function () {
                node.remove();
                renumber();
            });
            container.appendChild(node);
            renumber();
        }
        addBtn.addEventListener('click', addRow);

        // Category -> Subcategory cascade per row (subcategory optional — the hidden CategoryId
        // input falls back to the parent when none is chosen). A single flat select mixing every
        // category and subcategory together was unusably long as a native mobile dropdown, so this
        // mirrors the two-level picker the main Asset form already uses, loading each row's
        // subcategories on demand from the same /AssetCategories/ByParent endpoint.
        container.addEventListener('change', function (e) {
            var row = e.target.closest('.new-asset-row');
            if (!row) return;
            var hidden = row.querySelector('[data-name="CategoryId"]');
            if (e.target.matches('[data-na-cat-parent]')) {
                var subSel = row.querySelector('[data-na-cat-sub]');
                var parentId = e.target.value;
                hidden.value = parentId;
                subSel.innerHTML = '<option value="">' + noneLabel + '</option>';
                subSel.disabled = true;
                if (!parentId) return;
                fetch('/AssetCategories/ByParent?parentId=' + parentId, { headers: { Accept: 'application/json' } })
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (subs) {
                        subs.forEach(function (s) {
                            var opt = document.createElement('option');
                            opt.value = s.id;
                            opt.textContent = (isRTL && s.nameAr) ? s.nameAr : s.name;
                            subSel.appendChild(opt);
                        });
                        subSel.disabled = subs.length === 0;
                    });
            } else if (e.target.matches('[data-na-cat-sub]')) {
                var parentSel = row.querySelector('[data-na-cat-parent]');
                hidden.value = e.target.value || parentSel.value;
            }
        });
    })();
</script>
