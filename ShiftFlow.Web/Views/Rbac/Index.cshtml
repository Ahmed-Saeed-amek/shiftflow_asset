@model List<ApplicationUser>
@using ShiftFlow.Web.Services
@{
    ViewData["Title"] = Loc.T("Permissions Management");
    var roles        = (List<ApplicationRole>)ViewBag.Roles;
    var rolesByUser  = (Dictionary<string, IList<string>>)ViewBag.RolesByUser;
    var roleNames    = roles.Select(r => r.Name!).OrderBy(n => n).ToList();
    // Only the roles this caller may actually grant/revoke - RbacController.BulkAssignRoles
    // enforces the same rule server-side.
    var assignableRoleNames = ViewBag.AssignableRoleNames as List<string> ?? roleNames;
    var searchFilter = (string?)ViewBag.SearchFilter;
    var roleFilter   = (string?)ViewBag.RoleFilter;
    var totalCount   = (int)(ViewBag.TotalCount ?? 0);
    var roleNameArByName = roles.ToDictionary(r => r.Name!, r => r.NameAr);
    string RoleLabel(string roleName) => RoleDisplay.Name(roleName, roleNameArByName.GetValueOrDefault(roleName), Loc.Lang);
    var selectAtLeastOneUserJson = System.Text.Json.JsonSerializer.Serialize(Loc.T("Select at least one user."));
    var pickAtLeastOneRoleJson   = System.Text.Json.JsonSerializer.Serialize(Loc.T("Pick at least one role to add or remove."));
}

<partial name="_PageHeader" model="@(new PageHeaderModel{
    Title    = Loc.T("Permissions Management"),
    Subtitle = Loc.T("Manage roles and user-level permissions")
})" />


<div class="row g-4">

    <!-- ═══════════════════════════════════════════════════
         LEFT: Roles panel
    ════════════════════════════════════════════════════ -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2 py-3">
                <i class="bi bi-shield-lock text-primary fs-5"></i>
                <span class="fw-semibold">@Loc.T("Roles")</span>
                <span class="badge bg-primary ms-auto">@roles.Count</span>
            </div>

            <!-- Add role -->
            <div class="px-3 py-2 border-bottom bg-light">
                <form method="post" asp-action="CreateRole" class="d-flex flex-column gap-2">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <input name="roleName" class="form-control form-control-sm"
                               placeholder="@Loc.T("New role name…")" maxlength="50" required />
                        <button class="btn btn-sm btn-primary text-nowrap">
                            <i class="bi bi-plus-lg me-1"></i>@Loc.T("Add")
                        </button>
                    </div>
                    <input name="roleNameAr" class="form-control form-control-sm" dir="rtl"
                           placeholder="@Loc.T("Arabic name (optional)")" maxlength="100" />
                </form>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var role in roles)
                {
                    var memberCount = rolesByUser.Values.Count(r => r.Contains(role.Name!));
                    <div class="list-group-item d-flex align-items-center gap-2 py-2 px-3">
                        <a href="@Url.Action("RolePermissions","Rbac",new{roleId=role.Id})"
                           class="d-flex align-items-center gap-2 flex-grow-1 text-decoration-none text-body overflow-hidden">
                            <span class="badge rounded-circle bg-primary-subtle text-primary p-2 flex-shrink-0">
                                <i class="bi bi-shield-fill"></i>
                            </span>
                            <div class="overflow-hidden">
                                <div class="fw-semibold text-truncate">@RoleLabel(role.Name!)</div>
                                <div class="small text-muted">@memberCount @Loc.T("user(s)")</div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small ms-auto"></i>
                        </a>
                        <form method="post" asp-action="DeleteRole" class="flex-shrink-0"
                              onsubmit="return confirm('@Loc.T("Delete role '{0}'?", RoleLabel(role.Name!))')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="roleId" value="@role.Id" />
                            <button class="btn btn-sm btn-outline-danger py-1 px-2"
                                    title="@(memberCount > 0 ? Loc.T("Remove all users first") : Loc.T("Delete role"))"
                                    @(memberCount > 0 ? "disabled" : "")>
                                <i class="bi bi-trash3"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
        <p class="text-muted small mt-2 px-1">
            <i class="bi bi-info-circle me-1"></i>@Loc.T("Delete is disabled while users are in the role.")
        </p>
    </div>

    <!-- ═══════════════════════════════════════════════════
         RIGHT: Users panel with bulk selection
    ════════════════════════════════════════════════════ -->
    <div class="col-lg-8">

        <!-- Bulk action bar (hidden until ≥1 user checked) -->
        <div id="bulkBar" class="card border-0 shadow-sm mb-3 d-none">
            <div class="card-body py-2 px-3 bg-primary-subtle border border-primary-subtle rounded">
                <form method="post" asp-action="BulkAssignRoles" id="bulkForm">
                    @Html.AntiForgeryToken()
                    <!-- selected user ids injected by JS -->
                    <div id="bulkUserInputs"></div>

                    <div class="d-flex flex-wrap align-items-end gap-3">
                        <div class="fw-semibold text-primary">
                            <i class="bi bi-people-fill me-1"></i>
                            <span id="selCount">0</span> @Loc.T("user(s) selected")
                        </div>

                        <!-- ADD roles -->
                        <div>
                            <label class="form-label small mb-1 fw-semibold text-success">@Loc.T("Add roles")</label>
                            <div class="d-flex flex-wrap gap-2" id="addRoleChecks">
                                @foreach (var rn in assignableRoleNames)
                                {
                                    <div class="form-check form-check-inline mb-0">
                                        <input class="form-check-input border-success" type="checkbox"
                                               name="addRoles" value="@rn" id="add-@rn" />
                                        <label class="form-check-label small" for="add-@rn">@RoleLabel(rn)</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- REMOVE roles -->
                        <div>
                            <label class="form-label small mb-1 fw-semibold text-danger">@Loc.T("Remove roles")</label>
                            <div class="d-flex flex-wrap gap-2" id="removeRoleChecks">
                                @foreach (var rn in assignableRoleNames)
                                {
                                    <div class="form-check form-check-inline mb-0">
                                        <input class="form-check-input border-danger" type="checkbox"
                                               name="removeRoles" value="@rn" id="rem-@rn" />
                                        <label class="form-check-label small" for="rem-@rn">@RoleLabel(rn)</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-sm btn-primary px-3 ms-auto"
                                onclick="return injectUserIds()">
                            <i class="bi bi-arrow-repeat me-1"></i>@Loc.T("Apply to selected")
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Filters (submitted to the server - the list is paged, so filtering only the rows
             currently rendered would silently miss matches) -->
        <form method="get" class="filter-bar">
            <input name="search" type="search" value="@searchFilter" class="form-control form-control-sm"
                   placeholder="@Loc.T("Search by name or email…")" style="max-width:240px" aria-label="@Loc.T("Search by name or email…")" />
            <select name="role" class="form-select form-select-sm" style="max-width:200px" aria-label="@Loc.T("Role")">
                <option value="">@Loc.T("All roles")</option>
                @foreach (var rn in roleNames)
                {
                    <option value="@rn" selected="@(rn == roleFilter)">@RoleLabel(rn)</option>
                }
                <option value="__none__" selected="@(roleFilter == "__none__")">@Loc.T("No role assigned")</option>
            </select>
            <button type="submit" class="btn btn-outline-secondary btn-sm">@Loc.T("Filter")</button>
            @if (!string.IsNullOrWhiteSpace(searchFilter) || !string.IsNullOrWhiteSpace(roleFilter))
            {
                <a href="@Url.Action("Index")" class="btn btn-link btn-sm">@Loc.T("Clear")</a>
            }
            <span class="filter-bar__count text-muted small">@totalCount @Loc.T("records")</span>
        </form>

        <!-- Users table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-bottom py-2 px-3">
                <!-- row 1: title + select-all -->
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-people text-success fs-5"></i>
                    <span class="fw-semibold">@Loc.T("Users")</span>
                    <span class="badge bg-success" id="visibleCount">@totalCount</span>
                    <div class="form-check mb-0 ms-auto" title="@Loc.T("Select all visible")">
                        <input class="form-check-input" type="checkbox" id="checkAll" />
                        <label class="form-check-label small text-muted" for="checkAll">@Loc.T("Select all")</label>
                    </div>
                </div>
            </div>

            <div style="max-height:620px;overflow-y:auto" class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <tbody>
                    @foreach (var user in Model)
                    {
                        var userRoles = rolesByUser[user.Id];
                        <tr class="user-row">
                            <!-- Checkbox -->
                            <td class="ps-3" style="width:40px">
                                <input class="form-check-input user-check" type="checkbox"
                                       value="@user.Id" />
                            </td>

                            <!-- Avatar + name -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-secondary-subtle d-flex align-items-center
                                                justify-content-center flex-shrink-0"
                                         style="width:36px;height:36px">
                                        <span class="fw-bold text-secondary small">@user.FullName[0]</span>
                                    </div>
                                    <div>
                                        <div class="fw-semibold small">@user.FullName</div>
                                        <div class="text-muted" style="font-size:.75rem">@user.Email</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Roles badges -->
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var r in userRoles)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">@RoleLabel(r)</span>
                                    }
                                    @if (!userRoles.Any())
                                    {
                                        <span class="text-muted small">@Loc.T("No roles")</span>
                                    }
                                </div>
                            </td>

                            <!-- Per-user permissions link -->
                            <td class="text-end pe-3">
                                <a href="@Url.Action("UserPermissions","Rbac",new{userId=user.Id})"
                                   class="btn btn-sm btn-outline-secondary py-1 px-2 text-nowrap"
                                   title="@Loc.T("Edit permission overrides")" aria-label="@Loc.T("Permissions")">
                                    <i class="bi bi-shield-lock"></i><span class="d-none d-sm-inline ms-1">@Loc.T("Permissions")</span>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No users found.")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pagination" model="@((PaginationModel)ViewBag.Pagination)" />
    </div>
</div>

<script>
(function () {
    const checkAll      = document.getElementById('checkAll');
    const bulkBar       = document.getElementById('bulkBar');
    const selCount      = document.getElementById('selCount');
    const userInputsDiv = document.getElementById('bulkUserInputs');
    const allRows       = [...document.querySelectorAll('.user-row')];

    // Filtering and paging happen on the server now - every rendered row is "visible".
    function visibleChecks() {
        return allRows.map(r => r.querySelector('.user-check'));
    }

    function getChecked() {
        return visibleChecks().filter(cb => cb.checked);
    }

    function refreshBulk() {
        const checked = getChecked();
        selCount.textContent = checked.length;
        bulkBar.classList.toggle('d-none', checked.length === 0);
        const vis = visibleChecks();
        checkAll.checked        = vis.length > 0 && checked.length === vis.length;
        checkAll.indeterminate  = checked.length > 0 && checked.length < vis.length;
    }

    checkAll.addEventListener('change', () => {
        visibleChecks().forEach(cb => cb.checked = checkAll.checked);
        refreshBulk();
    });

    document.querySelectorAll('.user-check').forEach(cb =>
        cb.addEventListener('change', refreshBulk));

    // ── Add / Remove mutual exclusion ──────────────────────────────
    document.querySelectorAll('[name=addRoles]').forEach(cb =>
        cb.addEventListener('change', () => {
            if (cb.checked) {
                const m = document.getElementById('rem-' + cb.value);
                if (m) m.checked = false;
            }
        }));
    document.querySelectorAll('[name=removeRoles]').forEach(cb =>
        cb.addEventListener('change', () => {
            if (cb.checked) {
                const m = document.getElementById('add-' + cb.value);
                if (m) m.checked = false;
            }
        }));

    // ── Submit ─────────────────────────────────────────────────────
    window.injectUserIds = function () {
        userInputsDiv.innerHTML = '';
        const checked = getChecked();
        if (checked.length === 0) { alert(@Html.Raw(selectAtLeastOneUserJson)); return false; }

        const add = [...document.querySelectorAll('[name=addRoles]:checked')];
        const rem = [...document.querySelectorAll('[name=removeRoles]:checked')];
        if (add.length === 0 && rem.length === 0) {
            alert(@Html.Raw(pickAtLeastOneRoleJson)); return false;
        }

        checked.forEach(cb => {
            const inp = document.createElement('input');
            inp.type = 'hidden'; inp.name = 'userIds'; inp.value = cb.value;
            userInputsDiv.appendChild(inp);
        });
        return true;
    };
})();
</script>
