@{
    int? statusCode = ViewBag.StatusCode as int?;
    Layout = null;
    var isRTL = Loc.IsRTL;
    string title = statusCode switch
    {
        404 => Loc.T("Page not found"),
        403 => Loc.T("Access denied"),
        405 => Loc.T("Action not available this way"),
        _ => Loc.T("Something went wrong"),
    };
    string message = statusCode switch
    {
        404 => Loc.T("The page you're looking for doesn't exist or may have been moved."),
        403 => Loc.T("You don't have permission to view this page."),
        // A bookmarked/typed link to a POST-only action (e.g. /Account/Logout) hits this via a
        // plain GET — that's a routine navigation mistake, not a server error, so it shouldn't
        // read like one.
        405 => Loc.T("That action can't be reached by visiting its link directly. Please use the button in the app instead."),
        _ => Loc.T("An unexpected error occurred. Please try again, and contact support if the problem continues."),
    };
    string icon = statusCode switch
    {
        404 => "bi-signpost-split",
        403 => "bi-shield-lock",
        405 => "bi-signpost-2",
        _ => "bi-exclamation-triangle",
    };
    ViewData["Title"] = title;
}
<!DOCTYPE html>
<html lang="@Loc.Lang" dir="@(isRTL ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title - STEP</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true" />
    <partial name="_HeadLinks" />
</head>
<body>
    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="text-center" style="max-width:32rem">
            <i class="bi @icon text-warning" style="font-size:5rem" aria-hidden="true"></i>
            <h1 class="fs-4 fw-bold font-heading mt-3">@title</h1>
            <p class="text-muted">@message</p>
            <a href="/" class="btn btn-primary">@Loc.T("Go to Home")</a>
        </div>
    </main>
</body>
</html>
