@{
    int? statusCode = ViewBag.StatusCode as int?;
    Layout = null;
    string title = statusCode switch
    {
        404 => "Page not found",
        403 => "Access denied",
        _ => "Something went wrong",
    };
    string message = statusCode switch
    {
        404 => "The page you're looking for doesn't exist or may have been moved.",
        403 => "You don't have permission to view this page.",
        _ => "An unexpected error occurred. Please try again, and contact support if the problem continues.",
    };
    string icon = statusCode switch
    {
        404 => "bi-signpost-split",
        403 => "bi-shield-lock",
        _ => "bi-exclamation-triangle",
    };
    ViewData["Title"] = title;
}
<!DOCTYPE html><html><head><meta charset="utf-8"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/></head><body class="bg-light"><div class="min-vh-100 d-flex align-items-center justify-content-center"><div class="text-center"><i class="bi @icon text-warning" style="font-size:5rem"></i><h3 class="fw-bold mt-3">@title</h3><p class="text-muted">@message</p><a href="/" class="btn btn-primary">Go to Home</a></div></div></body></html>
