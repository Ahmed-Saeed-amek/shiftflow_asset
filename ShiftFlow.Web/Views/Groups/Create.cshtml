@model ShiftFlow.Web.ViewModels.GroupCreateVm
@using ShiftFlow.Web.ViewModels
@{
    ViewData["Title"] = Loc.T("New Group");
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("New Group"),Subtitle=Loc.T("Create a reusable group of employees")})" />

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@Loc.T("Name") <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Loc.T("Arabic Name")</label>
                    <input asp-for="NameAr" class="form-control" dir="rtl" />
                </div>
                <div class="col-12">
                    <label class="form-label">@Loc.T("Description")</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <partial name="_MemberPicker" model="@(new MemberPickerModel { RootId = "memberPicker", FieldName = "MemberUserIds", Selected = new List<GroupMemberChip>() })" />
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary" id="submitBtn"><i class="bi bi-check-lg me-1"></i>@Loc.T("Create Group")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/group-member-picker.js" asp-append-version="true"></script>
<script>
    initGroupMemberPicker({
        rootId: 'memberPicker',
        fieldName: 'MemberUserIds',
        searchUrl: '/api/users/search',
        initial: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new List<GroupMemberChip>().Select(m => new { id = m.UserId, label = m.Label }))),
        labels: {
            remove: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Remove"))),
            searchFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Couldn't load employees. Check your connection and try again.")))
        }
    });
</script>
}
