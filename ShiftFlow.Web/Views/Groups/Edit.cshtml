@model ShiftFlow.Web.ViewModels.GroupEditVm
@{
    ViewData["Title"] = Loc.T("Edit Group");
    var currentMembers = (List<GroupMemberChip>)ViewBag.CurrentMembers;
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Edit Group")})" />

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            }
            <input type="hidden" asp-for="Id" />
            @* Snapshot of the membership this form was loaded with — lets SetMembersAsync detect a
               concurrent edit (someone else changed membership since this page loaded) instead of
               silently overwriting it. Must survive a validation-error redisplay unchanged, so it's
               bound straight from the model rather than rebuilt from ViewBag.CurrentMembers. *@
            @foreach (var originalId in Model.OriginalMemberUserIds)
            {
                <input type="hidden" name="OriginalMemberUserIds" value="@originalId" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@Loc.T("Name") <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Loc.T("Arabic Name")</label>
                    <input asp-for="NameAr" class="form-control" dir="rtl" />
                </div>
                <div class="col-12">
                    <label class="form-label">@Loc.T("Description")</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">@Loc.T("Active")</label>
                    </div>
                </div>
                <partial name="_MemberPicker" model="@(new MemberPickerModel { RootId = "memberPicker", FieldName = "MemberUserIds", Selected = currentMembers })" />
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@Loc.T("Save")</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/group-member-picker.js" asp-append-version="true"></script>
<script>
    initGroupMemberPicker({
        rootId: 'memberPicker',
        fieldName: 'MemberUserIds',
        searchUrl: '/api/users/search',
        initial: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentMembers.Select(m => new { id = m.UserId, label = m.Label }))),
        labels: {
            remove: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Remove"))),
            searchFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Couldn't load employees. Check your connection and try again.")))
        }
    });
</script>
}
