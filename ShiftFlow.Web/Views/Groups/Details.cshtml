@model ShiftFlow.Domain.Entities.Group
@using Microsoft.AspNetCore.Authorization
@using ShiftFlow.Web.Authorization
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Model.Name;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.GroupManage)).Succeeded;
    var canViewProfiles = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.UserView)).Succeeded;
    var groupLabel = Loc.LocalizedName(Model.Name, Model.NameAr);
    string actionsHtml = canManage
        ? "<a href='" + Url.Action("Edit", new { id = Model.Id }) + "' class='btn btn-primary btn-sm'><i class=\"bi bi-pencil me-1\"></i>" + Loc.T("Edit") + "</a>"
        : "";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{
    Title = groupLabel,
    Subtitle = Model.Description,
    ActionsHtml = actionsHtml,
    Breadcrumbs = new List<(string Label, string? Url)>{ (Loc.T("Groups"), Url.Action("Index")), (groupLabel, null) } })" />

<div class="d-flex align-items-center gap-2 mb-3">
    <partial name="_StatusBadge" model="@(Model.IsActive ? "Active" : "Inactive")" />
    <span class="text-muted small">@Loc.T("Created") @Loc.TDate(Model.CreatedAt.ToString("dd/MM/yyyy"))</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-bottom py-2 px-3 fw-semibold">@Loc.T("Members") (@Model.Members.Count)</div>
    <div class="list-group list-group-flush">
        @if (Model.Members.Count == 0)
        {
            <div class="list-group-item text-muted small text-center py-3">@Loc.T("No members yet.")</div>
        }
        @foreach (var m in Model.Members.OrderBy(m => m.User.FullName))
        {
            <div class="list-group-item">
                @if (canViewProfiles)
                {
                    <a asp-controller="Users" asp-action="Profile" asp-route-id="@m.UserId" class="fw-semibold small text-decoration-none">@m.User.FullName</a>
                }
                else
                {
                    <div class="fw-semibold small">@m.User.FullName</div>
                }
                <div class="text-muted" style="font-size:.75rem">@m.User.Email</div>
            </div>
        }
    </div>
</div>
