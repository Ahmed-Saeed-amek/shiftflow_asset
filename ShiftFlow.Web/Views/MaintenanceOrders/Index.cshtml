@using Microsoft.AspNetCore.Authorization
@model List<ShiftFlow.Domain.Entities.MaintenanceOrder>
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Maintenance Orders");
    var status = (string?)ViewBag.Status;
    var search = (string?)ViewBag.Search;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.MaintenanceOrderManage)).Succeeded;
    var canExport = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.MaintenanceOrderExport)).Succeeded;
    string actionsHtml = "";
    if (canExport)
        actionsHtml += "<a href='" + Url.Action("ExportExcel") + "' class='btn btn-outline-success btn-sm me-2'><i class=\"bi bi-file-earmark-excel me-1\"></i>" + Loc.T("Excel") + "</a>";
    if (canManage)
        actionsHtml += "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Maintenance Order") + "</a>";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Maintenance Orders"),Subtitle=Loc.T("In-house fixes assigned directly to employees — no vendor involved"),ActionsHtml=actionsHtml})" />

<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-auto">
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">@Loc.T("Status")</option>
            @foreach (var s in MaintenanceOrder.Statuses)
            {
                <option value="@s" selected="@(status==s)">@Loc.T(s)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="@Loc.T("Search by order # or asset tag...")" style="min-width:220px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-secondary">@Loc.T("Filter")</button>
    </div>
    <div class="col-auto ms-auto text-muted small">@Model.Count @Loc.T("records")</div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Order #")</th><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Assigned Employee")</th><th>@Loc.T("Status")</th><th>@Loc.T("Created")</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var m in Model)
                {
                    <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", new { id = m.Id })'">
                        <td class="small font-monospace">@m.OrderNumber</td>
                        <td class="small">@m.Asset?.AssetTag</td>
                        <td class="small">@m.AssignedToUser?.FullName</td>
                        <td><partial name="_StatusBadge" model="@m.Status" /></td>
                        <td class="small">@m.CreatedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
