@using Microsoft.AspNetCore.Authorization
@using ShiftFlow.Web.Authorization
@inject IAuthorizationService AuthZ
@model MaintenanceOrder
@{
    ViewData["Title"] = Model.OrderNumber;
    var isManager = (bool)ViewBag.IsManager;
    // MaintenanceOrdersController.Index was removed when Create/Index moved to the unified
    // OrdersController — this "Back" link used to 404 by pointing at the now-gone local Index.
    var canViewOrderList = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.MaintenanceOrderView)).Succeeded;
    var isAssignee = (bool)ViewBag.IsAssignee;
    var isOpen = Model.Status == "Open";
    // PendingApproval is cancellable too now, matching inspection orders.
    var canCancel = Model.Status is "Open" or "PendingApproval";
    var canReportFix = isOpen && isAssignee;
    var hasSpecs = Model.Asset != null && (!string.IsNullOrWhiteSpace(Model.Asset.Manufacturer) || !string.IsNullOrWhiteSpace(Model.Asset.Model) || !string.IsNullOrWhiteSpace(Model.Asset.SerialNumber) || !string.IsNullOrWhiteSpace(Model.Asset.Sku));
}

@* Breadcrumb instead of the Back button: Orders is the combined list this order lives on, and
   a crumb trail still makes sense when the page was reached from a link or search. *@
<nav aria-label="@Loc.T("Breadcrumb")" class="mb-2">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item">
            @if (canViewOrderList)
            {
                <a asp-controller="Orders" asp-action="Index" class="text-decoration-none">@Loc.T("Orders")</a>
            }
            else
            {
                <a asp-controller="Users" asp-action="MyOrders" class="text-decoration-none">@Loc.T("My Orders")</a>
            }
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.OrderNumber</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-3">
    <div>
        <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
            <h1 class="fs-3 fw-bold font-heading mb-0">@Model.OrderNumber</h1>
            <partial name="_StatusBadge" model="@StatusDisplay.Label(Model.Status)" />
        </div>
        <div class="text-muted small d-flex align-items-center flex-wrap column-gap-3 row-gap-1">
            @if (Model.Asset?.Zone is { } zone)
            {
                <span><i class="bi bi-geo-alt me-1"></i>@Loc.LocalizedName(zone.Name, zone.NameAr)</span>
            }
            <span><i class="bi bi-calendar3 me-1"></i>@Loc.TDate(Model.CreatedDate.ToString("dd/MM/yyyy"))</span>
        </div>
    </div>
    @* Approve/Report Fix stay in their own cards below — both are forms, not links, so the header
       carries no primary button; the rare and destructive ones live behind More. *@
    <div class="d-flex flex-wrap gap-2 align-self-start align-self-lg-auto flex-shrink-0">
        @if (Model.Asset != null)
        {
            <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-hdd-stack me-1"></i>@Model.Asset.AssetTag
            </a>
        }
        @if (Model.Status is "Open" or "PendingApproval" && isManager)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#reassignPanel" aria-controls="reassignPanel">
                <i class="bi bi-person-gear me-1"></i>@Loc.T("Reassign")
            </button>
        }
        @if (isManager && (canCancel || Model.Status == "PendingApproval"))
        {
            <div class="dropdown d-inline-block">
                @* auto-close="outside" keeps the menu open while a reason is typed. *@
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    @Loc.T("More")
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width:19rem">
                    @if (Model.Status == "PendingApproval")
                    {
                        <li><h6 class="dropdown-header">@Loc.T("Return to Open")</h6></li>
                        <li><div class="px-3 small text-muted">@Loc.T("Sends this order back to the assignee to redo. The reported cost and parts are cleared and the parts return to stock.")</div></li>
                        <li>
                            <form method="post" asp-action="RejectApproval" asp-route-id="@Model.Id" class="px-3 pb-2 pt-2">
                                @Html.AntiForgeryToken()
                                <label for="returnReason" class="visually-hidden">@Loc.T("Reason (optional)")</label>
                                <input type="text" id="returnReason" name="reason" class="form-control form-control-sm mb-2" placeholder="@Loc.T("Reason (optional)")" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary w-100" data-confirm="@Loc.T("Send this order back to the assignee to redo?")">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>@Loc.T("Return to Open")
                                </button>
                            </form>
                        </li>
                    }
                    @if (canCancel)
                    {
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">@Loc.T("Cancel Maintenance Order")</h6></li>
                        <li>
                            <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="px-3 pb-2">
                                @Html.AntiForgeryToken()
                                <label for="cancelReason" class="visually-hidden">@Loc.T("Reason (optional)")</label>
                                <input type="text" id="cancelReason" name="reason" class="form-control form-control-sm mb-2" placeholder="@Loc.T("Reason (optional)")" />
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100" data-confirm="@Loc.T("Cancel this maintenance order?")">
                                    <i class="bi bi-x-octagon me-1"></i>@Loc.T("Cancel Maintenance Order")
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@if (Model.Status is "Open" or "PendingApproval" && isManager)
{
    <div class="collapse mb-3" id="reassignPanel">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-person-gear text-primary"></i>@Loc.T("Reassign")
            </div>
            <div class="card-body">
                <div class="form-text mb-2">@Loc.T("Use this if the current assignee's account has been deactivated and the order needs to move to someone else.")</div>
                <form method="post" asp-action="Reassign" asp-route-id="@Model.Id" class="d-flex gap-2 flex-wrap">
                    @Html.AntiForgeryToken()
                    <div style="min-width:220px" class="flex-grow-1">
                        <partial name="_EmployeePicker" model="@(new EmployeePickerModel{Name="assignedToUserId",Placeholder=Loc.T("Search by name or email…")})" />
                    </div>
                    <select name="assignedToGroupId" class="form-select form-select-sm" style="max-width:200px" aria-label="@Loc.T("— or select a group —")">
                        <option value="">@Loc.T("— or select a group —")</option>
                        @foreach (var t in (List<Group>)(ViewBag.Groups ?? new List<Group>()))
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary flex-shrink-0">@Loc.T("Reassign")</button>
                </form>
            </div>
        </div>
    </div>
}

@* On a phone the action card (Report Fix / Approve) comes before the reference sidebar;
   the -lg- order classes restore the original two-column layout from lg up. *@
<div class="row g-3">
    <div class="col-lg-4 order-2 order-lg-1">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i>@Loc.T("Overview")
            </div>
            <div class="card-body">
                <dl class="row small mb-0 gy-2">
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Assigned To")</dt>
                    <dd class="col-7 text-end mb-0">@(Model.AssignedToUser?.FullName ?? (Model.AssignedToGroup != null ? $"{Loc.T("Group")}: {Model.AssignedToGroup.Name}" : "—"))</dd>
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Created By")</dt>
                    <dd class="col-7 text-end mb-0">@(Model.CreatedByUser?.FullName ?? "—")</dd>
                    @if (Model.DueDate.HasValue)
                    {
                        <dt class="col-5 text-muted fw-normal">@Loc.T("Due Date")</dt>
                        <dd class="col-7 text-end mb-0">@Loc.TDate(Model.DueDate.Value.ToString("dd/MM/yyyy"))</dd>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="mt-2 pt-2 border-top">
                        <div class="text-muted small mb-1">@Loc.T("Description")</div>
                        <div class="small">@Model.Description</div>
                    </div>
                }
            </div>
        </div>

        @if (hasSpecs)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-cpu text-primary"></i>@Loc.T("Asset Specifications")
                </div>
                <div class="card-body">
                    <dl class="row small mb-0 gy-2">
                        @if (!string.IsNullOrWhiteSpace(Model.Asset!.Manufacturer))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("Manufacturer")</dt><dd class="col-7 text-end mb-0">@Model.Asset.Manufacturer</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.Model))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("Model")</dt><dd class="col-7 text-end mb-0">@Model.Asset.Model</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.Sku))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("SKU")</dt><dd class="col-7 text-end mb-0">@Model.Asset.Sku</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.SerialNumber))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("Serial Number")</dt><dd class="col-7 text-end mb-0">@Model.Asset.SerialNumber</dd>
                        }
                    </dl>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8 order-1 order-lg-2">
        @if (canReportFix)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-primary">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-wrench-adjustable text-primary"></i>@Loc.T("Report Fix")
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Complete" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <div class="row g-2">
                            <div class="col-12">
                                <label for="completedDate" class="form-label small">@Loc.T("Completion Date")</label>
                                <input type="date" id="completedDate" name="CompletedDate" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <partial name="_SparePartPicker" model="@(new SparePartPickerModel{AssetId=Model.AssetId, ContainerId="maintenanceFixPartsList"})" />
                        <button type="submit" class="btn btn-sm btn-primary w-100 mt-3">
                            <i class="bi bi-check-lg me-1"></i>@Loc.T("Report Fix")
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (isOpen && !isAssignee && isManager)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-hourglass-split fs-5"></i>
                <span class="small">@Loc.T("Waiting on the assigned employee to report the fix.")</span>
            </div>
        }

        @if (Model.Status == "PendingApproval" && isManager)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-warning">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold"><i class="bi bi-hourglass-split me-1 text-warning"></i>@Loc.T("Pending Approval")</div>
                        <div class="small text-muted">@Loc.T("Review the fix report below, then approve to close this order.")</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <form method="post" asp-action="Approve" asp-route-id="@Model.Id"
                              onsubmit="return confirm('@Loc.T("Approve and close this maintenance order? This can't be undone.")')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2-circle me-1"></i>@Loc.T("Approve")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        @if (Model.Status == "PendingApproval" && !isManager)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-hourglass-split fs-5"></i>
                <span class="small">@Loc.T("Fix reported — waiting on a manager's approval to close.")</span>
            </div>
        }

        @if (Model.Status is "Done" or "PendingApproval")
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-data text-primary"></i>@Loc.T("Fix Report")
                </div>
                <div class="card-body">
                    <dl class="row small mb-0 gy-2">
                        <dt class="col-5 col-md-4 text-muted fw-normal">@Loc.T("Fix Cost")</dt><dd class="col-7 col-md-8 text-end mb-0">@Model.Cost</dd>
                        <dt class="col-5 col-md-4 text-muted fw-normal">@Loc.T("Completion Date")</dt><dd class="col-7 col-md-8 text-end mb-0">@Loc.TDate(Model.CompletedDate?.ToString("dd/MM/yyyy") ?? "")</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Model.FixDescription))
                    {
                        <div class="mt-2 pt-2 border-top"><div class="text-muted small mb-1">@Loc.T("Fix Description")</div><div class="small">@Model.FixDescription</div></div>
                    }
                    @if (Model.Parts.Count > 0)
                    {
                        <div class="mt-2 pt-2 border-top">
                            <div class="text-muted small mb-1"><i class="bi bi-box-seam me-1"></i>@Loc.T("Parts Used")</div>
                            <ul class="small mb-0 ps-3">
                                @foreach (var p in Model.Parts)
                                {
                                    <li>@p.Name × @p.Quantity</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.Status == "Cancelled")
        {
            <div class="alert alert-secondary d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-x-circle fs-5"></i>
                <span class="small">@Loc.T("This maintenance order was cancelled.")</span>
            </div>
        }

    </div>
</div>

