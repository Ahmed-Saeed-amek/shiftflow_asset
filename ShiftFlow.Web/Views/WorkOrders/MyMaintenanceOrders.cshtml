@model List<WorkOrder>
@{
    ViewData["Title"] = Loc.T("My Assigned Work Orders");
    var showAll = (bool)ViewBag.ShowAll;
    var range = (ViewBag.SelectedRange as string) ?? "month";
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("My Assigned Work Orders"),Subtitle=Loc.T("Work orders you're directly assigned to fix")})" />

<div class="d-flex align-items-center gap-2 flex-wrap mb-3">
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-secondary @(range == "month" ? "active" : "")" asp-action="MyMaintenanceOrders" asp-route-showAll="@showAll" asp-route-range="month">@Loc.T("This month")</a>
        <a class="btn btn-outline-secondary @(range == "all" ? "active" : "")" asp-action="MyMaintenanceOrders" asp-route-showAll="@showAll" asp-route-range="all">@Loc.T("All time")</a>
    </div>
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-secondary @(!showAll ? "active" : "")" asp-action="MyMaintenanceOrders" asp-route-showAll="false" asp-route-range="@range">@Loc.T("Open")</a>
        <a class="btn btn-outline-secondary @(showAll ? "active" : "")" asp-action="MyMaintenanceOrders" asp-route-showAll="true" asp-route-range="@range">@Loc.T("All")</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>@Loc.T("Work Order Number")</th><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Priority")</th><th>@Loc.T("Stage")</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                }
                @foreach (var w in Model)
                {
                    <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", new { id = w.Id })'">
                        <td class="small font-monospace">@w.WorkOrderNumber</td>
                        <td class="small">@w.Asset?.AssetTag</td>
                        <td><partial name="_StatusBadge" model="@w.Priority" /></td>
                        <td><partial name="_StatusBadge" model="@w.Stage" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
