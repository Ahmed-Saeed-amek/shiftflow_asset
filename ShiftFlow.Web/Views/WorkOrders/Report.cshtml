@model ReportActionViewModel
@{
    var asset = (Asset)ViewBag.Asset;
    ViewData["Title"] = Loc.T("Report Action");
}
<partial name="_PageHeader" model="@(new PageHeaderWithActions{
    Title = Loc.T("Report Action"),
    Subtitle = $"{asset.AssetTag} — {asset.Name}",
    Breadcrumbs = new List<(string Label, string? Url)>{ (asset.AssetTag, Url.Action("Details", "Assets", new { id = asset.Id })), (Loc.T("Report Action"), null) } })" />

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AssetId" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Loc.T("Category")</label>
                    <input type="text" class="form-control" value="@(asset.Category is { } reportCat ? Loc.LocalizedName(reportCat.Name, reportCat.NameAr) : null)" disabled />
                </div>
                <div class="col-md-4">
                    <label for="actionTypeSelect" class="form-label required">@Loc.T("Action Type")</label>
                    <select id="actionTypeSelect" asp-for="ActionTypeId" class="form-select">
                        <option value="">—</option>
                    </select>
                    <span asp-validation-for="ActionTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label for="causeSelect" class="form-label required">@Loc.T("Cause")</label>
                    <select id="causeSelect" asp-for="CauseId" class="form-select" disabled>
                        <option value="">—</option>
                    </select>
                    <span asp-validation-for="CauseId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div id="reportLoadError" class="alert alert-danger small d-none"></div>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">@Loc.T("Notes")</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="@Loc.T("Describe…")"></textarea>
                </div>
            </div>
            <div class="form-actions d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@Loc.T("Report Action")</button>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Details", "Assets", new { id = asset.Id }))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    const actionTypeSel = document.getElementById('actionTypeSelect');
    const causeSel = document.getElementById('causeSelect');
    const categoryId = @asset.CategoryId;
    const selectedActionTypeId = @Html.Raw(Model.ActionTypeId > 0 ? Model.ActionTypeId.ToString() : "null");
    const selectedCauseId = @Html.Raw(Model.CauseId > 0 ? Model.CauseId.ToString() : "null");
    const isRTL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.IsRTL));
    const localName = i => (isRTL && i.nameAr) ? i.nameAr : i.name;

    function fillSelect(sel, items, selectedId) {
        sel.innerHTML = '<option value="">—</option>';
        items.forEach(i => {
            const opt = document.createElement('option');
            opt.value = i.id; opt.textContent = localName(i);
            if (selectedId && i.id === selectedId) opt.selected = true;
            sel.appendChild(opt);
        });
        sel.disabled = items.length === 0;
    }

    const errorBox = document.getElementById('reportLoadError');
    const loadFailedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Couldn't load the options - check your connection and reload the page.")));

    function showLoadError() {
        errorBox.textContent = loadFailedText;
        errorBox.classList.remove('d-none');
    }

    // Both lookups are dropdown-populating fetches: a failure used to leave an empty, permanently
    // disabled select with no explanation at all.
    async function getJson(url) {
        const resp = await fetch(url);
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        return await resp.json();
    }

    async function loadActionTypes() {
        try {
            const types = await getJson(`/AssetActionTypes/ByCategory?categoryId=${categoryId}`);
            errorBox.classList.add('d-none');
            fillSelect(actionTypeSel, types, selectedActionTypeId);
            if (selectedActionTypeId) await loadCauses(selectedActionTypeId, selectedCauseId);
        } catch {
            showLoadError();
        }
    }

    async function loadCauses(actionTypeId, preselectCauseId) {
        if (!actionTypeId) { fillSelect(causeSel, [], null); return; }
        try {
            const causes = await getJson(`/AssetActionTypes/CausesByActionType?actionTypeId=${actionTypeId}`);
            errorBox.classList.add('d-none');
            fillSelect(causeSel, causes, preselectCauseId);
        } catch {
            showLoadError();
        }
    }

    actionTypeSel.addEventListener('change', () => loadCauses(actionTypeSel.value ? Number(actionTypeSel.value) : null, null));
    loadActionTypes();
})();
</script>
