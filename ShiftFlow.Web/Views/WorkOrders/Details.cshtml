@using Microsoft.AspNetCore.Authorization
@model WorkOrder
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Model.WorkOrderNumber;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.WorkOrderManage)).Succeeded;
    var isDraft = Model.Stage == "Draft";
    var isNew = Model.Stage == "New";
    var isBlocked = Model.Stage == "Blocked";
    var isFixedPending = Model.Stage == "Fixed - Pending Confirmation";
    // Once a vendor is acting on the work order, priority is locked — re-prioritizing after the
    // fact wouldn't reach the vendor and would just desync what they were actually told.
    var canEditPriority = canManage && (isDraft || isNew);
    var allVendors = ViewBag.AllVendors as List<Vendor>;
    var currentUserId = ViewBag.CurrentUserId as string;
    var canReportFixMyself = Model.VendorId == null && Model.AssignedToUserId == currentUserId && isNew;
    var canAdvanceWithoutVendor = Model.Stage == "Sent to Vendor" && !Model.RequiresVendorResponse && (canManage || Model.AssignedToUserId == currentUserId);
    var hasSpecs = Model.Asset != null && (!string.IsNullOrWhiteSpace(Model.Asset.Manufacturer) || !string.IsNullOrWhiteSpace(Model.Asset.Model) || !string.IsNullOrWhiteSpace(Model.Asset.SerialNumber) || !string.IsNullOrWhiteSpace(Model.Asset.Sku));
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-3">
    <div>
        <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
            <h1 class="fs-3 fw-bold font-heading mb-0">@Model.WorkOrderNumber</h1>
            <partial name="_StatusBadge" model="@Model.Stage" />
            <partial name="_StatusBadge" model="@Model.Priority" />
        </div>
        <div class="text-muted small d-flex align-items-center flex-wrap column-gap-3 row-gap-1">
            @if (Model.Asset != null)
            {
                <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetId" class="text-decoration-none">
                    <i class="bi bi-hdd-stack me-1"></i>@Model.Asset.AssetTag
                </a>
            }
            @if (Model.Asset?.Zone is { } zone)
            {
                <span><i class="bi bi-geo-alt me-1"></i>@Loc.LocalizedName(zone.Name, zone.NameAr)</span>
            }
            <span><i class="bi bi-calendar3 me-1"></i>@Loc.TDate(Model.CreatedDate.ToString("dd/MM/yyyy"))</span>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary align-self-start align-self-lg-auto flex-shrink-0">
        <i class="bi bi-arrow-left me-1"></i>@Loc.T("Back to Work Orders")
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger small">@TempData["Error"]</div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <partial name="_WorkOrderStagePipeline" model="Model" />
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i>@Loc.T("Overview")
            </div>
            <div class="card-body">
                <dl class="row small mb-0 gy-2">
                    <dt class="col-5 text-muted fw-normal">@Loc.T("Type")</dt>
                    <dd class="col-7 text-end mb-0">
                        @if (Model.SourceContract != null)
                        {
                            <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.SourceContractId"
                               class="badge border bg-dark-subtle text-dark-emphasis border-dark-subtle text-decoration-none"
                               title="@Loc.T("Auto-generated from this contract's Preventive Maintenance schedule.")">
                                <i class="bi bi-arrow-repeat me-1"></i>@Loc.T("Preventive Maintenance")
                            </a>
                        }
                        else
                        {
                            <span>@Loc.T("Manual")</span>
                        }
                    </dd>

                    <dt class="col-5 text-muted fw-normal">@Loc.T("Vendor")</dt>
                    <dd class="col-7 text-end mb-0">@(Model.Vendor?.Name ?? "—")</dd>

                    <dt class="col-5 text-muted fw-normal">@Loc.T("Assigned Employee")</dt>
                    <dd class="col-7 text-end mb-0">@(Model.AssignedToUser?.FullName ?? "—")</dd>
                </dl>

                @if (canManage)
                {
                    <form method="post" asp-action="AssignEmployee" asp-route-id="@Model.Id" class="mt-2 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        @{ var assignLabel = Model.AssignedToUserId != null ? Loc.T("Reassign Employee") : Loc.T("Assign Employee"); }
                        <label class="form-label small text-muted mb-1">@assignLabel</label>
                        <partial name="_EmployeePicker" model='new EmployeePickerModel {
                            Name = "employeeUserId", SelectedId = Model.AssignedToUserId, SelectedLabel = Model.AssignedToUser?.FullName,
                            Placeholder = Loc.T("Search by name or email…"), CssClass = "form-control-sm" }' />
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100 mt-2">@assignLabel</button>
                    </form>
                }

                @if (canEditPriority)
                {
                    <form method="post" asp-action="UpdatePriority" asp-route-id="@Model.Id" class="mt-2 pt-2 border-top d-flex align-items-center gap-2">
                        @Html.AntiForgeryToken()
                        <label class="form-label small text-muted mb-0 flex-shrink-0">@Loc.T("Priority")</label>
                        <select name="priority" class="form-select form-select-sm">
                            @foreach (var p in WorkOrder.Priorities)
                            {
                                <option value="@p" selected="@(Model.Priority==p)">@Loc.T(p)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary flex-shrink-0">@Loc.T("Update")</button>
                    </form>
                }
            </div>
        </div>

        @if (hasSpecs)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-cpu text-primary"></i>@Loc.T("Asset Specifications")
                </div>
                <div class="card-body">
                    <dl class="row small mb-0 gy-2">
                        @if (!string.IsNullOrWhiteSpace(Model.Asset!.Manufacturer))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("Manufacturer")</dt><dd class="col-7 text-end mb-0">@Model.Asset.Manufacturer</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.Model))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("Model")</dt><dd class="col-7 text-end mb-0">@Model.Asset.Model</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.Sku))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("SKU")</dt><dd class="col-7 text-end mb-0 font-monospace">@Model.Asset.Sku</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.SerialNumber))
                        {
                            <dt class="col-5 text-muted fw-normal">@Loc.T("Serial Number")</dt><dd class="col-7 text-end mb-0 font-monospace">@Model.Asset.SerialNumber</dd>
                        }
                    </dl>
                </div>
            </div>
        }

        @if (Model.ActionType != null)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-diamond text-primary"></i>@Loc.T("Defect Report")
                </div>
                <div class="card-body">
                    <dl class="row small mb-0 gy-2">
                        <dt class="col-5 text-muted fw-normal">@Loc.T("Action Type")</dt><dd class="col-7 text-end mb-0">@Model.ActionType.Name</dd>
                        <dt class="col-5 text-muted fw-normal">@Loc.T("Cause")</dt><dd class="col-7 text-end mb-0">@Model.Cause?.Name</dd>
                        <dt class="col-5 text-muted fw-normal">@Loc.T("Reported By")</dt><dd class="col-7 text-end mb-0">@Model.CreatedByUser?.FullName</dd>
                    </dl>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description) || !string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-card-text text-primary"></i>@Loc.T("Notes")
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="mb-2"><div class="text-muted small mb-1">@Loc.T("Description")</div><div class="small long-text-field">@Model.Description</div></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div><div class="text-muted small mb-1">@Loc.T("Notes")</div><div class="small long-text-field" style="white-space:pre-line">@Model.Notes</div></div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        @if (isDraft && canManage)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-primary">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-inbox text-primary"></i>@Loc.T("Review this report")
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Accept" asp-route-id="@Model.Id" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <label class="form-label small">@Loc.T("Choose Vendor")</label>
                            <select name="vendorId" class="form-select form-select-sm">
                                <option value="">@Loc.T("— No vendor (employee only) —")</option>
                                @foreach (var v in allVendors ?? new())
                                {
                                    <option value="@v.Id">@v.Name</option>
                                }
                            </select>
                            @if (string.IsNullOrEmpty(Model.AssignedToUserId))
                            {
                                <div class="form-text">@Loc.T("Assign an employee above if you plan to accept without a vendor.")</div>
                            }
                        </div>
                        <input type="hidden" name="priority" value="@Model.Priority" />
                        <div class="col-12 mt-1">
                            <button type="submit" class="btn btn-sm btn-primary w-100">
                                <i class="bi bi-check-lg me-1"></i>@Loc.T("Accept")
                            </button>
                        </div>
                    </form>
                    <form method="post" asp-action="Reject" asp-route-id="@Model.Id" class="d-flex gap-2 mt-2 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="@Loc.T("Rejection reason (optional)")" />
                        <button type="submit" class="btn btn-sm btn-outline-danger flex-shrink-0">@Loc.T("Reject")</button>
                    </form>
                </div>
            </div>
        }

        @if (isNew && canManage)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-primary">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-send text-primary"></i>@Loc.T("Send to Vendor")
                </div>
                <div class="card-body">
                    <form method="post" asp-action="SendToVendor" asp-route-id="@Model.Id" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <select name="vendorId" class="form-select form-select-sm">
                            @foreach (var v in allVendors ?? new())
                            {
                                <option value="@v.Id">@v.Name</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary flex-shrink-0">@Loc.T("Send to Vendor")</button>
                    </form>
                </div>
            </div>
        }

        @if (isNew && Model.VendorId == null && Model.AssignedToUserId != null && Model.AssignedToUserId != currentUserId)
        {
            // The "Report Fix" form only ever shows to the assigned employee themselves
            // (canReportFixMyself) — a manager or anyone else viewing this same work order
            // otherwise saw no fix-report section at all and no explanation, reading as a dead
            // end rather than the designed handoff it actually is.
            <div class="alert alert-light border small mb-3">
                <i class="bi bi-hourglass-split me-1"></i>
                @Loc.T("Waiting on the assigned employee to report the fix.")
            </div>
        }

        @if (canReportFixMyself)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-primary">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-wrench-adjustable text-primary"></i>@Loc.T("Report Fix")
                </div>
                <div class="card-body">
                    <form method="post" asp-action="EmployeeFix" asp-route-id="@Model.Id" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label small">@Loc.T("Completion Date")</label>
                                <input type="date" name="CompletionDate" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <partial name="_SparePartPicker" model="@(new SparePartPickerModel{AssetId=Model.AssetId, ContainerId="employeeFixPartsList"})" />
                        <label class="form-label small d-block mt-3">@Loc.T("Attachments")</label>
                        <input type="file" name="Files" class="form-control form-control-sm" multiple />
                        <button type="submit" class="btn btn-sm btn-primary w-100 mt-3">
                            <i class="bi bi-check-lg me-1"></i>@Loc.T("Report Fix")
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Stage == "Sent to Vendor")
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-hourglass-split fs-5"></i>
                <span class="small">@Loc.T("Waiting on the vendor to respond via their portal.")</span>
            </div>
        }

        @if (canAdvanceWithoutVendor)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-info">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-fast-forward text-info"></i>@Loc.T("Advance Without Vendor")
                </div>
                <div class="card-body">
                    <div class="small text-muted mb-2">@Loc.T("This work order doesn't require a vendor response — report the fix directly instead of waiting.")</div>
                    <form method="post" asp-action="AdvanceWithoutVendor" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label small">@Loc.T("Completion Date")</label>
                                <input type="date" name="CompletionDate" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <partial name="_SparePartPicker" model="@(new SparePartPickerModel{AssetId=Model.AssetId, ContainerId="advanceWithoutVendorPartsList"})" />
                        <button type="submit" class="btn btn-sm btn-info w-100 mt-3 text-white">
                            <i class="bi bi-check-lg me-1"></i>@Loc.T("Advance Without Vendor")
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (isBlocked && canManage)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-danger">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-sign-stop text-danger"></i>@Loc.T("Resend")
                </div>
                <div class="card-body">
                    <dl class="row small mb-2">
                        <dt class="col-4 text-muted fw-normal">@Loc.T("Block Reason")</dt>
                        <dd class="col-8 mb-0">@(Model.BlockReason != null ? Loc.LocalizedName(Model.BlockReason.Name, Model.BlockReason.NameAr) : null)</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Model.BlockDetail))
                    {
                        <div class="mb-2 small"><div class="text-muted mb-1">@Loc.T("Block Detail")</div>@Model.BlockDetail</div>
                    }
                    <form method="post" asp-action="Resend" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary w-100">@Loc.T("Resend")</button>
                    </form>
                </div>
            </div>
        }

        @if (isFixedPending && canManage)
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-4 border-warning">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold"><i class="bi bi-clipboard-check me-1 text-warning"></i>@Loc.T("Fixed - Pending Confirmation")</div>
                        <div class="small text-muted">@Loc.T("Review the fix report below, then confirm to close this work order.")</div>
                    </div>
                    <form method="post" asp-action="Confirm" asp-route-id="@Model.Id"
                          onsubmit="return confirm('@Loc.T("Confirm this fix and close the work order? This can't be undone.")')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle me-1"></i>@Loc.T("Confirm")
                        </button>
                    </form>
                </div>
            </div>
        }

        @if ((isFixedPending || Model.Stage == "Closed") && (Model.FixCost.HasValue || Model.FixCompletionDate.HasValue || !string.IsNullOrWhiteSpace(Model.FixDescription) || Model.Parts.Count > 0))
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-data text-primary"></i>@Loc.T("Fix Report")
                </div>
                <div class="card-body">
                    @if (Model.FixCost.HasValue || Model.FixCompletionDate.HasValue)
                    {
                        <dl class="row small mb-0 gy-2">
                            @if (Model.FixCost.HasValue)
                            {
                                <dt class="col-5 col-md-4 text-muted fw-normal">@Loc.T("Fix Cost")</dt><dd class="col-7 col-md-8 text-end mb-0">@Model.FixCost</dd>
                            }
                            @if (Model.FixCompletionDate.HasValue)
                            {
                                <dt class="col-5 col-md-4 text-muted fw-normal">@Loc.T("Completion Date")</dt><dd class="col-7 col-md-8 text-end mb-0">@Loc.TDate(Model.FixCompletionDate?.ToString("dd/MM/yyyy") ?? "")</dd>
                            }
                        </dl>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.FixDescription))
                    {
                        <div class="mt-2 pt-2 border-top"><div class="text-muted small mb-1">@Loc.T("Fix Description")</div><div class="small long-text-field">@Model.FixDescription</div></div>
                    }
                    @if (Model.Parts.Count > 0)
                    {
                        <div class="mt-2 pt-2 border-top">
                            <div class="text-muted small mb-1"><i class="bi bi-box-seam me-1"></i>@Loc.T("Parts Used")</div>
                            <ul class="small mb-0 ps-3">
                                @foreach (var p in Model.Parts)
                                {
                                    <li>@p.Name × @p.Quantity</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (Model.Attachments.Count > 0)
                    {
                        <div class="mt-2 pt-2 border-top">
                            <div class="text-muted small mb-1"><i class="bi bi-paperclip me-1"></i>@Loc.T("Attachments")</div>
                            @foreach (var a in Model.Attachments)
                            {
                                <a asp-action="DownloadAttachment" asp-route-attachmentId="@a.Id" class="d-block small text-decoration-none"><i class="bi bi-file-earmark me-1"></i>@a.FileName</a>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i>@Loc.T("Stage History")
            </div>
            <div class="card-body">
                <div class="wo-timeline">
                    @foreach (var e in Model.StageEvents.OrderByDescending(e => e.ChangedAt))
                    {
                        <div class="wo-timeline-item">
                            <div class="wo-timeline-dot"></div>
                            <div class="wo-timeline-content d-flex justify-content-between align-items-center flex-wrap gap-1">
                                <div>
                                    <partial name="_StatusBadge" model="@e.Stage" />
                                    <span class="small text-muted ms-2">@e.ChangedByUser?.FullName</span>
                                </div>
                                <span class="small text-muted">@Loc.TDate(e.ChangedAt.ToString("dd/MM/yyyy")) @e.ChangedAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (canManage && Model.Stage != "Closed")
        {
            <div class="text-end">
                <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0" data-bs-toggle="collapse" data-bs-target="#forceCloseCollapse">
                    <i class="bi bi-x-octagon me-1"></i>@Loc.T("Force Close")
                </button>
                <div class="collapse mt-2" id="forceCloseCollapse">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-start">
                            <p class="small text-muted mb-2">@Loc.T("Closes this work order immediately without waiting for a vendor or employee reply.")</p>
                            <form method="post" asp-action="ForceClose" asp-route-id="@Model.Id"
                                  onsubmit="return confirm('@Loc.T("Close this work order immediately without waiting for a vendor or employee reply?")')"
                                  class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="text" name="reason" class="form-control form-control-sm" placeholder="@Loc.T("Force-close reason (optional)")" />
                                <button type="submit" class="btn btn-sm btn-outline-danger flex-shrink-0">@Loc.T("Force Close")</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .wo-timeline { position: relative; padding-inline-start: 1.35rem; }
    .wo-timeline::before {
        content: ""; position: absolute; inset-inline-start: .3rem; top: .3rem; bottom: .3rem;
        width: 2px; background: hsl(var(--border));
    }
    .wo-timeline-item { position: relative; padding-bottom: 1rem; }
    .wo-timeline-item:last-child { padding-bottom: 0; }
    .wo-timeline-dot {
        position: absolute; inset-inline-start: -1.35rem; top: .2rem;
        width: .6rem; height: .6rem; border-radius: 50%; background: #0EA5E9;
        box-shadow: 0 0 0 3px hsl(var(--card));
    }
</style>

<script>
    // Restores what was already selected after a rejected submission (e.g. a bad attachment)
    // sent the page back to a fresh GET — otherwise the parts/date the employee/manager had
    // already filled in would silently vanish. Only one of the two forms below is ever rendered
    // for a given work order stage, so restoring into "the CompletionDate field that exists" is
    // unambiguous. The parts picker loads its <select> options asynchronously
    // (SpareParts/CompatibleForAsset), so restoring the selected SparePartId per row has to wait
    // for that fetch via window.__sparePartsReady before the rows even exist.
    (function restoreFixForm() {
        const completionDate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["FixForm_CDate"] as string));
        const sparePartIds = @Html.Raw((string?)TempData["FixForm_SparePartIds"] ?? "[]");
        const partQuantities = @Html.Raw((string?)TempData["FixForm_PartQuantities"] ?? "[]");

        const dateField = document.querySelector('input[name=CompletionDate]');
        if (!dateField) return;
        if (completionDate) dateField.value = completionDate;

        if (sparePartIds.length === 0) return;
        const containerId = document.getElementById('employeeFixPartsList') ? 'employeeFixPartsList'
            : (document.getElementById('advanceWithoutVendorPartsList') ? 'advanceWithoutVendorPartsList' : null);
        if (!containerId || !window.__sparePartsReady || !window.__sparePartsReady[containerId]) return;
        window.__sparePartsReady[containerId].then(function () {
            for (let i = 1; i < sparePartIds.length; i++) addSparePartRow(containerId);
            const container = document.getElementById(containerId);
            const selects = container.querySelectorAll('select[name=SparePartIds]');
            const qtyInputs = container.querySelectorAll('input[name=PartQuantities]');
            sparePartIds.forEach((id, i) => { if (selects[i]) selects[i].value = id; });
            partQuantities.forEach((q, i) => { if (qtyInputs[i]) qtyInputs[i].value = q; });
        });
    })();
</script>
