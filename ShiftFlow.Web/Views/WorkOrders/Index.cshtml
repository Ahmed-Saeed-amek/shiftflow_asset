@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@model List<WorkOrder>
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Work Orders");
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.WorkOrderManage)).Succeeded;
    var canExport = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.WorkOrderExport)).Succeeded;
    var q = (string?)ViewBag.Q;
    var stage = (string?)ViewBag.Stage;
    var priority = (string?)ViewBag.Priority;
    var anyFilter = !string.IsNullOrWhiteSpace(q) || !string.IsNullOrWhiteSpace(stage) || !string.IsNullOrWhiteSpace(priority);

    // Rendered up front because a templated delegate can't await — the header template below just
    // drops the already-rendered buttons in.
    var exportButtons = canExport
        ? await Html.PartialAsync("_ExportButtons", new ExportButtonsModel { ExcelUrl = Url.Action("ExportExcel"), PdfUrl = Url.Action("ExportPdf") })
        : null;
    Func<object?, IHtmlContent> headerActions = @<text>
        @exportButtons
        @if (canManage)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i>@Loc.T("New Work Order")</a>
        }
    </text>;
}
<partial name="_PageHeader" model="@(new PageHeaderWithBreadcrumbs{Title=Loc.T("Work Orders"),Subtitle=Loc.T("Vendor and in-house repair jobs, from report to close"),Actions=headerActions(null)})" />

<form method="get" class="filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
    <label for="woSearch" class="visually-hidden">@Loc.T("Search")</label>
    <input type="text" id="woSearch" name="q" value="@q" class="form-control form-control-sm" placeholder="@Loc.T("Search by order # or asset tag…")" style="min-width:200px" />

    <label for="woStage" class="visually-hidden">@Loc.T("Stage")</label>
    <select id="woStage" name="stage" class="form-select form-select-sm w-auto">
        <option value="">@Loc.T("All Stages")</option>
        @foreach (var s in WorkOrder.AllDisplayStages)
        {
            <option value="@s" selected="@(stage == s)">@Loc.T(s)</option>
        }
    </select>

    <label for="woPriority" class="visually-hidden">@Loc.T("Priority")</label>
    <select id="woPriority" name="priority" class="form-select form-select-sm w-auto">
        <option value="">@Loc.T("All Priorities")</option>
        @foreach (var p in WorkOrder.Priorities)
        {
            <option value="@p" selected="@(priority == p)">@Loc.T(p)</option>
        }
    </select>

    <button type="submit" class="btn btn-outline-secondary btn-sm">@Loc.T("Filter")</button>
    @if (anyFilter)
    {
        <a class="btn btn-link btn-sm" href="@Url.Action("Index")">@Loc.T("Clear")</a>
    }
    <span class="filter-bar__count text-muted small ms-auto">@ViewBag.TotalCount @Loc.T("records")</span>
</form>

<div class="card border-0 shadow-sm">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel{
            Icon = "bi-tools",
            Title = anyFilter ? Loc.T("No work orders match these filters") : Loc.T("No work orders yet"),
            Text = anyFilter ? Loc.T("Try a different search or clear the filters.") : Loc.T("Work orders raised from a defect or a vendor job will show up here."),
            ActionUrl = canManage && !anyFilter ? Url.Action("Create") : null,
            ActionLabel = Loc.T("New Work Order") })" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-card-stack">
                <thead class="table-light">
                    <tr>
                        <th>@Loc.T("Work Order Number")</th><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Type")</th>
                        <th>@Loc.T("Priority")</th><th>@Loc.T("Stage")</th><th>@Loc.T("Vendor")</th><th>@Loc.T("Assigned Employee")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model)
                    {
                        <tr class="row-link" data-href="@Url.Action("Details", new { id = w.Id })">
                            @* A real link, not row-click only: keyboard users, middle-click and
                               "open in new tab" all need an actual anchor. *@
                            <td data-label="@Loc.T("Work Order Number")"><a asp-action="Details" asp-route-id="@w.Id" class="fw-semibold text-decoration-none">@w.WorkOrderNumber</a></td>
                            <td class="small" data-label="@Loc.T("Asset Tag")">@w.Asset?.AssetTag</td>
                            <td data-label="@Loc.T("Type")" data-hide-mobile>
                                @if (w.SourceContractId != null)
                                {
                                    <span class="badge border bg-dark-subtle text-dark-emphasis border-dark-subtle" title="@Loc.T("Auto-generated from this contract's Preventive Maintenance schedule.")">
                                        <i class="bi bi-arrow-repeat me-1"></i>@Loc.T("Preventive Maintenance")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">@Loc.T("Manual")</span>
                                }
                            </td>
                            <td data-label="@Loc.T("Priority")"><partial name="_StatusBadge" model="@w.Priority" /></td>
                            <td data-label="@Loc.T("Stage")"><partial name="_StatusBadge" model="@w.Stage" /></td>
                            <td class="small" data-label="@Loc.T("Vendor")">@w.Vendor?.Name</td>
                            <td class="small" data-label="@Loc.T("Assigned Employee")">@w.AssignedToUser?.FullName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_Pagination" model="@((PaginationModel)ViewBag.Pagination)" />
