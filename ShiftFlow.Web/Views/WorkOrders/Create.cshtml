@model WorkOrderViewModel
@{ ViewData["Title"] = Loc.T("New Work Order"); }
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("New Work Order")})" />

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Assets")</label>
                    <partial name="_AssetSinglePicker" model='new AssetSinglePickerModel {
                        Name = "AssetId", SelectedId = Model.AssetId > 0 ? Model.AssetId : null,
                        SelectedLabel = ViewBag.SelectedAssetLabel as string }' />
                    <span asp-validation-for="AssetId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Priority")</label>
                    <select asp-for="Priority" class="form-select">
                        @foreach (var p in (string[])ViewBag.Priorities)
                        {
                            <option value="@p">@Loc.T(p)</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small">@Loc.T("Description")</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label small">@Loc.T("Notes")</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">@Loc.T("Assigned Employee")</label>
                    <partial name="_EmployeePicker" model='new EmployeePickerModel {
                        Name = "AssignedToUserId", SelectedId = Model.AssignedToUserId,
                        Placeholder = Loc.T("Search by name or email…") }' />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="RequiresVendorResponse" class="form-check-input" type="checkbox" />
                        <label asp-for="RequiresVendorResponse" class="form-check-label small">@Loc.T("Requires vendor response")</label>
                        <div class="form-text">@Loc.T("When off, a manager or the assigned employee can advance this work order past \"Sent to Vendor\" without waiting on the vendor.")</div>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>
