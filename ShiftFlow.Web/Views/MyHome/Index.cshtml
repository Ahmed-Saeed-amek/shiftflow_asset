@using ShiftFlow.Web.ViewModels
@using ShiftFlow.Web.Services
@{
    ViewData["Title"] = Loc.T("My Home");
    // Same per-request permission set the sidebar uses — no extra AuthorizeAsync calls.
    var perms = await Context.GetNavPermissionsAsync();
    var recentOrders = (List<MyWorkOrderRow>)ViewBag.RecentOrders;
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Welcome back") + ", " + (string)ViewBag.UserName,Subtitle=Loc.T("Here's what's on your plate today")})" />

<div class="row g-3 mb-4">
    <div class="col-6 col-md-6">
        <a href="@Url.Action("MyOrders","Users")" class="text-decoration-none">
            <partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("My Open Orders"),Value=ViewBag.OpenOrderCount.ToString(),Icon="bi-clipboard-check",Color="amber"})" />
        </a>
    </div>
    <div class="col-6 col-md-6">
        <a href="@Url.Action("MyOrders","Users")" class="text-decoration-none">
            <partial name="_KpiCard" model="@(new KpiCardModel{Title=Loc.T("Overdue"),Value=ViewBag.OverdueOrderCount.ToString(),Icon="bi-alarm",Color="red"})" />
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 fw-semibold"><i class="bi bi-clipboard-check me-2 text-primary"></i>@Loc.T("Recent Orders")</div>
            <div class="list-group list-group-flush">
                @if (recentOrders.Count == 0)
                {
                    <div class="list-group-item text-muted small text-center py-3">@Loc.T("No open orders — you're all caught up.")</div>
                }
                @foreach (var o in recentOrders)
                {
                    <a class="list-group-item list-group-item-action" asp-controller="@o.DetailsController" asp-action="Details" asp-route-id="@o.Id">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="small fw-semibold">@o.OrderNumber</div>
                                <div class="small text-muted">@(o.DueDate.HasValue ? Loc.T("Due") + " " + o.DueDate.Value.ToString("dd/MM/yyyy") : "")</div>
                            </div>
                            <partial name="_StatusBadge" model="@o.Status" />
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 fw-semibold"><i class="bi bi-grid me-2"></i>@Loc.T("Quick Links")</div>
            <div class="list-group list-group-flush">
                <a asp-controller="Users" asp-action="MyOrders" class="list-group-item list-group-item-action"><i class="bi bi-list-check me-2 text-muted"></i>@Loc.T("My Orders")</a>
                <a asp-controller="Users" asp-action="MyHistory" class="list-group-item list-group-item-action"><i class="bi bi-clock-history me-2 text-muted"></i>@Loc.T("My History")</a>
                @if (perms.CanReportAssetAction)
                {
                    @* WorkOrders/Report needs an assetId, and the fastest way a field user has one
                       is the asset's own printed QR label — so this scans first, then opens the
                       report form for whatever was scanned. *@
                    <button type="button" class="list-group-item list-group-item-action" id="quickReportAction">
                        <i class="bi bi-megaphone me-2 text-muted"></i>@Loc.T("Report Action")
                        <span class="d-block small text-muted">@Loc.T("Scan an asset's QR label to report an action on it")</span>
                    </button>
                }
                @* Opens the shared QR modal from _Layout (site.js lazily loads the decoder) and
                   navigates straight to whatever asset was scanned. *@
                <button type="button" class="list-group-item list-group-item-action" id="quickScanQr">
                    <i class="bi bi-qr-code-scan me-2 text-muted"></i>@Loc.T("Scan QR Code")
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var reportBtn = document.getElementById('quickReportAction');
    if (reportBtn) {
        reportBtn.addEventListener('click', function () {
            window.scanAssetQr(function (asset) {
                if (asset) window.location.href = '/WorkOrders/Report?assetId=' + asset.id;
            });
        });
    }
    document.getElementById('quickScanQr').addEventListener('click', function () {
        window.scanAssetQr(function (asset) {
            if (asset) window.location.href = '/Assets/Details/' + asset.id;
        });
    });
</script>
}
