@model AssetViewModel
@{
    var selectedZone = ViewBag.SelectedZone as Zone;
    var selectedZoneLabel = selectedZone == null ? null : Loc.LocalizedName(selectedZone.Name, selectedZone.NameAr);
    var selectedZoneCategoryId = ViewBag.SelectedLocationCategoryId as int?;
}
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AssetTag" class="form-label required">@Loc.T("Asset Tag")</label>
                    <input asp-for="AssetTag" class="form-control" />
                    <span asp-validation-for="AssetTag" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label required">@Loc.T("Name")</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NameAr" class="form-label">@Loc.T("Name (Arabic)")</label>
                    <input asp-for="NameAr" class="form-control" dir="rtl" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label">@Loc.T("Status")</label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var s in Asset.Statuses)
                        {
                            <option value="@s">@Loc.T(s)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="categoryParentSelect" class="form-label required">@Loc.T("Category")</label>
                    <select id="categoryParentSelect" class="form-select">
                        <option value="">—</option>
                        @foreach (var c in (List<AssetCategory>)ViewBag.Categories)
                        {
                            <option value="@c.Id" selected="@(ViewBag.SelectedParentCategoryId as int? == c.Id)">@Loc.LocalizedName(c.Name, c.NameAr)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="categorySubSelect" class="form-label">@Loc.T("Subcategory")</label>
                    <select id="categorySubSelect" class="form-select" disabled>
                        <option value="">@Loc.T("None")</option>
                    </select>
                    <input type="hidden" asp-for="CategoryId" id="categoryIdHidden" />
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    <div class="help-text">@Loc.T("Optional — leave empty to file the asset under the category itself.")</div>
                </div>
                @* Zone picker inlined (rather than the shared _ZoneCombobox partial) so both halves
                   carry a real <label>: the partial renders its category <select> with only a
                   placeholder option, which read as an unlabelled second dropdown next to "Zone".
                   The data-zc-* hooks are identical, so site.js's initZonePickers() drives it. *@
                <div class="col-12 zone-combobox" data-zone-combobox>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="assetZoneCategory" class="form-label">@Loc.T("Zone Category")</label>
                            <select id="assetZoneCategory" class="form-select" data-zc-category>
                                <option value="">—</option>
                                @foreach (var c in (List<LocationCategory>)ViewBag.LocationCategories)
                                {
                                    <option value="@c.Id" selected="@(selectedZoneCategoryId == c.Id)">@Loc.LocalizedName(c.Name, c.NameAr)</option>
                                }
                            </select>
                            <div class="help-text">@Loc.T("Pick a category first to narrow the zone search.")</div>
                        </div>
                        <div class="col-md-6">
                            <label for="assetZoneSearch" class="form-label required">@Loc.T("Zone")</label>
                            <div class="position-relative">
                                <input type="hidden" name="ZoneId" value="@(Model.ZoneId > 0 ? Model.ZoneId : (int?)null)" data-zc-value />
                                <input type="text" id="assetZoneSearch" class="form-control" autocomplete="off"
                                       placeholder="@Loc.T("Search zones…")" value="@selectedZoneLabel" data-zc-search />
                                <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index:1055;max-height:260px;overflow:auto" data-zc-results data-nomatch="@Loc.T("No matches")"></div>
                            </div>
                            <span asp-validation-for="ZoneId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Manufacturer" class="form-label">@Loc.T("Manufacturer")</label>
                    <input asp-for="Manufacturer" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Model" class="form-label">@Loc.T("Model")</label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="SerialNumber" class="form-label">@Loc.T("Serial Number")</label>
                    <input asp-for="SerialNumber" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Sku" class="form-label">@Loc.T("SKU")</label>
                    <input asp-for="Sku" class="form-control" />
                    <div class="help-text">@Loc.T("Manufacturer part/catalog number")</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="PurchaseDate" class="form-label">@Loc.T("Purchase Date")</label>
                    <input asp-for="PurchaseDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="WarrantyExpiry" class="form-label">@Loc.T("Warranty Expiry")</label>
                    <input asp-for="WarrantyExpiry" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">@Loc.T("Notes")</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <div class="help-text"><i class="bi bi-info-circle me-1"></i>@Loc.T("Vendor is determined automatically from this asset's linked Contracts — link it to a contract to set its vendor.")</div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>
<script>
(function () {
    const noneLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("None")));
    const isRTL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.IsRTL));
    const localName = i => (isRTL && i.nameAr) ? i.nameAr : i.name;

    function fillSelect(sel, items, selectedId) {
        sel.innerHTML = '<option value="">—</option>';
        items.forEach(i => {
            const opt = document.createElement('option');
            opt.value = i.id; opt.textContent = localName(i);
            if (selectedId && i.id === selectedId) opt.selected = true;
            sel.appendChild(opt);
        });
        sel.disabled = items.length === 0;
    }

    // Category → Subcategory (subcategory optional — CategoryId hidden field falls back to the parent when none is chosen)
    const loadFailedLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.T("Couldn't load subcategories")));
    const catParentSel = document.getElementById('categoryParentSelect');
    const catSubSel = document.getElementById('categorySubSelect');
    const catIdHidden = document.getElementById('categoryIdHidden');
    const selectedSubcategoryId = @Html.Raw(ViewBag.SelectedSubcategoryId != null ? ViewBag.SelectedSubcategoryId.ToString() : "null");

    function updateCategoryHidden() {
        catIdHidden.value = catSubSel.value || catParentSel.value || '';
    }

    async function loadSubcategories(parentId, preselectSubId) {
        if (!parentId) { fillSelect(catSubSel, [], null); updateCategoryHidden(); return; }
        try {
            const r = await fetch(`/AssetCategories/ByParent?parentId=${parentId}`);
            if (!r.ok) throw new Error(r.status);
            const subs = await r.json();
            fillSelect(catSubSel, subs, preselectSubId);
            catSubSel.querySelector('option[value=""]').textContent = noneLabel;
        } catch {
            // The parent category alone is still a valid selection, so keep the form usable and
            // say why the subcategory list is empty instead of failing silently.
            fillSelect(catSubSel, [], null);
            catSubSel.querySelector('option[value=""]').textContent = loadFailedLabel;
        }
        updateCategoryHidden();
    }

    catParentSel.addEventListener('change', async () => {
        // Set the hidden CategoryId to the parent immediately, synchronously — updateCategoryHidden()
        // otherwise only runs once loadSubcategories' async fetch resolves, so picking a parent
        // category that HAS subcategories and saving before that fetch finishes (a fast click, or a
        // slow network) posted an empty CategoryId and a misleading "Please select a Category" error
        // even though a category was, in fact, selected (confirmed live). Stale subcategory options
        // are about to be replaced by loadSubcategories below, so don't let the old catSubSel.value
        // win here — go straight to the parent, then let the subcategory fetch override it if needed.
        catIdHidden.value = catParentSel.value || '';
        await loadSubcategories(catParentSel.value ? Number(catParentSel.value) : null, null);
    });
    catSubSel.addEventListener('change', updateCategoryHidden);

    if (catParentSel.value) loadSubcategories(Number(catParentSel.value), selectedSubcategoryId);
})();
</script>
