@model AssetViewModel
@{ ViewData["Title"] = Model.AssetTag; }
<partial name="_PageHeader" model='new PageHeaderModel {
    Title = Loc.T("Edit Asset"),
    Subtitle = Model.Name,
    Breadcrumbs = new List<(string Label, string? Url)> { (Loc.T("Assets"), Url.Action("Index")), (Model.AssetTag, Url.Action("Details", new { id = Model.Id })), (Loc.T("Edit"), null) } }' />
<partial name="_Form" model="Model" />
