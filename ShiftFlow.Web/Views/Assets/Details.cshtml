@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@model Asset
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Model.AssetTag;
    var canManageWorkOrders = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.WorkOrderManage)).Succeeded;
    var canManageAsset = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.AssetManage)).Succeeded;
    var canReportAction = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.AssetReportAction)).Succeeded;
    var canViewVendor = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.VendorView)).Succeeded;
    // A retired asset is decommissioned — reporting a new fault or opening a work order against
    // it makes no sense (there is nothing left to fix), and previously nothing stopped it:
    // the forms loaded and submitted fine even for a Retired asset, silently creating orders
    // against equipment that is no longer in service.
    var isRetired = Model.Status == "Retired";

    // Header: one primary (Edit), at most two outline secondaries, everything else — including the
    // destructive Delete, which used to sit in a lone right-aligned form row of its own — in "More".
    Func<object?, IHtmlContent> reportBtn = @<a href="@Url.Action("Report", "WorkOrders", new { assetId = Model.Id })" class="btn btn-outline-warning btn-sm"><i class="bi bi-flag me-1"></i>@Loc.T("Report Action")</a>;
    Func<object?, IHtmlContent> newWoBtn = @<a href="@Url.Action("Create", "WorkOrders", new { assetId = Model.Id })" class="btn btn-outline-primary btn-sm"><i class="bi bi-tools me-1"></i>@Loc.T("New Work Order")</a>;
    Func<object?, IHtmlContent> editBtn = @<a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>@Loc.T("Edit")</a>;
    Func<object?, IHtmlContent> moreMenu =
        @<div class="dropdown d-inline-block">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@Loc.T("More")</button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="@Url.Action("Label", new { id = Model.Id })" target="_blank"><i class="bi bi-upc-scan me-2"></i>@Loc.T("Print Label")</a></li>
                @if (canManageAsset)
                {
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger" data-confirm="@Loc.T("Delete this asset? This cannot be undone.")"><i class="bi bi-trash me-2"></i>@Loc.T("Delete")</button>
                        </form>
                    </li>
                }
            </ul>
        </div>;

    var actions = new HtmlContentBuilder();
    if (canReportAction && !isRetired) { actions.AppendHtml(reportBtn(null)); }
    if (canManageWorkOrders && !isRetired) { actions.AppendHtml(newWoBtn(null)); }
    actions.AppendHtml(moreMenu(null));
    if (canManageAsset) { actions.AppendHtml(editBtn(null)); }
}
<partial name="_PageHeader" model='new PageHeaderWithActions {
    Title = Model.AssetTag,
    Subtitle = Model.Name,
    Breadcrumbs = new List<(string Label, string? Url)> { (Loc.T("Assets"), Url.Action("Index")), (Model.AssetTag, null) },
    Actions = actions }' />

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Status")</span><partial name="_StatusBadge" model="@Model.Status" /></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Category")</span><span class="small fw-semibold">@(Model.Category is { } modelCat ? Loc.LocalizedName(modelCat.Name, modelCat.NameAr) : null)</span></div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted small">@Loc.T("Zone")</span>
                    <span class="small fw-semibold">
                        @if (Model.Zone != null)
                        {
                            <a asp-controller="Zones" asp-action="Details" asp-route-id="@Model.Zone.Id">@Loc.LocalizedName(Model.Zone.Name, Model.Zone.NameAr)</a>
                            <span class="text-muted">(@(Model.Zone.LocationCategory is { } cat ? Loc.LocalizedName(cat.Name, cat.NameAr) : null))</span>
                        }
                    </span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted small">@Loc.T("Vendor")</span>
                    <span class="small">
                        @{ var derivedVendor = (Vendor?)ViewBag.DerivedVendor; }
                        @if (derivedVendor != null)
                        {
                            @if (canViewVendor)
                            {
                                <a asp-controller="Vendors" asp-action="Details" asp-route-id="@derivedVendor.Id">@derivedVendor.Name</a>
                            }
                            else
                            {
                                @derivedVendor.Name
                            }
                        }
                        else
                        {
                            <span class="text-muted">@Loc.T("No linked contract")</span>
                        }
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Manufacturer))
                {
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Manufacturer")</span><span class="small">@Model.Manufacturer</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Model))
                {
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Model")</span><span class="small">@Model.Model</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SerialNumber))
                {
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Serial Number")</span><span class="small fw-semibold">@Model.SerialNumber</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Sku))
                {
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("SKU")</span><span class="small fw-semibold">@Model.Sku</span></div>
                }
                @if (Model.AssignedToUser != null)
                {
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Assigned To")</span><span class="small">@Model.AssignedToUser.FullName</span></div>
                }
                @if (Model.PurchaseDate.HasValue)
                {
                    <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Purchase Date")</span><span class="small">@Loc.TDate(Model.PurchaseDate!.Value.ToString("dd/MM/yyyy"))</span></div>
                }
                @if (Model.WarrantyExpiry.HasValue)
                {
                    <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Warranty Expiry")</span><span class="small">@Loc.TDate(Model.WarrantyExpiry!.Value.ToString("dd/MM/yyyy"))</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-2 pt-2 border-top"><div class="text-muted small mb-1">@Loc.T("Notes")</div><div class="small">@Model.Notes</div></div>
                }
            </div>
        </div>
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body text-center">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <img src="@Url.Action("QrCode", new { id = Model.Id })" alt="QR" style="width:80px;height:80px" />
                    <img src="@Url.Action("Barcode", new { id = Model.Id })" alt="Barcode" style="width:150px;height:55px" />
                </div>
                <a href="@Url.Action("Label", new { id = Model.Id })" target="_blank" class="small d-block mt-2"><i class="bi bi-printer me-1"></i>@Loc.T("Print Label")</a>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0"><i class="bi bi-file-earmark-text me-2"></i>@Loc.T("Contracts")</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-card-stack">
                    <thead><tr><th>@Loc.T("Contract Number")</th><th>@Loc.T("Vendor")</th><th>@Loc.T("Contract Type")</th><th>@Loc.T("End Date")</th></tr></thead>
                    <tbody>
                        @if (Model.ContractLinks.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No linked contracts yet")</td></tr>
                        }
                        @foreach (var link in Model.ContractLinks)
                        {
                            <tr class="row-link" data-href="@Url.Action("Details", "Contracts", new { id = link.ContractId })">
                                <td data-label="@Loc.T("Contract Number")" class="small fw-semibold">@link.Contract?.ContractNumber</td>
                                <td data-label="@Loc.T("Vendor")" class="small">@link.Contract?.Vendor?.Name</td>
                                <td data-label="@Loc.T("Contract Type")"><partial name="_StatusBadge" model="@link.Contract?.ContractType" /></td>
                                <td data-label="@Loc.T("End Date")" class="small">@(link.Contract?.EndDate is { } ed ? Loc.TDate(ed.ToString("dd/MM/yyyy")) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0"><i class="bi bi-tools me-2"></i>@Loc.T("Work Orders")</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-card-stack">
                    <thead><tr><th>@Loc.T("Work Order Number")</th><th>@Loc.T("Priority")</th><th>@Loc.T("Stage")</th><th>@Loc.T("Vendor")</th></tr></thead>
                    <tbody>
                        @if (Model.WorkOrders.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No work orders yet")</td></tr>
                        }
                        @foreach (var w in Model.WorkOrders.OrderByDescending(w => w.CreatedDate))
                        {
                            <tr class="row-link" data-href="@Url.Action("Details", "WorkOrders", new { id = w.Id })">
                                <td data-label="@Loc.T("Work Order Number")" class="small fw-semibold">@w.WorkOrderNumber</td>
                                <td data-label="@Loc.T("Priority")"><partial name="_StatusBadge" model="@w.Priority" /></td>
                                <td data-label="@Loc.T("Stage")"><partial name="_StatusBadge" model="@w.Stage" /></td>
                                <td data-label="@Loc.T("Vendor")" class="small">@w.Vendor?.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white fw-semibold border-0"><i class="bi bi-clipboard-check me-2"></i>@Loc.T("Inspection History")</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-card-stack">
                    <thead><tr><th>@Loc.T("Inspected At")</th><th>@Loc.T("Outcome")</th><th>@Loc.T("Inspected By")</th><th>@Loc.T("Maintenance Actions")</th></tr></thead>
                    <tbody>
                        @{ var inspections = (List<InspectionRunAsset>)ViewBag.Inspections; }
                        @if (inspections.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No inspections yet")</td></tr>
                        }
                        @foreach (var insp in inspections)
                        {
                            <tr class="@(insp.WorkOrderId.HasValue ? "row-link" : null)" data-href="@(insp.WorkOrderId.HasValue ? Url.Action("Details", "WorkOrders", new { id = insp.WorkOrderId }) : null)">
                                <td data-label="@Loc.T("Inspected At")" class="small">@(insp.InspectedAt is { } ia ? Loc.TDate(ia.ToString("dd/MM/yyyy HH:mm")) : "—")</td>
                                <td data-label="@Loc.T("Outcome")"><partial name="_StatusBadge" model="@insp.Outcome" /></td>
                                <td data-label="@Loc.T("Inspected By")" class="small">@insp.InspectedByUser?.FullName</td>
                                <td data-label="@Loc.T("Maintenance Actions")" class="small">@string.Join(", ", insp.MaintenanceActions.Select(m => Loc.LocalizedName(m.MaintenanceActionType.Name, m.MaintenanceActionType.NameAr)))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
