@model ShiftFlow.Web.ViewModels.InspectionOrderCreateVm
@using ShiftFlow.Domain.Entities
@using ShiftFlow.Web.ViewModels
@{
    ViewData["Title"] = Loc.T("New Inspection Order");
    var teams = (List<Team>)ViewBag.Teams;
    var categories = (List<AssetCategory>)ViewBag.Categories;
    var governorates = (List<Governorate>)ViewBag.Governorates;
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("New Inspection Order"),Subtitle=Loc.T("Assign one or more assets to an employee or a team")})" />

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small d-none" id="validationSummary"></div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@Loc.T("Title") <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="@Loc.T("What needs to be inspected?")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Loc.T("Due Date")</label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">@Loc.T("Details")</label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="@Loc.T("Optional description")"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label d-block">@Loc.T("Assign To")</label>
                    <div class="btn-group btn-group-sm mb-2" role="group">
                        <input type="radio" class="btn-check" name="AssigneeType" id="assigneeUser" value="User" />
                        <label class="btn btn-outline-secondary" for="assigneeUser">@Loc.T("Employee")</label>
                        <input type="radio" class="btn-check" name="AssigneeType" id="assigneeTeam" value="Team" checked />
                        <label class="btn btn-outline-secondary" for="assigneeTeam">@Loc.T("Team")</label>
                    </div>
                </div>
                <div class="col-md-6 d-none" id="assigneeUserRow">
                    <label class="form-label">@Loc.T("Employee")</label>
                    <partial name="_EmployeePicker" model="@(new EmployeePickerModel{Name="AssignedToUserId",SelectedId=Model.AssignedToUserId,Placeholder=Loc.T("Search by name or email…")})" />
                </div>
                <div class="col-md-6" id="assigneeTeamRow">
                    <label class="form-label">@Loc.T("Team")</label>
                    <select asp-for="AssignedToTeamId" class="form-select">
                        <option value="">@Loc.T("Select a team")</option>
                        @foreach (var t in teams)
                        {
                            <option value="@t.Id">@t.Name (@t.Members.Count)</option>
                        }
                    </select>
                </div>

                <div class="col-12"><hr /></div>

                <div class="col-12">
                    <label class="form-label">@Loc.T("Assets")</label>
                    <partial name="_AssetMultiPicker" model="@(new AssetMultiPickerModel{Name="AssetIds",Selected=new List<AssetChip>(),Placeholder=Loc.T("Search by asset tag or name…"),Categories=categories,Governorates=governorates})" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@Loc.T("Create Order")</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const userRow = document.getElementById('assigneeUserRow');
    const teamRow = document.getElementById('assigneeTeamRow');
    document.querySelectorAll('input[name="AssigneeType"]').forEach(r => {
        r.addEventListener('change', () => {
            const isTeam = r.value === 'Team' && r.checked;
            if (r.checked) {
                userRow.classList.toggle('d-none', isTeam);
                teamRow.classList.toggle('d-none', !isTeam);
            }
        });
    });
})();
</script>
}
