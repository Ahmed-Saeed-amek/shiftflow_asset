@model List<ShiftFlow.Domain.Entities.InspectionOrder>
@{
    ViewData["Title"] = Loc.T("My Orders");
    bool showAll = ViewBag.ShowAll is true;
    var range = (ViewBag.SelectedRange as string) ?? "month";
}

<div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-1 fw-bold"><i class="bi bi-clipboard-check me-2 text-primary"></i>@Loc.T("My Orders")</h4>
        <div class="text-muted small">@Loc.T("Inspection orders assigned to you or your teams")</div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="btn-group btn-group-sm" role="group">
            <a class="btn @(range == "month" ? "btn-primary" : "btn-outline-secondary")" asp-action="MyOrders" asp-route-showAll="@showAll" asp-route-range="month">@Loc.T("This month")</a>
            <a class="btn @(range == "all" ? "btn-primary" : "btn-outline-secondary")" asp-action="MyOrders" asp-route-showAll="@showAll" asp-route-range="all">@Loc.T("All time")</a>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <a class="btn @(!showAll ? "btn-primary" : "btn-outline-secondary")" asp-action="MyOrders" asp-route-showAll="false" asp-route-range="@range">@Loc.T("Open")</a>
            <a class="btn @(showAll ? "btn-primary" : "btn-outline-secondary")" asp-action="MyOrders" asp-route-showAll="true" asp-route-range="@range">@Loc.T("All")</a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-check2-circle fs-1 d-block mb-2 opacity-25"></i>
            @(showAll ? Loc.T("No inspection orders assigned to you.") : Loc.T("No open inspection orders — you're all caught up."))
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc.T("Order #")</th><th>@Loc.T("Order Kind")</th><th>@Loc.T("Status")</th>
                        <th>@Loc.T("Checked")</th><th>@Loc.T("Due Date")</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        var items = o.InspectionRun?.Items ?? new List<ShiftFlow.Domain.Entities.InspectionRunAsset>();
                        <tr>
                            <td class="fw-semibold">@o.OrderNumber</td>
                            <td><partial name="_StatusBadge" model="@o.OrderType?.Name" /></td>
                            <td><partial name="_StatusBadge" model="@o.Status" /></td>
                            <td>@items.Count(i => i.Outcome != "Pending")/@items.Count</td>
                            <td>@(o.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">@Loc.T("View")</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
