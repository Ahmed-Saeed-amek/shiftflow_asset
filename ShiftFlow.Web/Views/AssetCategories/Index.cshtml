@using Microsoft.AspNetCore.Authorization
@model List<AssetCategory>
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Asset Categories");
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.AssetCategoryManage)).Succeeded;
    var subtitle = canManage ? Loc.T("Add categories and subcategories, then edit or manage their actions below") : Loc.T("Browse the asset category and subcategory taxonomy");
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Asset Categories"),Subtitle=subtitle})" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger small">@TempData["Error"]</div>
}

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center border-0">
                    <span class="fw-semibold">@c.Name @(!string.IsNullOrWhiteSpace(c.NameAr) ? $"({c.NameAr})" : "")</span>
                    @if (canManage)
                    {
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#categoryEditModal"
                                    onclick='openEdit(@c.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(c.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(c.NameAr)), null)'>
                                @Loc.T("Edit")
                            </button>
                            <a asp-controller="AssetActionTypes" asp-action="Index" asp-route-categoryId="@c.Id" class="btn btn-sm btn-outline-secondary">@Loc.T("Manage Actions")</a>
                        </div>
                    }
                </div>
                <div class="list-group list-group-flush">
                    @if (c.Subcategories.Count == 0)
                    {
                        <div class="list-group-item text-muted small text-center py-2">@Loc.T("No records found")</div>
                    }
                    @foreach (var sub in c.Subcategories.OrderBy(s => s.Name))
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span class="small">↳ @sub.Name @(!string.IsNullOrWhiteSpace(sub.NameAr) ? $"({sub.NameAr})" : "")</span>
                            @if (canManage)
                            {
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#categoryEditModal"
                                            onclick='openEdit(@sub.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sub.Name)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sub.NameAr)), @c.Id)'>
                                        @Loc.T("Edit")
                                    </button>
                                    <a asp-controller="AssetActionTypes" asp-action="Index" asp-route-categoryId="@sub.Id" class="btn btn-sm btn-outline-secondary">@Loc.T("Manage Actions")</a>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (canManage)
                {
                    <div class="card-body pt-2">
                        <form method="post" asp-action="Create" class="row g-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ParentCategoryId" value="@c.Id" />
                            <div class="col">
                                <input type="text" name="Name" class="form-control form-control-sm" placeholder="@Loc.T("Subcategory")" required />
                            </div>
                            <div class="col">
                                <input type="text" name="NameAr" class="form-control form-control-sm" placeholder="@Loc.T("Name (Arabic)")" dir="rtl" />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">+ @Loc.T("Subcategory")</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    @if (canManage)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-semibold border-0">@Loc.T("New Category")</div>
                <div class="card-body">
                    <form method="post" asp-action="Create" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col">
                            <input type="text" name="Name" class="form-control form-control-sm" placeholder="@Loc.T("Name")" required />
                        </div>
                        <div class="col">
                            <input type="text" name="NameAr" class="form-control form-control-sm" placeholder="@Loc.T("Name (Arabic)")" dir="rtl" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-primary text-nowrap">+ @Loc.T("New Category")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0 && !canManage)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-4">@Loc.T("No records found")</div></div>
}

@if (canManage)
{
    <div class="modal fade" id="categoryEditModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="acId" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title">@Loc.T("Edit Category")</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">@Loc.T("Name")</label>
                                <input name="Name" id="acName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">@Loc.T("Name (Arabic)")</label>
                                <input name="NameAr" id="acNameAr" class="form-control" dir="rtl" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small">@Loc.T("Parent Category")</label>
                                <select name="ParentCategoryId" id="acParentCategoryId" class="form-select">
                                    <option value="">@Loc.T("None (top-level)")</option>
                                    @foreach (var c in Model)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                        <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
    <script>
        function openEdit(id, name, nameAr, parentId) {
            document.getElementById('acId').value = id;
            document.getElementById('acName').value = name || '';
            document.getElementById('acNameAr').value = nameAr || '';
            document.getElementById('acParentCategoryId').value = parentId || '';
        }
    </script>
    }
}
