@using Microsoft.AspNetCore.Authorization
@model List<AssetCategory>
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Asset Categories");
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.AssetCategoryManage)).Succeeded;
    var subtitle = canManage ? Loc.T("Add categories and subcategories, then edit or manage their actions below.") : Loc.T("Browse the asset category and subcategory taxonomy.");
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Asset Categories"),Subtitle=subtitle})" />

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center border-0 gap-2">
                    <span class="fw-semibold"><i class="bi bi-folder me-2"></i>@c.Name @(!string.IsNullOrWhiteSpace(c.NameAr) ? $"({c.NameAr})" : "")</span>
                    @if (canManage)
                    {
                        <div class="dropdown row-actions">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Loc.T("Actions")"><i class="bi bi-three-dots"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#categoryEditModal"
                                            data-modal-edit="categoryEditModal"
                                            data-id="@c.Id" data-name="@c.Name" data-name-ar="@c.NameAr" data-parent-category-id="">
                                        <i class="bi bi-pencil me-2"></i>@Loc.T("Edit")
                                    </button>
                                </li>
                                <li><a class="dropdown-item" asp-controller="AssetActionTypes" asp-action="Index" asp-route-categoryId="@c.Id"><i class="bi bi-list-check me-2"></i>@Loc.T("Manage Actions")</a></li>
                            </ul>
                        </div>
                    }
                </div>
                <div class="list-group list-group-flush">
                    @if (c.Subcategories.Count == 0)
                    {
                        <div class="list-group-item text-muted small text-center py-2">@Loc.T("No subcategories yet")</div>
                    }
                    @foreach (var sub in c.Subcategories.OrderBy(s => s.Name))
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span class="small">↳ @sub.Name @(!string.IsNullOrWhiteSpace(sub.NameAr) ? $"({sub.NameAr})" : "")</span>
                            @if (canManage)
                            {
                                <div class="dropdown row-actions">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Loc.T("Actions")"><i class="bi bi-three-dots"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#categoryEditModal"
                                                    data-modal-edit="categoryEditModal"
                                                    data-id="@sub.Id" data-name="@sub.Name" data-name-ar="@sub.NameAr" data-parent-category-id="@c.Id">
                                                <i class="bi bi-pencil me-2"></i>@Loc.T("Edit")
                                            </button>
                                        </li>
                                        <li><a class="dropdown-item" asp-controller="AssetActionTypes" asp-action="Index" asp-route-categoryId="@sub.Id"><i class="bi bi-list-check me-2"></i>@Loc.T("Manage Actions")</a></li>
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (canManage)
                {
                    <div class="card-body pt-2">
                        <form method="post" asp-action="Create" class="row g-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ParentCategoryId" value="@c.Id" />
                            <div class="col">
                                <input type="text" name="Name" class="form-control form-control-sm" placeholder="@Loc.T("Subcategory")" required />
                            </div>
                            <div class="col">
                                <input type="text" name="NameAr" class="form-control form-control-sm" placeholder="@Loc.T("Name (Arabic)")" dir="rtl" />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-plus-lg me-1"></i>@Loc.T("Subcategory")</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    @if (canManage)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-semibold border-0"><i class="bi bi-plus-circle me-2"></i>@Loc.T("New Category")</div>
                <div class="card-body">
                    <form method="post" asp-action="Create" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col">
                            <input type="text" name="Name" class="form-control form-control-sm" placeholder="@Loc.T("Name")" required />
                        </div>
                        <div class="col">
                            <input type="text" name="NameAr" class="form-control form-control-sm" placeholder="@Loc.T("Name (Arabic)")" dir="rtl" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-plus-lg me-1"></i>@Loc.T("Add")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0 && !canManage)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-4">@Loc.T("No records found")</div></div>
}

@if (canManage)
{
    <div class="modal fade" id="categoryEditModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="Edit" id="categoryEditForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="acId" value="0" />
                    <div class="modal-header">
                        <h5 class="modal-title">@Loc.T("Edit Category")</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="categoryEditModalError" class="alert alert-danger small" role="alert" hidden></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">@Loc.T("Name")</label>
                                <input name="Name" id="acName" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">@Loc.T("Name (Arabic)")</label>
                                <input name="NameAr" id="acNameAr" class="form-control" dir="rtl" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small">@Loc.T("Parent Category")</label>
                                <select name="ParentCategoryId" id="acParentCategoryId" class="form-select">
                                    <option value="">@Loc.T("None (top-level)")</option>
                                    @foreach (var c in Model)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Loc.T("Cancel")</button>
                        <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
    <script src="~/js/modal-editor.js" asp-append-version="true"></script>
    <script>
        initModalEditor({
            modalId: 'categoryEditModal',
            formId: 'categoryEditForm',
            errorId: 'categoryEditModalError',
            urls: { create: '@Url.Action("Create")', edit: '@Url.Action("Edit")' },
            fieldMap: { id: 'acId', name: 'acName', nameAr: 'acNameAr', parentCategoryId: 'acParentCategoryId' },
            defaults: { id: 0, name: '', nameAr: '', parentCategoryId: '' },
            reopen: @Html.Raw(ShiftFlow.Web.Services.ModalRedisplay.ReopenScript(TempData))
        });
    </script>
    }
}
