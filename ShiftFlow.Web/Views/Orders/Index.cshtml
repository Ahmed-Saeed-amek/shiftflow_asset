@model List<ShiftFlow.Web.ViewModels.MyWorkOrderRow>
@using Microsoft.AspNetCore.Authorization
@using ShiftFlow.Web.Authorization
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Orders");
    var status = (string?)ViewBag.Status;
    var search = (string?)ViewBag.Search;
    var category = ViewBag.Category as string;
    var overdue = ViewBag.Overdue is true;
    var canManageInspection = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.InspectionOrderManage)).Succeeded;
    var canManageMaintenance = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.MaintenanceOrderManage)).Succeeded;
    string actionsHtml = "";
    if (canManageInspection || canManageMaintenance)
        actionsHtml = "<a href='" + Url.Action("Create") + "' class='btn btn-primary btn-sm'><i class=\"bi bi-plus me-1\"></i>" + Loc.T("New Order") + "</a>";

    string CategoryBadgeClass(string c) => c switch
    {
        "Inspection" => "bg-primary-subtle text-primary-emphasis",
        "Maintenance" => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-info-subtle text-info-emphasis",
    };
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Loc.T("Orders"),Subtitle=Loc.T("Inspection surveys and direct-fix maintenance orders, in one place"),ActionsHtml=actionsHtml})" />

@if (overdue)
{
    <div class="alert alert-warning small d-flex justify-content-between align-items-center">
        <span><i class="bi bi-alarm me-1"></i>@Loc.T("Showing overdue inspection orders only")</span>
        <a asp-action="Index" class="text-decoration-none">@Loc.T("Clear")</a>
    </div>
}

<div class="d-flex gap-2 mb-3 flex-wrap">
    <div class="btn-group btn-group-sm" role="group">
        <a class="btn @(string.IsNullOrEmpty(category) ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-status="@status">@Loc.T("All")</a>
        <a class="btn @(category == "Inspection" ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-status="@status" asp-route-category="Inspection">@Loc.T("Inspection")</a>
        <a class="btn @(category == "Maintenance" ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-status="@status" asp-route-category="Maintenance">@Loc.T("Maintenance")</a>
    </div>
    <div class="btn-group btn-group-sm" role="group">
        <a class="btn @(string.IsNullOrEmpty(status) ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-category="@category">@Loc.T("All Statuses")</a>
        <a class="btn @(status == "Open" ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-category="@category" asp-route-status="Open">@Loc.T("Open")</a>
        <a class="btn @(status == "InProgress" ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-category="@category" asp-route-status="InProgress">@Loc.T("In Progress")</a>
        <a class="btn @(status == "Done" ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-category="@category" asp-route-status="Done">@Loc.T("Done")</a>
    </div>
    <form method="get" class="d-flex gap-2">
        <input type="hidden" name="category" value="@category" />
        <input type="hidden" name="status" value="@status" />
        <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="@Loc.T("Search by order #...")" style="min-width:220px" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">@Loc.T("Filter")</button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-clipboard-check fs-1 d-block mb-2 opacity-25"></i>
            @Loc.T("No orders found.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc.T("Category")</th><th>@Loc.T("Order #")</th><th class="d-none d-sm-table-cell">@Loc.T("Asset")</th>
                        <th>@Loc.T("Assigned To")</th><th>@Loc.T("Status")</th>
                        <th class="d-none d-md-table-cell">@Loc.T("Due Date")</th><th class="d-none d-xl-table-cell">@Loc.T("Created")</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", o.DetailsController, new { id = o.Id })'">
                            <td><span class="badge @CategoryBadgeClass(o.Category)">@Loc.T(o.CategoryLabel)</span></td>
                            <td class="fw-semibold">@o.OrderNumber</td>
                            <td class="small d-none d-sm-table-cell">@(o.AssetLabel ?? "—")</td>
                            <td>@(o.AssignedToLabel ?? "—")</td>
                            <td><partial name="_StatusBadge" model="@o.Status" /></td>
                            <td class="d-none d-md-table-cell">@(o.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="d-none d-xl-table-cell">@o.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end"><a asp-action="Details" asp-controller="@o.DetailsController" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">@Loc.T("View")</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
