@model List<ShiftFlow.Web.ViewModels.OrderListRow>
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Html
@using ShiftFlow.Domain.Entities
@using ShiftFlow.Web.Authorization
@using ShiftFlow.Web.ViewModels
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Orders");
    var status = (string?)ViewBag.Status;
    var search = (string?)ViewBag.Search;
    var orderTypeId = ViewBag.OrderTypeId as int?;
    var activeOrderTypes = (List<OrderType>)ViewBag.ActiveOrderTypes;
    var overdue = ViewBag.Overdue is true;
    var canManageInspection = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.InspectionOrderManage)).Succeeded;
    var canManageMaintenance = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.MaintenanceOrderManage)).Succeeded;
    var canExportInspection = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.InspectionOrderExport)).Succeeded;
    var canExportMaintenance = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.MaintenanceOrderExport)).Succeeded;
    var canExport = canExportInspection || canExportMaintenance;
    var anyFilter = !string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status) || orderTypeId.HasValue || overdue;

    // One "Export" dropdown instead of two competing outline buttons — the two exports are the
    // same action against two different order kinds, not two different actions.
    Func<object?, IHtmlContent> headerActions = @<text>
        @if (canExport)
        {
            <div class="dropdown d-inline-block">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-download me-1"></i>@Loc.T("Export")
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @if (canExportInspection)
                    {
                        <li><a class="dropdown-item" href="@Url.Action("ExportExcel", "InspectionOrders")"><i class="bi bi-file-earmark-excel me-2"></i>@Loc.T("Excel: inspection orders")</a></li>
                    }
                    @if (canExportMaintenance)
                    {
                        <li><a class="dropdown-item" href="@Url.Action("ExportExcel", "MaintenanceOrders")"><i class="bi bi-file-earmark-excel me-2"></i>@Loc.T("Excel: maintenance orders")</a></li>
                    }
                </ul>
            </div>
        }
        @if (canManageInspection || canManageMaintenance)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i>@Loc.T("New Order")</a>
        }
    </text>;

    // The overdue banner's "Clear" drops only the overdue flag — every other filter survives.
    var overdueClearRoute = new Dictionary<string, string?>();
    if (!string.IsNullOrEmpty(status)) overdueClearRoute["status"] = status;
    if (orderTypeId.HasValue) overdueClearRoute["orderTypeId"] = orderTypeId.Value.ToString();
    if (!string.IsNullOrWhiteSpace(search)) overdueClearRoute["search"] = search;

    // Category colours match the Dashboard's Inspection/Work Order badges (soft blue / soft teal)
    // instead of the per-type auto-assigned hex, so a category reads the same everywhere.
    string CategoryBadgeClass(string c) => c == "Inspection"
        ? "bg-primary-subtle text-primary-emphasis border-primary-subtle"
        : "bg-info-subtle text-info-emphasis border-info-subtle";
}
<partial name="_PageHeader" model="@(new PageHeaderWithBreadcrumbs{Title=Loc.T("Orders"),Subtitle=Loc.T("Inspection surveys and direct-fix maintenance orders, in one place"),Actions=headerActions(null)})" />

@if (overdue)
{
    <div class="alert alert-warning small d-flex justify-content-between align-items-center">
        <span><i class="bi bi-alarm me-1"></i>@Loc.T("Showing overdue inspection orders only")</span>
        <a asp-action="Index" asp-all-route-data="@overdueClearRoute" class="text-decoration-none">@Loc.T("Clear")</a>
    </div>
}

@* One filter bar for the whole list: the two chip rows (type + status) were the same two filters
   twice over and neither fit a phone without its own horizontal scroller. *@
<form method="get" class="filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
    @if (overdue)
    {
        <input type="hidden" name="overdue" value="true" />
    }
    <label for="orderSearch" class="visually-hidden">@Loc.T("Search")</label>
    <input type="text" id="orderSearch" name="search" value="@search" class="form-control form-control-sm" placeholder="@Loc.T("Search by order #...")" style="min-width:200px" />

    <label for="orderTypeFilter" class="visually-hidden">@Loc.T("Type")</label>
    <select id="orderTypeFilter" name="orderTypeId" class="form-select form-select-sm w-auto">
        <option value="">@Loc.T("All Types")</option>
        @foreach (var t in activeOrderTypes)
        {
            <option value="@t.Id" selected="@(orderTypeId == t.Id)">@Loc.LocalizedName(t.Name, t.NameAr)</option>
        }
    </select>

    <label for="orderStatusFilter" class="visually-hidden">@Loc.T("Status")</label>
    <select id="orderStatusFilter" name="status" class="form-select form-select-sm w-auto">
        <option value="">@Loc.T("All Statuses")</option>
        @foreach (var s in InspectionOrder.Statuses)
        {
            <option value="@s" selected="@(status == s)">@Loc.T(StatusDisplay.Label(s))</option>
        }
    </select>

    <button type="submit" class="btn btn-outline-secondary btn-sm">@Loc.T("Filter")</button>
    @if (anyFilter)
    {
        <a class="btn btn-link btn-sm" href="@Url.Action("Index")">@Loc.T("Clear")</a>
    }
    <span class="filter-bar__count text-muted small ms-auto">@ViewBag.TotalCount @Loc.T("records")</span>
</form>

<div class="card border-0 shadow-sm">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel{
            Icon = "bi-clipboard-check",
            Title = anyFilter ? Loc.T("No orders match these filters") : Loc.T("No orders yet"),
            Text = anyFilter ? Loc.T("Try a different search or clear the filters.") : Loc.T("Inspection surveys and direct-fix maintenance orders will show up here."),
            ActionUrl = (canManageInspection || canManageMaintenance) && !anyFilter ? Url.Action("Create") : null,
            ActionLabel = Loc.T("New Order") })" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-card-stack">
                <thead class="table-light">
                    <tr>
                        <th>@Loc.T("Category")</th><th>@Loc.T("Order #")</th><th>@Loc.T("Asset")</th>
                        <th>@Loc.T("Assigned To")</th><th>@Loc.T("Status")</th>
                        <th>@Loc.T("Due Date")</th><th>@Loc.T("Created")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        var detailsController = o.Category == "Inspection" ? "InspectionOrders" : "MaintenanceOrders";
                        <tr class="row-link" data-href="@Url.Action("Details", detailsController, new { id = o.Id })">
                            <td data-label="@Loc.T("Category")"><span class="badge border @CategoryBadgeClass(o.Category)">@o.OrderTypeLabel</span></td>
                            @* A real link as well as the row click — keyboard and new-tab users need an anchor. *@
                            <td data-label="@Loc.T("Order #")"><a asp-action="Details" asp-controller="@detailsController" asp-route-id="@o.Id" class="fw-semibold text-decoration-none">@o.OrderNumber</a></td>
                            <td class="small" data-label="@Loc.T("Asset")">@(o.AssetLabel ?? "—")</td>
                            <td data-label="@Loc.T("Assigned To")">@(o.AssignedToLabel ?? "—")</td>
                            <td data-label="@Loc.T("Status")"><partial name="_StatusBadge" model="@StatusDisplay.Label(o.Status)" /></td>
                            <td data-label="@Loc.T("Due Date")">@(o.DueDate.HasValue ? Loc.TDate(o.DueDate.Value.ToString("dd/MM/yyyy")) : "—")</td>
                            <td data-label="@Loc.T("Created")" data-hide-mobile>@Loc.TDate(o.CreatedAt.ToString("dd/MM/yyyy"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_Pagination" model="@((PaginationModel)ViewBag.Pagination)" />
