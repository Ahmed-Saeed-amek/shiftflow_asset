@model ShiftFlow.Web.ViewModels.EmptyStateModel
@* ─────────────────────────────────────────────────────────────────────────────
   TEMPORARY — delete this file when the shared-UI branch is merged in.
   The real partial is Views/Shared/_EmptyState.cshtml, being built on a parallel
   branch. A folder-local partial wins over Views/Shared, so every one of these
   copies (Views/Orders, Views/WorkOrders, Views/VendorPortal, Views/Users) must
   be deleted on merge or it will keep shadowing the shared one.
   It exists only so an empty list renders instead of throwing on this branch.
   See NOTES-orders.md.
   ───────────────────────────────────────────────────────────────────────────── *@
<div class="card-body text-center text-muted py-5">
    <i class="bi @Model.Icon fs-1 d-block mb-2 opacity-25" aria-hidden="true"></i>
    <div class="fw-semibold">@Model.Title</div>
    @if (!string.IsNullOrWhiteSpace(Model.Text))
    {
        <div class="small mt-1">@Model.Text</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionUrl) && !string.IsNullOrWhiteSpace(Model.ActionLabel))
    {
        <a href="@Model.ActionUrl" class="btn btn-primary btn-sm mt-3">@Model.ActionLabel</a>
    }
</div>
