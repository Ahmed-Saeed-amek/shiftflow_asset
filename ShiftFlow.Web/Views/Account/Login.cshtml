@model ShiftFlow.Web.ViewModels.LoginViewModel
@using Microsoft.Extensions.Hosting
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{ViewData["Title"]=Loc.T("Login");Layout=null;var currentPath=Context.Request.Path+Context.Request.QueryString;}
<!DOCTYPE html><html lang="@Loc.Lang" dir="@(Loc.IsRTL ? "rtl" : "ltr")"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@Loc.T("Login") — STEP</title><link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true"/>@if (Loc.IsRTL) { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css"/> } else { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/> }<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/></head><body class="bg-light"><div class="min-vh-100 d-flex align-items-center justify-content-center p-3"><div class="card shadow-lg border-0 rounded-3" style="width:100%;max-width:420px"><div class="card-body p-5"><div class="d-flex justify-content-end mb-2"><form asp-controller="Language" asp-action="SetLanguage" method="post"><input type="hidden" name="returnUrl" value="@currentPath"/><input type="hidden" name="lang" value="@(Loc.IsRTL ? "en" : "ar")"/><button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-translate me-1"></i>@(Loc.IsRTL ? "English" : "عربي")</button></form></div><div class="text-center mb-4"><img src="~/images/logo.png" asp-append-version="true" alt="Ministry of Electricity, Water and Renewable Energy" style="width:180px;object-fit:contain" /><h4 class="fw-bold mt-2 mb-0">STEP</h4><p class="text-muted small">@Loc.T("Field Operations & Maintenance System")</p></div><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div><div class="mb-3"><label asp-for="Email" class="form-label fw-semibold">@Loc.T("Email")</label><div class="input-group"><span class="input-group-text"><i class="bi bi-envelope"></i></span><input asp-for="Email" class="form-control" placeholder="you@company.com"/></div><span asp-validation-for="Email" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label fw-semibold">@Loc.T("Password")</label><div class="input-group"><span class="input-group-text"><i class="bi bi-lock"></i></span><input asp-for="Password" type="password" class="form-control" placeholder="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"/></div><span asp-validation-for="Password" class="text-danger small"></span></div><div class="mb-4 form-check"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label text-muted small">@Loc.T("Remember me")</label></div><button type="submit" class="btn btn-primary w-100 fw-semibold py-2"><i class="bi bi-box-arrow-in-right me-2"></i>@Loc.T("Sign In")</button></form>@if (ViewBag.EntraConfigured == true) { <div class="d-flex align-items-center my-3"><hr class="flex-grow-1"/><span class="mx-2 text-muted small">@Loc.T("or")</span><hr class="flex-grow-1"/></div><form asp-action="ExternalLogin" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-secondary w-100 fw-semibold py-2"><i class="bi bi-microsoft me-2"></i>@Loc.T("Sign in with Microsoft")</button></form> }@if (Env.IsDevelopment()) { <div class="mt-4 p-3 bg-light rounded border"><p class="small fw-bold mb-2 text-muted">@Loc.T("Demo Accounts:")</p><div class="table-responsive"><table class="table table-sm table-borderless mb-0 small"><tr><td class="text-muted">@Loc.T("Admin")</td><td>admin@shiftflow.com</td><td class="text-muted">Admin@123456</td></tr><tr><td class="text-muted">@Loc.T("Manager")</td><td>manager@shiftflow.com</td><td class="text-muted">Manager@123456</td></tr><tr><td class="text-muted">@Loc.T("Engineer")</td><td>engineer@shiftflow.com</td><td class="text-muted">Engineer@123456</td></tr><tr><td class="text-muted">@Loc.T("HR")</td><td>hr@shiftflow.com</td><td class="text-muted">HrDept@123456</td></tr><tr><td class="text-muted">@Loc.T("Vendor")</td><td>vendor@gulfhvac.kw</td><td class="text-muted">Vendor@123456</td></tr></table></div></div> }</div></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script></body></html>