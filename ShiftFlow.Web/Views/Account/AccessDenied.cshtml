@using ShiftFlow.Web.Services
@{
    ViewData["Title"] = Loc.T("Access Denied");
    Layout = null;
    var isRTL = Loc.IsRTL;
    var perms = await Context.GetNavPermissionsAsync();
    var canViewDashboard = perms.CanManageInspectionOrders;
    // Mirrors AccountController.BuildLandingPath — HR has no inspection-order permissions, so
    // MyHome's widgets would always render empty/meaningless for them; send them to the employee
    // directory (Users) instead, same as their post-login landing page.
    var homeUrl = canViewDashboard ? "/Dashboard" : User.IsInRole("Vendor") ? "/VendorPortal" : User.IsInRole("HR") ? "/Users" : "/MyHome";
    // The button's label used to always read "Go to Dashboard" regardless of homeUrl above —
    // for HR (routed to Users) or a vendor (routed to VendorPortal) that promised a page they'd
    // never actually land on, a confusing mismatch on top of already hitting this error page.
    var homeLabel = canViewDashboard ? Loc.T("Go to Dashboard")
        : User.IsInRole("Vendor") ? Loc.T("Go to My Work Orders")
        : User.IsInRole("HR") ? Loc.T("Go to Users")
        : Loc.T("Go to My Home");
}
<!DOCTYPE html>
<html lang="@Loc.Lang" dir="@(isRTL ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - STEP</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true" />
    <partial name="_HeadLinks" />
</head>
<body>
    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="text-center" style="max-width:32rem">
            <i class="bi bi-shield-x text-danger" style="font-size:5rem" aria-hidden="true"></i>
            <h1 class="fs-4 fw-bold font-heading mt-3">@Loc.T("Access Denied")</h1>
            <p class="text-muted">@Loc.T("You do not have permission to view this page.")</p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                @* Was href="javascript:history.back()" — an inline-script URL. Now a real
                   button wired up below; hidden when there is no history to go back to. *@
                <button type="button" class="btn btn-outline-secondary d-none" id="goBackBtn">@Loc.T("Go Back")</button>
                <a href="@homeUrl" class="btn btn-primary">@homeLabel</a>
            </div>
        </div>
    </main>
    <script>
        (function () {
            var btn = document.getElementById('goBackBtn');
            if (!btn || history.length <= 1) return;
            btn.classList.remove('d-none');
            btn.addEventListener('click', function () { history.back(); });
        })();
    </script>
</body>
</html>
