@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthZ
@{
    ViewData["Title"] = Loc.T("Access Denied");
    Layout = null;
    var canViewDashboard = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.InspectionOrderManage)).Succeeded;
    // Mirrors AccountController.BuildLandingPath — HR has no inspection-order permissions, so
    // MyHome's widgets would always render empty/meaningless for them; send them to the employee
    // directory (Users) instead, same as their post-login landing page.
    var homeUrl = canViewDashboard ? "/Dashboard" : User.IsInRole("Vendor") ? "/VendorPortal" : User.IsInRole("HR") ? "/Users" : "/MyHome";
    // The button's label used to always read "Go to Dashboard" regardless of homeUrl above —
    // for HR (routed to Users) or a vendor (routed to VendorPortal) that promised a page they'd
    // never actually land on, a confusing mismatch on top of already hitting this error page.
    var homeLabel = canViewDashboard ? Loc.T("Go to Dashboard")
        : User.IsInRole("Vendor") ? Loc.T("Go to My Work Orders")
        : User.IsInRole("HR") ? Loc.T("Go to Users")
        : Loc.T("Go to My Home");
}
<!DOCTYPE html><html><head><meta charset="utf-8"/><title>@ViewData["Title"] - STEP</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/></head><body class="bg-light"><div class="min-vh-100 d-flex align-items-center justify-content-center"><div class="text-center"><i class="bi bi-shield-x text-danger" style="font-size:5rem"></i><h3 class="fw-bold mt-3">@Loc.T("Access Denied")</h3><p class="text-muted">@Loc.T("You do not have permission to view this page.")</p><a href="javascript:history.back()" class="btn btn-outline-secondary me-2">@Loc.T("Go Back")</a><a href="@homeUrl" class="btn btn-primary">@homeLabel</a></div></div></body></html>