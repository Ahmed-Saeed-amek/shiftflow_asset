@model List<WorkOrder>
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Loc.T("My Work Orders");
    var q = (string?)ViewBag.Q;
    var stage = (string?)ViewBag.Stage;
    var anyFilter = !string.IsNullOrWhiteSpace(q) || !string.IsNullOrWhiteSpace(stage);
    Func<object?, IHtmlContent> headerActions = @<text>
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary btn-sm active" id="listViewBtn">@Loc.T("List View")</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="mapViewBtn">@Loc.T("Map View")</button>
        </div>
    </text>;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H" crossorigin="anonymous" />
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" integrity="sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH" crossorigin="anonymous"></script>
<script src="~/js/zone-map.js" asp-append-version="true"></script>

<partial name="_PageHeader" model="@(new PageHeaderWithBreadcrumbs{Title=Loc.T("My Work Orders"),Subtitle=Loc.T("Every work order assigned to your company"),Actions=headerActions(null)})" />

<form method="get" class="filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
    <label for="vendorSearch" class="visually-hidden">@Loc.T("Search")</label>
    <input type="text" id="vendorSearch" name="q" value="@q" class="form-control form-control-sm" placeholder="@Loc.T("Search by order # or asset tag…")" style="min-width:200px" />

    <label for="vendorStage" class="visually-hidden">@Loc.T("Stage")</label>
    <select id="vendorStage" name="stage" class="form-select form-select-sm w-auto">
        <option value="">@Loc.T("All Stages")</option>
        @foreach (var s in WorkOrder.AllDisplayStages)
        {
            <option value="@s" selected="@(stage == s)">@Loc.T(s)</option>
        }
    </select>

    <button type="submit" class="btn btn-outline-secondary btn-sm">@Loc.T("Filter")</button>
    @if (anyFilter)
    {
        <a class="btn btn-link btn-sm" href="@Url.Action("Index")">@Loc.T("Clear")</a>
    }
    <span class="filter-bar__count text-muted small ms-auto">@Model.Count @Loc.T("records")</span>
</form>

<div id="listView">
    <div class="card border-0 shadow-sm">
        @if (Model.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyStateModel{
                Icon = "bi-inbox",
                Title = anyFilter ? Loc.T("No work orders match these filters") : Loc.T("No work orders yet"),
                Text = anyFilter ? Loc.T("Try a different search or clear the filters.") : Loc.T("No work orders assigned to your company yet — check back later.") })" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-card-stack">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc.T("Work Order Number")</th><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Type")</th>
                            <th>@Loc.T("Priority")</th><th>@Loc.T("Stage")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model)
                        {
                            <tr class="row-link" data-href="@Url.Action("Details", new { id = w.Id })">
                                @* A real link, not row-click only - see WorkOrders/Index. *@
                                <td data-label="@Loc.T("Work Order Number")"><a asp-action="Details" asp-route-id="@w.Id" class="fw-semibold text-decoration-none">@w.WorkOrderNumber</a></td>
                                <td class="small" data-label="@Loc.T("Asset Tag")">@w.Asset?.AssetTag</td>
                                <td data-label="@Loc.T("Type")" data-hide-mobile>
                                    @if (w.SourceContractId != null)
                                    {
                                        <span class="badge border bg-dark-subtle text-dark-emphasis border-dark-subtle"><i class="bi bi-arrow-repeat me-1"></i>@Loc.T("Preventive Maintenance")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@Loc.T("Manual")</span>
                                    }
                                </td>
                                <td data-label="@Loc.T("Priority")"><partial name="_StatusBadge" model="@w.Priority" /></td>
                                <td data-label="@Loc.T("Stage")"><partial name="_StatusBadge" model="@w.Stage" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div id="mapView" class="card border-0 shadow-sm d-none">
    <div id="vendorWorkOrdersMap" style="height:600px;border-radius:2px"></div>
</div>

<script>
(function () {
    const listView = document.getElementById('listView');
    const mapView = document.getElementById('mapView');
    const listBtn = document.getElementById('listViewBtn');
    const mapBtn = document.getElementById('mapViewBtn');
    let mapInitialized = false;

    listBtn.addEventListener('click', () => {
        listView.classList.remove('d-none'); mapView.classList.add('d-none');
        listBtn.classList.add('active'); mapBtn.classList.remove('active');
    });
    mapBtn.addEventListener('click', () => {
        listView.classList.add('d-none'); mapView.classList.remove('d-none');
        mapBtn.classList.add('active'); listBtn.classList.remove('active');
        if (!mapInitialized) {
            mapInitialized = true;
            initVendorWorkOrderMap('vendorWorkOrdersMap', '@Url.Action("MapData")', '@Url.Action("Details", new { id = "__ID__" })');
        }
    });
})();
</script>
