@model WorkOrder
@{
    ViewData["Title"] = Model.WorkOrderNumber;
    var isSentToVendor = Model.Stage == "Sent to Vendor";
    var blockReasons = ViewBag.BlockReasons as List<WorkOrderBlockReason>;
}
<partial name="_PageHeader" model="@(new PageHeaderModel{Title=Model.WorkOrderNumber,Subtitle=Model.Asset?.AssetTag})" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger small">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success small">@TempData["Success"]</div>
}

<div class="row g-3">
    <div class="@(isSentToVendor ? "col-lg-5" : "col-lg-8")">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold border-0">@Loc.T("Details")</div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span class="text-muted small">@Loc.T("Type")</span>
                    @if (Model.SourceContractId != null)
                    {
                        <span class="badge border bg-dark-subtle text-dark-emphasis border-dark-subtle"><i class="bi bi-arrow-repeat me-1"></i>@Loc.T("Preventive Maintenance")</span>
                    }
                    else
                    {
                        <span class="small text-muted">@Loc.T("Manual")</span>
                    }
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Priority")</span><partial name="_StatusBadge" model="@Model.Priority" /></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Stage")</span><partial name="_StatusBadge" model="@Model.Stage" /></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Asset")</span><span class="small">@Model.Asset?.Name (@Model.Asset?.AssetTag)</span></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Category")</span><span class="small">@Model.Asset?.Category?.Name</span></div>
                <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Zone")</span><span class="small">@(Model.Asset?.Zone is { } zn ? Loc.LocalizedName(zn.Name, zn.NameAr) : null) <span class="text-muted">(@(Model.Asset?.Zone?.LocationCategory is { } cat ? Loc.LocalizedName(cat.Name, cat.NameAr) : null))</span></span></div>
                @if (Model.Asset != null && (!string.IsNullOrWhiteSpace(Model.Asset.Manufacturer) || !string.IsNullOrWhiteSpace(Model.Asset.Model) || !string.IsNullOrWhiteSpace(Model.Asset.SerialNumber) || !string.IsNullOrWhiteSpace(Model.Asset.Sku)))
                {
                    <div class="mt-2 pt-2 border-top">
                        <div class="text-muted small mb-1 fw-semibold">@Loc.T("Asset Specifications")</div>
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.Manufacturer))
                        {
                            <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Manufacturer")</span><span class="small">@Model.Asset.Manufacturer</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.Model))
                        {
                            <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("Model")</span><span class="small">@Model.Asset.Model</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.Sku))
                        {
                            <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted small">@Loc.T("SKU")</span><span class="small font-monospace">@Model.Asset.Sku</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Asset.SerialNumber))
                        {
                            <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Serial Number")</span><span class="small font-monospace">@Model.Asset.SerialNumber</span></div>
                        }
                    </div>
                }
                @if (Model.ActionType != null)
                {
                    <div class="mt-2 pt-2 border-top">
                        <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Action Type")</span><span class="small">@Model.ActionType.Name</span></div>
                        <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Cause")</span><span class="small">@Model.Cause?.Name</span></div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="mt-2 pt-2 border-top"><div class="text-muted small mb-1">@Loc.T("Description")</div><div class="small long-text-field">@Model.Description</div></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-2 pt-2 border-top"><div class="text-muted small mb-1">@Loc.T("Notes")</div><div class="small long-text-field">@Model.Notes</div></div>
                }
            </div>
        </div>

        @if (Model.Stage == "Blocked")
        {
            <div class="alert alert-warning small mb-3">
                <div class="fw-semibold">@Loc.T("Block Reason"): @(Model.BlockReason != null ? Loc.LocalizedName(Model.BlockReason.Name, Model.BlockReason.NameAr) : null)</div>
                @if (!string.IsNullOrWhiteSpace(Model.BlockDetail)) { <div>@Model.BlockDetail</div> }
                <div class="mt-1">@Loc.T("Waiting on admin to resolve and resend.")</div>
            </div>
        }
        @if (Model.Stage == "Fixed - Pending Confirmation")
        {
            <div class="alert alert-info small mb-3">@Loc.T("Fix report submitted — waiting on admin confirmation.")</div>
        }
        @if (Model.Stage == "Closed")
        {
            <div class="alert alert-success small mb-3">@Loc.T("This work order is closed.")</div>
        }

        @if ((Model.Stage == "Fixed - Pending Confirmation" || Model.Stage == "Closed") && (Model.FixCost.HasValue || Model.FixCompletionDate.HasValue || !string.IsNullOrWhiteSpace(Model.FixDescription) || Model.Parts.Count > 0 || Model.Attachments.Count > 0))
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard-data text-primary"></i>@Loc.T("Fix Report")
                </div>
                <div class="card-body">
                    @if (Model.FixCost.HasValue || Model.FixCompletionDate.HasValue)
                    {
                        <dl class="row small mb-0 gy-2">
                            @if (Model.FixCost.HasValue)
                            {
                                <dt class="col-5 col-md-4 text-muted fw-normal">@Loc.T("Fix Cost")</dt><dd class="col-7 col-md-8 text-end mb-0">@Model.FixCost</dd>
                            }
                            @if (Model.FixCompletionDate.HasValue)
                            {
                                <dt class="col-5 col-md-4 text-muted fw-normal">@Loc.T("Completion Date")</dt><dd class="col-7 col-md-8 text-end mb-0">@Loc.TDate(Model.FixCompletionDate?.ToString("dd/MM/yyyy") ?? "")</dd>
                            }
                        </dl>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.FixDescription))
                    {
                        <div class="mt-2 pt-2 border-top"><div class="text-muted small mb-1">@Loc.T("Fix Description")</div><div class="small long-text-field">@Model.FixDescription</div></div>
                    }
                    @if (Model.Parts.Count > 0)
                    {
                        <div class="mt-2 pt-2 border-top">
                            <div class="text-muted small mb-1"><i class="bi bi-box-seam me-1"></i>@Loc.T("Parts Used")</div>
                            <ul class="small mb-0 ps-3">
                                @foreach (var p in Model.Parts)
                                {
                                    <li>@p.Name × @p.Quantity</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (Model.Attachments.Count > 0)
                    {
                        <div class="mt-2 pt-2 border-top">
                            <div class="text-muted small mb-1"><i class="bi bi-paperclip me-1"></i>@Loc.T("Attachments")</div>
                            @foreach (var a in Model.Attachments)
                            {
                                <a asp-controller="WorkOrders" asp-action="DownloadAttachment" asp-route-attachmentId="@a.Id" class="d-block small text-decoration-none"><i class="bi bi-file-earmark me-1"></i>@a.FileName</a>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Loc.T("Back")</a>
    </div>

    @if (isSentToVendor)
    {
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold border-0">@Loc.T("Submit Fix")</div>
                <div class="card-body">
                    <form method="post" asp-action="Fix" asp-route-id="@Model.Id" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <label class="form-label small">@Loc.T("Completion Date")</label>
                                <input type="date" name="CompletionDate" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <partial name="_SparePartPicker" model="@(new SparePartPickerModel{AssetId=Model.AssetId, ContainerId="partsList"})" />
                        <label class="form-label small d-block mt-2">@Loc.T("Attachments")</label>
                        <input type="file" name="Files" class="form-control form-control-sm mb-2" multiple />
                        <button type="submit" class="btn btn-sm btn-primary w-100">@Loc.T("Submit Fix")</button>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold border-0">@Loc.T("Submit Block")</div>
                <div class="card-body">
                    <form method="post" asp-action="Block" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <label class="form-label small">@Loc.T("Block Reason")</label>
                        <select name="blockReasonId" class="form-select form-select-sm mb-2" required>
                            <option value="" selected disabled>@Loc.T("Select a reason…")</option>
                            @if (blockReasons != null)
                            {
                                @foreach (var r in blockReasons)
                                {
                                    <option value="@r.Id">@Loc.LocalizedName(r.Name, r.NameAr)</option>
                                }
                            }
                        </select>
                        <label class="form-label small">@Loc.T("Block Detail")</label>
                        <textarea name="detail" class="form-control form-control-sm mb-2" rows="2"></textarea>
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">@Loc.T("Submit Block")</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Restores what was already selected after a rejected submission (e.g. a bad attachment)
        // sent the page back to a fresh GET — otherwise the date/parts the vendor had entered
        // would silently vanish, and only the attachment picker actually needs re-selecting
        // (browsers won't let script set a file input's value).
        (function restoreFixForm() {
            const completionDate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["FixForm_CDate"] as string));
            const sparePartIds = @Html.Raw((string?)TempData["FixForm_SparePartIds"] ?? "[]");
            const partQuantities = @Html.Raw((string?)TempData["FixForm_PartQuantities"] ?? "[]");

            const dateField = document.querySelector('input[name=CompletionDate]');
            if (!dateField) return;
            if (completionDate) dateField.value = completionDate;

            if (sparePartIds.length === 0) return;
            if (!window.__sparePartsReady || !window.__sparePartsReady['partsList']) return;
            window.__sparePartsReady['partsList'].then(function () {
                for (let i = 1; i < sparePartIds.length; i++) addSparePartRow('partsList');
                const container = document.getElementById('partsList');
                const selects = container.querySelectorAll('select[name=SparePartIds]');
                const qtyInputs = container.querySelectorAll('input[name=PartQuantities]');
                sparePartIds.forEach((id, i) => { if (selects[i]) selects[i].value = id; });
                partQuantities.forEach((q, i) => { if (qtyInputs[i]) qtyInputs[i].value = q; });
            });
        })();
    </script>
}
