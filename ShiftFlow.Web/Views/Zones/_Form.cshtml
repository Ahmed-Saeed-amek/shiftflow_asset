@model ZoneViewModel
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H" crossorigin="anonymous" />

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form method="post" id="zoneForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LocationCategoryId" class="form-label required">@Loc.T("Zone Category")</label>
                            <select asp-for="LocationCategoryId" class="form-select">
                                <option value="">—</option>
                                @foreach (var c in (List<LocationCategory>)ViewBag.LocationCategories)
                                {
                                    <option value="@c.Id" selected="@(Model.LocationCategoryId==c.Id)">@Loc.LocalizedName(c.Name, c.NameAr)</option>
                                }
                            </select>
                            <span asp-validation-for="LocationCategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label required">@Loc.T("Name")</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NameAr" class="form-label">@Loc.T("Name (Arabic)")</label>
                            <input asp-for="NameAr" class="form-control" dir="rtl" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">@Loc.T("Address")</label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="@Loc.T("e.g. Building 12, Street 4")"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Latitude" class="form-label">@Loc.T("Latitude")</label>
                            <input asp-for="Latitude" id="latInput" type="number" step="any" min="-90" max="90" class="form-control" />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Longitude" class="form-label">@Loc.T("Longitude")</label>
                            <input asp-for="Longitude" id="lngInput" type="number" step="any" min="-180" max="180" class="form-control" />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="help-text">@Loc.T("Click the map to set exact coordinates (optional)")</div>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">@Loc.T("Save")</button>
                        <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">@Loc.T("Cancel")</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div id="zoneMap" style="height:420px;border-radius:2px"></div>
        </div>
    </div>
</div>
