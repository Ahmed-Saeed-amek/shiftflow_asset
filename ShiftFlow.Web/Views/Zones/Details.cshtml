@using Microsoft.AspNetCore.Authorization
@model ZoneDetailsViewModel
@inject IAuthorizationService AuthZ
@{
    var zone = Model.Zone;
    var localizedName = Loc.LocalizedName(zone.Name, zone.NameAr);
    ViewData["Title"] = localizedName;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.AssetManage)).Succeeded;
    string actionsHtml = canManage ? "<a href='" + Url.Action("Edit", new { id = zone.Id }) + "' class='btn btn-primary btn-sm'>" + Loc.T("Edit") + "</a>" : "";
    var categoryLocalized = zone.LocationCategory is { } cat ? Loc.LocalizedName(cat.Name, cat.NameAr) : null;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />

<partial name="_PageHeader" model="@(new PageHeaderModel{Title=localizedName,Subtitle=categoryLocalized,ActionsHtml=actionsHtml})" />

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between py-1 @(string.IsNullOrWhiteSpace(zone.Address) ? "" : "border-bottom")"><span class="text-muted small">@Loc.T("Location Category")</span><span class="small fw-semibold">@categoryLocalized</span></div>
                @if (!string.IsNullOrWhiteSpace(zone.Address))
                {
                    <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Address")</span><span class="small fw-semibold text-end">@zone.Address</span></div>
                }
            </div>
        </div>
        @if (zone.Latitude.HasValue && zone.Longitude.HasValue)
        {
            <div class="card border-0 shadow-sm">
                <div id="zoneDetailMap" style="height:280px;border-radius:2px"></div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-geo-alt fs-3 d-block mb-2"></i>
                    @Loc.T("No coordinates set")
                    @if (canManage)
                    {
                        <div class="mt-2"><a asp-action="Edit" asp-route-id="@zone.Id" class="small">@Loc.T("Add coordinates")</a></div>
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0">@Loc.T("Assets")</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Name")</th><th>@Loc.T("Category")</th><th>@Loc.T("Status")</th></tr></thead>
                    <tbody>
                        @if (Model.Assets.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                        }
                        @foreach (var a in Model.Assets)
                        {
                            <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", "Assets", new { id = a.Id })'">
                                <td class="small font-monospace">@a.AssetTag</td>
                                <td>@a.Name</td>
                                <td class="small">@(a.Category is { } aCat ? Loc.LocalizedName(aCat.Name, aCat.NameAr) : null)</td>
                                <td><partial name="_StatusBadge" model="@a.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/zone-map.js" asp-append-version="true"></script>
@if (zone.Latitude.HasValue && zone.Longitude.HasValue)
{
    <script>
        initZoneReadonlyMap('zoneDetailMap', @zone.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @zone.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizedName)));
    </script>
}
}
