@using Microsoft.AspNetCore.Authorization
@model Zone
@inject IAuthorizationService AuthZ
@{
    var localizedName = Loc.LocalizedName(Model.Name, Model.NameAr);
    ViewData["Title"] = localizedName;
    var canManage = (await AuthZ.AuthorizeAsync(User, PermissionCatalog.AssetManage)).Succeeded;
    string actionsHtml = canManage ? "<a href='" + Url.Action("Edit", new { id = Model.Id }) + "' class='btn btn-primary btn-sm'>" + Loc.T("Edit") + "</a>" : "";
    var categoryLocalized = Model.LocationCategory is { } cat ? Loc.LocalizedName(cat.Name, cat.NameAr) : null;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/zone-map.js" asp-append-version="true"></script>

<partial name="_PageHeader" model="@(new PageHeaderModel{Title=localizedName,Subtitle=categoryLocalized,ActionsHtml=actionsHtml})" />

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between py-1 @(string.IsNullOrWhiteSpace(Model.Address) ? "" : "border-bottom")"><span class="text-muted small">@Loc.T("Location Category")</span><span class="small fw-semibold">@categoryLocalized</span></div>
                @if (!string.IsNullOrWhiteSpace(Model.Address))
                {
                    <div class="d-flex justify-content-between py-1"><span class="text-muted small">@Loc.T("Address")</span><span class="small fw-semibold text-end">@Model.Address</span></div>
                }
            </div>
        </div>
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div class="card border-0 shadow-sm">
                <div id="zoneDetailMap" style="height:280px;border-radius:2px"></div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-geo-alt fs-3 d-block mb-2"></i>
                    @Loc.T("No coordinates set")
                    @if (canManage)
                    {
                        <div class="mt-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="small">@Loc.T("Add coordinates")</a></div>
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0">@Loc.T("Assets")</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>@Loc.T("Asset Tag")</th><th>@Loc.T("Name")</th><th>@Loc.T("Category")</th><th>@Loc.T("Status")</th></tr></thead>
                    <tbody>
                        @if (Model.Assets.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">@Loc.T("No records found")</td></tr>
                        }
                        @foreach (var a in Model.Assets)
                        {
                            <tr class="cursor-pointer" onclick="location.href='@Url.Action("Details", "Assets", new { id = a.Id })'">
                                <td class="small font-monospace">@a.AssetTag</td>
                                <td>@a.Name</td>
                                <td class="small">@a.Category?.Name</td>
                                <td><partial name="_StatusBadge" model="@a.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.Latitude.HasValue && Model.Longitude.HasValue)
{
    <script>
        initZoneReadonlyMap('zoneDetailMap', @Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizedName)));
    </script>
}
